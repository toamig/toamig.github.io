---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  pluginName: string;
  version?: string;
  coverImage: string;
  logoImage: string;
  fabUrl?: string;
  ogImage?: string;
}

const {
  title,
  description = '',
  pluginName,
  version = '1.0',
  coverImage,
  logoImage,
  fabUrl = '#',
  ogImage,
} = Astro.props;

const og = ogImage ?? coverImage;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo_head.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={og} />
    <meta property="og:type"        content="website" />
  </head>
  <body>

    <!-- ── Top Bar ─────────────────────────────────────────────────── -->
    <header class="plugin-topbar">
      <a href="/" class="topbar-home">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        migueltechlead.pt
      </a>
      <span class="topbar-sep">/</span>
      <span class="topbar-current">Plugins / {pluginName}</span>
      <a href={fabUrl} target="_blank" rel="noopener noreferrer" class="topbar-fab" id="fab-btn">
        Get on Fab
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
      </a>
    </header>

    <!-- ── Docs Shell ──────────────────────────────────────────────── -->
    <div class="docs-shell">

      <!-- Sidebar -->
      <aside class="docs-sidebar" id="sidebar">
        <div class="sidebar-brand">
          <img src={logoImage} alt={`${pluginName} logo`} class="sidebar-logo" />
          <div>
            <p class="sidebar-plugin-name">{pluginName}</p>
            <span class="sidebar-version">v{version}</span>
          </div>
        </div>
        <nav class="sidebar-nav">
          <slot name="sidebar-nav" />
        </nav>
      </aside>

      <!-- Mobile sidebar toggle -->
      <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle navigation">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="6"  x2="21" y2="6"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>

      <!-- Main content -->
      <main class="docs-main">

        <!-- Hero -->
        <div class="plugin-hero" style={`background-image: url('${coverImage}')`}>
          <div class="plugin-hero-overlay"></div>
          <div class="plugin-hero-content">
            <img src={logoImage} alt={`${pluginName} logo`} class="hero-logo" />
            <div>
              <h1 class="hero-title">{pluginName}</h1>
              <p class="hero-sub">{description}</p>
            </div>
            <span class="hero-version">v{version}</span>
          </div>
        </div>

        <!-- Page content -->
        <div class="docs-body">
          <slot />
        </div>

      </main>
    </div>

    <script>
      // Sidebar toggle (mobile)
      const toggle = document.getElementById('sidebar-toggle');
      const sidebar = document.getElementById('sidebar');
      toggle?.addEventListener('click', () => sidebar?.classList.toggle('open'));

      // Active nav link on scroll
      const sections = document.querySelectorAll('[data-section]');
      const navLinks = document.querySelectorAll('.sidebar-nav a[href^="#"]');

      // Scroll-based active detection — reliable across all section sizes
      function updateActive() {
        const scrollY = window.scrollY + 120;
        let current = '';
        sections.forEach(section => {
          if ((section as HTMLElement).offsetTop <= scrollY) {
            current = section.getAttribute('data-section') || '';
          }
        });
        navLinks.forEach(a => a.classList.remove('active'));
        if (current) {
          document.querySelector(`.sidebar-nav a[href="#${current}"]`)?.classList.add('active');
        }
      }

      window.addEventListener('scroll', updateActive, { passive: true });
      updateActive();

      // Smooth scroll
      document.querySelectorAll('.sidebar-nav a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', e => {
          e.preventDefault();
          const id = (anchor as HTMLAnchorElement).getAttribute('href')!.slice(1);
          document.querySelector(`[data-section="${id}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          sidebar?.classList.remove('open');
        });
      });

      // Hide "Get on Fab" button if no real URL
      const fab = document.getElementById('fab-btn') as HTMLAnchorElement;
      if (fab && fab.getAttribute('href') === '#') fab.style.display = 'none';
    </script>

  </body>
</html>

<style is:global>
/* ── Plugin layout variables ─────────────────────────────────────── */
:root {
  --pl-bg:        #07111e;
  --pl-surface:   #0a1628;
  --pl-surface-2: #0f1f38;
  --pl-border:    rgba(255,255,255,.07);
  --pl-border-h:  rgba(41,128,185,.5);
  --pl-blue:      #2980b9;
  --pl-blue-l:    #3b97d3;
  --pl-text:      rgba(255,255,255,.88);
  --pl-muted:     rgba(255,255,255,.45);
  --pl-code-bg:   #050d1a;
  --pl-topbar-h:  52px;
  --pl-sidebar-w: 264px;
  --pl-font:      'Inter', -apple-system, sans-serif;
  --pl-mono:      'JetBrains Mono', 'Fira Code', monospace;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  font-family: var(--pl-font);
  background: var(--pl-bg);
  color: var(--pl-text);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

/* ── Top bar ─────────────────────────────────────────────────────── */
.plugin-topbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: var(--pl-topbar-h);
  background: rgba(7,17,30,.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--pl-border);
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 24px;
  z-index: 200;
}
.topbar-home {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--pl-muted);
  text-decoration: none;
  font-size: 13px;
  font-weight: 500;
  transition: color .2s;
}
.topbar-home:hover { color: var(--pl-text); }
.topbar-sep { color: var(--pl-border); font-size: 16px; user-select: none; }
.topbar-current { font-size: 13px; color: var(--pl-text); font-weight: 600; }
.topbar-fab {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 7px 16px;
  background: var(--pl-blue);
  color: #fff;
  text-decoration: none;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  transition: all .2s;
}
.topbar-fab:hover {
  background: var(--pl-blue-l);
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(41,128,185,.35);
}

/* ── Docs shell ──────────────────────────────────────────────────── */
.docs-shell {
  display: flex;
  padding-top: var(--pl-topbar-h);
  min-height: 100vh;
}

/* ── Sidebar ─────────────────────────────────────────────────────── */
.docs-sidebar {
  position: fixed;
  top: var(--pl-topbar-h);
  left: 0;
  width: var(--pl-sidebar-w);
  height: calc(100vh - var(--pl-topbar-h));
  background: #050c18;
  border-right: 1px solid var(--pl-border);
  overflow-y: auto;
  padding: 28px 0 40px;
  z-index: 100;
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,.1) transparent;
}
.docs-sidebar::-webkit-scrollbar { width: 4px; }
.docs-sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.1); border-radius: 4px; }

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 20px 24px;
  border-bottom: 1px solid var(--pl-border);
  margin-bottom: 20px;
}
.sidebar-logo {
  width: 40px;
  height: 40px;
  object-fit: contain;
  border-radius: 8px;
  background: rgba(255,255,255,.05);
  padding: 4px;
}
.sidebar-plugin-name {
  font-size: 14px;
  font-weight: 700;
  color: var(--pl-text);
  line-height: 1.3;
}
.sidebar-version {
  font-size: 11px;
  color: var(--pl-blue-l);
  font-weight: 600;
  background: rgba(41,128,185,.12);
  padding: 2px 7px;
  border-radius: 4px;
  border: 1px solid rgba(41,128,185,.2);
}

/* Nav groups */
.sidebar-nav { padding: 0 12px; }
.nav-group { margin-bottom: 24px; }
.nav-group-label {
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--pl-muted);
  padding: 0 8px;
  margin-bottom: 6px;
  display: block;
}
.nav-group a {
  display: block;
  padding: 7px 10px;
  font-size: 13.5px;
  font-weight: 450;
  color: rgba(255,255,255,.6);
  text-decoration: none;
  border-radius: 7px;
  transition: all .15s;
  border: 1px solid transparent;
  line-height: 1.4;
}
.nav-group a:hover {
  color: var(--pl-text);
  background: rgba(255,255,255,.05);
}
.nav-group a.active {
  color: var(--pl-blue-l);
  background: rgba(41,128,185,.1);
  border-color: rgba(41,128,185,.2);
  font-weight: 600;
}
.nav-group a.sub {
  padding-left: 22px;
  font-size: 13px;
}

/* ── Mobile toggle ───────────────────────────────────────────────── */
.sidebar-toggle {
  display: none;
  position: fixed;
  bottom: 24px;
  right: 24px;
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: rgba(10,22,40,.9);
  border: 1px solid var(--pl-border);
  color: var(--pl-text);
  cursor: pointer;
  align-items: center;
  justify-content: center;
  z-index: 300;
  box-shadow: 0 4px 20px rgba(0,0,0,.4);
  backdrop-filter: blur(12px);
  transition: all .2s;
}
.sidebar-toggle:hover { background: rgba(41,128,185,.4); border-color: rgba(41,128,185,.5); }

/* ── Main content ────────────────────────────────────────────────── */
.docs-main {
  margin-left: var(--pl-sidebar-w);
  flex: 1;
  min-width: 0;
}

/* ── Hero ────────────────────────────────────────────────────────── */
.plugin-hero {
  position: relative;
  height: 320px;
  background-size: cover;
  background-position: center;
  overflow: hidden;
}
.plugin-hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to right, rgba(7,17,30,.9) 0%, rgba(7,17,30,.5) 60%, rgba(7,17,30,.3) 100%),
    linear-gradient(to top, rgba(7,17,30,.7) 0%, transparent 50%);
}
.plugin-hero-content {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  align-items: flex-end;
  gap: 20px;
  padding: 0 48px 40px;
}
.hero-logo {
  width: 72px;
  height: 72px;
  object-fit: contain;
  border-radius: 16px;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.12);
  padding: 8px;
  flex-shrink: 0;
  box-shadow: 0 8px 32px rgba(0,0,0,.4);
}
.hero-title {
  font-size: 40px;
  font-weight: 900;
  letter-spacing: -.02em;
  color: #fff;
  line-height: 1.1;
  margin-bottom: 8px;
}
.hero-sub {
  font-size: 15px;
  color: rgba(255,255,255,.65);
  font-weight: 400;
  max-width: 520px;
  line-height: 1.6;
}
.hero-version {
  margin-left: auto;
  align-self: flex-end;
  font-size: 12px;
  font-weight: 700;
  color: var(--pl-blue-l);
  background: rgba(41,128,185,.15);
  border: 1px solid rgba(41,128,185,.3);
  padding: 5px 12px;
  border-radius: 6px;
  white-space: nowrap;
}

/* ── Docs body ───────────────────────────────────────────────────── */
.docs-body {
  padding: 56px 64px 96px;
  max-width: 900px;
}

/* ── Section ─────────────────────────────────────────────────────── */
/* Reset global CSS section padding that would otherwise add 90px top/bottom */
.docs-body section { padding: 0; overflow-x: visible; width: auto; }
.doc-section {
  margin-bottom: 56px;
  scroll-margin-top: 80px;
}
.doc-section-title {
  font-size: 26px;
  font-weight: 800;
  color: #fff;
  letter-spacing: -.02em;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.doc-section-title .section-icon {
  width: 34px;
  height: 34px;
  border-radius: 9px;
  background: rgba(41,128,185,.15);
  border: 1px solid rgba(41,128,185,.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--pl-blue-l);
}
.section-divider {
  width: 40px;
  height: 3px;
  background: linear-gradient(90deg, var(--pl-blue-l), var(--pl-blue));
  border-radius: 2px;
  margin: 10px 0 28px;
}
.doc-subsection {
  margin-bottom: 40px;
  scroll-margin-top: 80px;
}
.doc-subsection-title {
  font-size: 17px;
  font-weight: 700;
  color: rgba(255,255,255,.9);
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.doc-subsection-title::before {
  content: '';
  width: 3px;
  height: 18px;
  background: var(--pl-blue-l);
  border-radius: 2px;
  flex-shrink: 0;
}
.doc-p {
  font-size: 15px;
  line-height: 1.85;
  color: rgba(255,255,255,.65);
  margin-bottom: 20px;
}
.doc-p strong { color: rgba(255,255,255,.9); font-weight: 600; }

/* ── Feature grid ────────────────────────────────────────────────── */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 16px;
  margin-bottom: 32px;
}
.feature-card {
  background: rgba(255,255,255,.03);
  border: 1px solid var(--pl-border);
  border-radius: 12px;
  padding: 20px;
  transition: all .2s;
}
.feature-card:hover {
  border-color: rgba(41,128,185,.35);
  background: rgba(41,128,185,.05);
  transform: translateY(-2px);
}
.feature-icon {
  width: 36px;
  height: 36px;
  border-radius: 9px;
  background: rgba(41,128,185,.12);
  border: 1px solid rgba(41,128,185,.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14px;
  color: var(--pl-blue-l);
}
.feature-title {
  font-size: 14px;
  font-weight: 700;
  color: rgba(255,255,255,.9);
  margin-bottom: 6px;
}
.feature-desc {
  font-size: 13px;
  line-height: 1.65;
  color: rgba(255,255,255,.5);
}

/* ── Steps ───────────────────────────────────────────────────────── */
.steps { display: flex; flex-direction: column; gap: 16px; }
.step {
  display: flex;
  gap: 18px;
  align-items: flex-start;
  padding: 20px 24px;
  background: rgba(255,255,255,.03);
  border: 1px solid var(--pl-border);
  border-radius: 12px;
  transition: border-color .2s;
}
.step:hover { border-color: rgba(41,128,185,.3); }
.step-num {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(41,128,185,.15);
  border: 1.5px solid rgba(41,128,185,.35);
  color: var(--pl-blue-l);
  font-size: 14px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.step-body { flex: 1; }
.step-title {
  font-size: 14.5px;
  font-weight: 700;
  color: rgba(255,255,255,.9);
  margin-bottom: 5px;
}
.step-desc {
  font-size: 13.5px;
  line-height: 1.65;
  color: rgba(255,255,255,.52);
}

/* ── Property table ──────────────────────────────────────────────── */
.prop-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13.5px;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid var(--pl-border);
  margin-bottom: 28px;
}
.prop-table thead th {
  background: rgba(41,128,185,.1);
  color: rgba(255,255,255,.55);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .07em;
  font-weight: 700;
  padding: 11px 16px;
  text-align: left;
  border-bottom: 1px solid var(--pl-border);
}
.prop-table td {
  padding: 12px 16px;
  border-bottom: 1px solid rgba(255,255,255,.04);
  vertical-align: top;
  line-height: 1.6;
}
.prop-table tr:last-child td { border-bottom: none; }
.prop-table tr:hover td { background: rgba(255,255,255,.02); }
.prop-name {
  font-family: var(--pl-mono);
  color: var(--pl-blue-l);
  font-weight: 500;
  font-size: 13px;
  white-space: nowrap;
}
.prop-type {
  font-family: var(--pl-mono);
  font-size: 12px;
  color: rgba(255,255,255,.4);
  white-space: nowrap;
}
.prop-desc { color: rgba(255,255,255,.6); }
.prop-default {
  font-family: var(--pl-mono);
  font-size: 12px;
  color: rgba(255,255,255,.4);
}

/* ── Badges ──────────────────────────────────────────────────────── */
.badge {
  display: inline-block;
  padding: 3px 9px;
  border-radius: 5px;
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: .02em;
}
.badge-blue   { background: rgba(41,128,185,.15); color: #5aafe8; border: 1px solid rgba(41,128,185,.25); }
.badge-green  { background: rgba(56,161,105,.15);  color: #6bd4a0; border: 1px solid rgba(56,161,105,.25); }
.badge-amber  { background: rgba(236,153,40,.15);  color: #f5c369; border: 1px solid rgba(236,153,40,.25); }
.badge-purple { background: rgba(128,90,213,.15);  color: #b49dea; border: 1px solid rgba(128,90,213,.25); }

/* ── Script cards ────────────────────────────────────────────────── */
.script-grid {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.script-card {
  background: rgba(255,255,255,.03);
  border: 1px solid var(--pl-border);
  border-radius: 14px;
  overflow: hidden;
  transition: border-color .2s;
  scroll-margin-top: 80px;
}
.script-card:hover { border-color: rgba(41,128,185,.3); }
.script-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 24px 14px;
  border-bottom: 1px solid var(--pl-border);
  gap: 12px;
}
.script-card-name {
  font-size: 16px;
  font-weight: 700;
  color: #fff;
}
.script-card-body { padding: 18px 24px; }
.script-card-desc {
  font-size: 14px;
  line-height: 1.75;
  color: rgba(255,255,255,.6);
  margin-bottom: 16px;
}
.script-props { display: flex; flex-direction: column; gap: 10px; }
.script-prop {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding: 10px 14px;
  background: rgba(255,255,255,.02);
  border: 1px solid rgba(255,255,255,.05);
  border-radius: 8px;
  font-size: 13.5px;
}
.script-prop-name {
  font-family: var(--pl-mono);
  color: var(--pl-blue-l);
  font-size: 12.5px;
  white-space: nowrap;
  font-weight: 500;
  flex-shrink: 0;
  min-width: 160px;
}
.script-prop-desc { color: rgba(255,255,255,.55); line-height: 1.6; }
.use-case-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12.5px;
  color: rgba(255,255,255,.45);
  font-weight: 500;
}
.use-case-tag svg { opacity: .6; }

/* ── Code block ──────────────────────────────────────────────────── */
.code-block {
  background: var(--pl-code-bg);
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 24px;
}
.code-block-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  background: rgba(255,255,255,.03);
  border-bottom: 1px solid rgba(255,255,255,.06);
}
.code-lang {
  font-size: 11.5px;
  font-weight: 700;
  color: rgba(255,255,255,.35);
  text-transform: uppercase;
  letter-spacing: .06em;
  font-family: var(--pl-mono);
}
.code-block pre {
  padding: 20px 24px;
  overflow-x: auto;
  font-family: var(--pl-mono);
  font-size: 13px;
  line-height: 1.75;
  color: rgba(255,255,255,.8);
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,.1) transparent;
}
.code-block pre::-webkit-scrollbar { height: 4px; }
.code-block pre::-webkit-scrollbar-thumb { background: rgba(255,255,255,.1); border-radius: 4px; }
