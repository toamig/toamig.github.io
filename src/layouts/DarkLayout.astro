---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
  activeNav?: string; // e.g. 'plugins'
}

const {
  title,
  description = 'Discover my projects, skills, and experience.',
  ogImage     = 'https://toamig.com/me/IMG_7.JPEG',
  ogUrl       = 'https://toamig.com/',
  activeNav   = '',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo_head.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:url"         content={ogUrl} />
    <meta property="og:type"        content="website" />
  </head>

  <body class="dark-layout">

    <!-- ── Header ──────────────────────────────────────────────────────── -->
    <header class="dl-header" id="dl-header">
      <nav class="dl-nav">

        <a href="/" class="dl-brand">
          <img src="/logo_head.svg" width="26" height="26" alt="Logo" />
          <span>Miguel Techlead</span>
        </a>

        <button class="dl-hamburger" id="dl-hamburger" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </button>

        <div class="dl-links" id="dl-links">
          <a href="/"        class={activeNav === 'home'    ? 'active' : ''}>Home</a>
          <a href="/about"   class={activeNav === 'about'   ? 'active' : ''}>About</a>
          <a href="/Plugins" class={activeNav === 'plugins' ? 'active' : ''}>Plugins</a>
          <a href="/me/Miguel's CV.pdf" target="_blank" rel="noopener noreferrer">Resume</a>
        </div>

      </nav>
    </header>

    <!-- ── Page content ────────────────────────────────────────────────── -->
    <slot />

    <!-- ── Footer ──────────────────────────────────────────────────────── -->
    <footer class="dl-footer">
      <div class="dl-footer-inner">
        <div class="dl-socials">
          <a href="https://www.linkedin.com/in/toamig/"   target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <img src="/socials/linkedin.svg" alt="LinkedIn" width="20" height="20" />
          </a>
          <a href="https://www.instagram.com/toamig/"    target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <img src="/socials/insta.svg"    alt="Instagram" width="20" height="20" />
          </a>
          <a href="https://github.com/toamig"            target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <img src="/socials/github.svg"   alt="GitHub" width="20" height="20" />
          </a>
          <a href="https://t.me/cvieiratoa"              target="_blank" rel="noopener noreferrer" aria-label="Telegram">
            <img src="/socials/telegram.svg" alt="Telegram" width="20" height="20" />
          </a>
        </div>
        <p>&copy; 2025 Miguel Techlead. All rights reserved.</p>
      </div>
    </footer>

  </body>
</html>

<script>
  const header    = document.getElementById('dl-header')!;
  const hamburger = document.getElementById('dl-hamburger')!;
  const links     = document.getElementById('dl-links')!;

  // Scroll: reveal header background
  window.addEventListener('scroll', () => {
    header.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  // Hamburger
  hamburger.addEventListener('click', () => {
    const open = hamburger.classList.toggle('open');
    links.classList.toggle('open', open);
    document.body.classList.toggle('dl-nav-open', open);
  });
  links.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      hamburger.classList.remove('open');
      links.classList.remove('open');
      document.body.classList.remove('dl-nav-open');
    });
  });
</script>

<style is:global>
/* ── Body base ───────────────────────────────────────────────────────── */
body.dark-layout {
  background: #06090f;
  color: #e2e8f0;
  font-family: 'Inter', -apple-system, sans-serif;
  -webkit-font-smoothing: antialiased;
}
/* Neutralise global section padding for dark pages */
body.dark-layout section {
  padding: 0;
  overflow-x: visible;
  width: auto;
}

/* ── Header ──────────────────────────────────────────────────────────── */
.dl-header {
  position: fixed;
  inset-block-start: 0;
  inset-inline: 0;
  z-index: 200;
  height: 60px;
  padding: 0 40px;
  display: flex;
  align-items: center;
  background: transparent;
  transition: background .25s, box-shadow .25s;
}
.dl-header.scrolled {
  background: rgba(6, 9, 15, .9);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  box-shadow: 0 1px 0 rgba(255,255,255,.06);
}

.dl-nav {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 8px;
}

/* brand */
.dl-brand {
  display: flex;
  align-items: center;
  gap: 9px;
  text-decoration: none;
  margin-right: auto;
  flex-shrink: 0;
}
.dl-brand img {
  width: 26px;
  height: 26px;
  object-fit: contain;
  flex-shrink: 0;
}
.dl-brand span {
  font-size: .88rem;
  font-weight: 700;
  color: #f1f5f9;
  letter-spacing: -.01em;
  white-space: nowrap;
}

/* nav links */
.dl-links {
  display: flex;
  align-items: center;
  gap: 4px;
}
.dl-links a {
  color: rgba(255,255,255,.65);
  text-decoration: none;
  padding: 6px 14px;
  border-radius: 7px;
  font-size: .83rem;
  font-weight: 500;
  border: 1px solid transparent;
  transition: color .15s, background .15s, border-color .15s;
  white-space: nowrap;
}
.dl-links a:hover {
  color: #fff;
  background: rgba(255,255,255,.07);
  border-color: rgba(255,255,255,.1);
}
.dl-links a.active {
  color: #a5b4fc;
  background: rgba(99,102,241,.15);
  border-color: rgba(99,102,241,.3);
}

/* hamburger */
.dl-hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px;
  margin-left: 4px;
}
.dl-hamburger span {
  display: block;
  width: 22px;
  height: 2px;
  background: rgba(255,255,255,.8);
  border-radius: 2px;
  transition: transform .25s, opacity .25s;
}
.dl-hamburger.open span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
.dl-hamburger.open span:nth-child(2) { opacity: 0; }
.dl-hamburger.open span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

/* mobile dim overlay */
body.dl-nav-open::after {
  content: '';
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.55);
  z-index: 199;
  pointer-events: none;
}

/* ── Footer ──────────────────────────────────────────────────────────── */
.dl-footer {
  border-top: 1px solid rgba(255,255,255,.06);
  padding: 44px 24px;
  text-align: center;
}
.dl-footer-inner { max-width: 400px; margin: 0 auto; }

.dl-socials {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-bottom: 18px;
}
.dl-socials a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 9px;
  background: rgba(255,255,255,.05);
  border: 1px solid rgba(255,255,255,.07);
  transition: background .18s, border-color .18s, transform .18s;
}
.dl-socials a:hover {
  background: rgba(99,102,241,.18);
  border-color: rgba(99,102,241,.35);
  transform: translateY(-2px);
}
.dl-socials img {
  filter: brightness(0) invert(1);
  opacity: .6;
  transition: opacity .18s;
}
.dl-socials a:hover img { opacity: 1; }

.dl-footer p {
  font-size: .76rem;
  color: rgba(255,255,255,.25);
  letter-spacing: .03em;
  margin: 0;
}

/* ── Responsive ──────────────────────────────────────────────────────── */
@media (max-width: 768px) {
  .dl-header { padding: 0 18px; }
  .dl-hamburger { display: flex; }

  .dl-links {
    position: fixed;
    inset-block-start: 0;
    inset-inline-end: -100%;
    width: min(75vw, 290px);
    height: 100dvh;
    flex-direction: column;
    align-items: flex-start;
    padding: 80px 20px 28px;
    gap: 4px;
    background: rgba(6, 9, 15, .97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-left: 1px solid rgba(255,255,255,.07);
    box-shadow: -10px 0 40px rgba(0,0,0,.5);
    z-index: 200;
    transition: inset-inline-end .28s cubic-bezier(.4,0,.2,1);
  }
  .dl-links.open { inset-inline-end: 0; }
  .dl-links a { width: 100%; padding: 11px 14px; font-size: .93rem; }
}
</style>
