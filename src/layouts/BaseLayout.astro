---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogUrl?: string;
  ogType?: 'website' | 'article';
  ogImageWidth?: number;
  ogImageHeight?: number;
  bodyClass?: string;
}

const {
  title,
  description = 'Miguel Vieira (Toamig), game engineer and tech lead. Gameplay, multiplayer, tools, and the teams that ship games.',
  ogImage     = 'https://toamig.com/me/IMG_7.JPEG',
  ogImageAlt  = 'Miguel Vieira (Toamig), game engineer and tech lead',
  ogUrl       = 'https://toamig.com/',
  ogType      = 'website',
  ogImageWidth,
  ogImageHeight,
  bodyClass,
} = Astro.props;

// Identity graph: who Miguel is + the site, so searches for "Miguel Vieira",
// "Toamig", or the game-dev/tech-lead role resolve to one entity. Emitted on
// every portfolio page to reinforce the entity across the site.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://toamig.com/#miguel',
      name: 'Miguel Vieira',
      alternateName: 'Toamig',
      jobTitle: 'Game Engineer & Tech Lead',
      description:
        'Game engineer turned tech lead, working across gameplay, multiplayer, tools, animation, and AI systems on PC, console, and VR.',
      url: 'https://toamig.com/',
      image: 'https://toamig.com/me/IMG_7.JPEG',
      worksFor: { '@type': 'Organization', name: 'Flama Craftworks', url: 'https://www.flamacraftworks.com/' },
      address: { '@type': 'PostalAddress', addressLocality: 'Vila Nova de Gaia', addressCountry: 'PT' },
      knowsAbout: [
        'Unreal Engine 5',
        'Game development',
        'Gameplay programming',
        'Multiplayer networking',
        'Game tools programming',
        'Technical leadership',
      ],
      sameAs: [
        'https://www.linkedin.com/in/toamig/',
        'https://github.com/toamig',
        'https://www.instagram.com/toamig/',
        'https://toamig.itch.io',
        'https://www.twitch.tv/toamig',
        'https://www.youtube.com/@ToaAerials',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://toamig.com/#website',
      url: 'https://toamig.com/',
      name: 'Miguel Vieira (Toamig)',
      description: 'Portfolio of Miguel Vieira (Toamig), game engineer and tech lead.',
      inLanguage: 'en',
      publisher: { '@id': 'https://toamig.com/#miguel' },
    },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <title>{title}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Miguel Vieira" />
    <meta name="theme-color" content="#0a1628" />
    <link rel="icon" href="/logo_head.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={ogUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <!-- Open Graph -->
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:image:alt"   content={ogImageAlt} />
    {ogImageWidth  && <meta property="og:image:width"  content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta property="og:url"         content={ogUrl} />
    <meta property="og:type"        content={ogType} />
    <meta property="og:locale"      content="en_US" />
    <meta property="og:site_name"   content="Miguel Vieira (Toamig)" />

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />
    <meta name="twitter:image:alt"   content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class={bodyClass}>
    <MusicPlayer />
    <Header />
    <slot />
    <Footer />

    <!-- Smooth scroll for .scroll-down arrows (works on any page) -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.scroll-down a').forEach(anchor => {
          anchor.addEventListener('click', (e) => {
            e.preventDefault();
            const href   = (anchor as HTMLAnchorElement).getAttribute('href');
            const target = href ? document.querySelector(href) : null;
            target?.scrollIntoView({ behavior: 'smooth' });
          });
        });
      });
    </script>

    <!-- Site motion: scroll reveals + pointer glare. Classes are added here
         (not in markup), so if this script never runs nothing is hidden. -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

        // ── Scroll reveals ─────────────────────────────────────────────
        // Targets cover both server-rendered content and the Timeline's
        // client-rendered event cards (picked up via MutationObserver).
        const SELECTOR = [
          '.section-header', '.extended-card', '.tech-category',
          '.project-card', '.play-card', '.about-content',
          '.event-card', '.timeline-year-mark', '.cv-card',
        ].join(',');

        if (!reduced) {
          // rAF-throttled getBoundingClientRect sweep instead of
          // IntersectionObserver: identical result, but immune to emulated /
          // zoomed viewports where IO's rootBounds disagree with the layout
          // viewport. ~30-80 elements per page — the sweep is negligible.
          const pending = new Set<Element>();
          let ticking = false;

          const sweep = () => {
            ticking = false;
            const limit = innerHeight - 60;
            for (const el of pending) {
              const r = el.getBoundingClientRect();
              if (r.top < limit && r.bottom > 0) {
                el.classList.add('rv-in');
                pending.delete(el);
              }
            }
          };
          const queue = () => {
            if (!ticking && pending.size) { ticking = true; requestAnimationFrame(sweep); }
          };

          const prep = (el: Element) => {
            if (el.classList.contains('rv')) return;
            // Heroes run their own bespoke load animations — don't layer the
            // scroll-reveal on top (avoids a double opacity/transform fight).
            if (el.closest('.front-page, #about-2')) return;
            // Stagger within the parent: cards cascade, lone elements don't wait.
            const sibs = el.parentElement
              ? Array.from(el.parentElement.children).filter(c => c.matches(SELECTOR))
              : [el];
            const i = Math.max(0, sibs.indexOf(el));
            (el as HTMLElement).style.setProperty('--rv-delay', `${(i % 8) * 70}ms`);
            el.classList.add('rv');
            pending.add(el);
            queue();
          };

          addEventListener('scroll', queue, { passive: true });
          addEventListener('resize', queue, { passive: true });
          // Tabs loaded in the background freeze rAF, so the initial sweep
          // never runs. When the page becomes visible, unstick and re-sweep
          // so above-the-fold content reveals without needing a scroll.
          document.addEventListener('visibilitychange', () => {
            if (document.hidden) return;
            ticking = false;
            queue();
          });

          document.querySelectorAll(SELECTOR).forEach(prep);

          // Late-rendered content (Timeline filters re-render the grid).
          new MutationObserver((muts) => {
            for (const m of muts) {
              m.addedNodes.forEach(node => {
                if (!(node instanceof Element)) return;
                if (node.matches(SELECTOR)) prep(node);
                node.querySelectorAll?.(SELECTOR).forEach(prep);
              });
            }
          }).observe(document.body, { childList: true, subtree: true });
        }

        // ── Pointer glare on cards ─────────────────────────────────────
        if (!reduced && matchMedia('(hover: hover)').matches) {
          document.addEventListener('pointermove', (e) => {
            const card = (e.target as Element | null)?.closest?.('.extended-card, .project-card') as HTMLElement | null;
            if (!card) return;
            const r = card.getBoundingClientRect();
            card.style.setProperty('--mx', `${((e.clientX - r.left) / r.width * 100).toFixed(2)}%`);
            card.style.setProperty('--my', `${((e.clientY - r.top) / r.height * 100).toFixed(2)}%`);
          }, { passive: true });
        }
      });
    </script>
  </body>
</html>
