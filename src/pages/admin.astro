        <div class="form-group" style="margin-bottom:16px">
          <label>GitHub Token</label>
          <div class="token-field">
            <input type="password" id="pat-input" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx" autocomplete="off" />
            <button class="token-vis" id="pat-vis" title="Show/hide">👁</button>
          </div>
        </div>
        <button class="btn btn-primary btn-lg" id="login-btn">Connect to GitHub</button>
        <div class="login-help">
          Need a token? Go to <a href="https://github.com/settings/tokens/new" target="_blank">GitHub → Settings → Tokens</a>,
          create a <strong>Classic token</strong> with the <strong>repo</strong> scope checked.
        </div>
      </div>
    </div>`;
  }

  function attachLoginListeners() {
    const input  = document.getElementById('pat-input') as HTMLInputElement;
    const visBtn = document.getElementById('pat-vis')!;
    const loginBtn = document.getElementById('login-btn') as HTMLButtonElement;

    visBtn.addEventListener('click', () => {
      input.type = input.type === 'password' ? 'text' : 'password';
    });

    loginBtn.addEventListener('click', async () => {
      const token = input.value.trim();
      if (!token) return;
      loginBtn.disabled = true;
      loginBtn.textContent = 'Connecting…';
      try {
        const res = await fetch(`${GH_API}/user`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (!res.ok) throw new Error('Invalid token');
        state.user = await res.json();
        state.token = token;
        sessionStorage.setItem('admin_token', token);
        showLoading('Loading content…');
        await Promise.all(Object.keys(FILE_MAP).map(loadSection));
        hideLoading();
        render();
      } catch (e: any) {
        hideLoading();
        document.getElementById('app')!.innerHTML = renderLogin(e.message || 'Authentication failed');
        attachLoginListeners();
      }
    });

    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') loginBtn.click(); });
  }

  // ═══════════════════════════════════════════════════════
  // SHELL
  // ═══════════════════════════════════════════════════════
  function renderShell() {
    const sec = state.section;
    const meta = SECTION_META[sec];
    const isEditing = !!state.editing;
    const isDirty = state.dirty[sec];

    const navItems = Object.entries(SECTION_META).map(([key, m]) =>
      `<button class="nav-btn ${key === sec ? 'active' : ''}" data-section="${key}">
        <span class="nav-icon">${m.icon}</span> ${m.label}
        ${state.dirty[key] ? '<span class="unsaved-dot"></span>' : ''}
      </button>`
    ).join('');

    const username = state.user?.login ?? '—';

    return `
    <div class="sidebar-overlay ${isMobileOpen ? 'on' : ''}" id="sidebar-overlay"></div>
    <div class="shell">
      <aside class="sidebar ${isMobileOpen ? 'open' : ''}" id="sidebar">
        <div class="sidebar-brand">
          <svg viewBox="0 0 689 633" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0">
            <g transform="translate(0,633) scale(.1,-.1)" fill="#2980b9">
              <path d="M507 4863c-4-3-7-152-7-330l0-323 335 0 335 0 0-1332 0-1333 330 330 330 330 0 1002 0 1003 999 0 1000 0 323 326c178 179 325 327 327 330 2 2-889 4-1981 4-1091 0-1988-3-1991-7z"/>
              <path d="M4227 4472l-327-327-2-1005-3-1005-1000-3-1000-2-330-330-330-330 1658 0 1657 0 0 335 0 335 392-2 393-3 123-215c68-118 154-267 191-330l67-115 377-3c207-1 377 0 377 3 0 2-22 42-49 87-46 77-1130 1958-1218 2113-22 39-84 147-138 240-54 94-130 226-170 295-40 69-98 170-130 225-32 55-91 158-132 230-41 71-75 130-76 132-2 1-150-145-330-325zm375-1064c20-35 104-181 187-325 83-144 151-267 151-273 0-6-67-10-195-10l-195 0 0 335c0 184 4 335 8 335 4 0 24-28 44-62z"/>
              <path d="M2898 3139l-318-324 317-3c174-1 318-1 320 1 2 2 2 149 1 327l-3 323-317-324z"/>
            </g>
          </svg>
          <div>
            <h1>Admin Panel</h1>
            <small>Portfolio Manager</small>
          </div>
        </div>
        <nav class="sidebar-nav">${navItems}</nav>
        <div class="sidebar-footer">
          <div class="sidebar-user">
            <strong>@${username}</strong>
            ${OWNER}/${REPO}
          </div>
          <button class="btn btn-secondary btn-sm" id="logout-btn" style="width:100%">Sign Out</button>
        </div>
      </aside>

      <div class="main">
        <header class="topbar">
          <div class="topbar-left">
            <button class="hamburger" id="hamburger">
              <span></span><span></span><span></span>
            </button>
            <span class="topbar-title">${meta.icon} ${isEditing && !SINGLE_RECORD.has(sec) && !INLINE_LIST.has(sec) ? (state.editing!.index === -1 ? 'New ' : 'Edit ') + meta.label.replace(/s$/, '') : meta.label}</span>
            ${isDirty && !isEditing ? `<span class="unsaved-badge">Unsaved changes</span>` : ''}
          </div>
          <div class="topbar-right">
            ${isEditing
              ? `<button class="btn btn-ghost btn-sm" id="cancel-edit-btn">← Back</button>`
              : (SINGLE_RECORD.has(sec) || INLINE_LIST.has(sec)
                  ? `<button class="btn btn-success btn-sm ${!isDirty ? 'btn-ghost' : ''}" id="save-btn" ${!isDirty ? 'disabled' : ''}>💾 Save</button>`
                  : `<button class="btn btn-primary btn-sm" id="add-btn">+ Add New</button>
                     <button class="btn btn-success btn-sm ${!isDirty ? 'btn-ghost' : ''}" id="save-btn" ${!isDirty ? 'disabled' : ''}>💾 Save</button>`)
            }
          </div>
        </header>
        <div class="content" id="content-area">
          ${renderSectionContent()}
        </div>
      </div>
    </div>`;
  }

  let isMobileOpen = false;

  function attachShellListeners() {
    document.querySelector('.sidebar-nav')?.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest('[data-section]') as HTMLElement | null;
      if (!btn) return;
      if (state.dirty[state.section] && !state.editing) {
        if (!confirm('You have unsaved changes. Switch sections anyway?')) return;
        state.dirty[state.section] = false;
      }
      state.section = btn.dataset.section!;
      state.editing = null;
      isMobileOpen = false;
      render();
    });

    document.getElementById('logout-btn')?.addEventListener('click', () => {
      if (!confirm('Sign out?')) return;
      sessionStorage.removeItem('admin_token');
      state.token = null; state.user = null; state.editing = null;
      Object.keys(state.dirty).forEach(k => state.dirty[k] = false);
      render();
    });

    document.getElementById('hamburger')?.addEventListener('click', () => {
      isMobileOpen = !isMobileOpen;
      render();
    });

    document.getElementById('sidebar-overlay')?.addEventListener('click', () => {
      isMobileOpen = false; render();
    });

    document.getElementById('cancel-edit-btn')?.addEventListener('click', () => {
      state.editing = null; render();
    });

    document.getElementById('add-btn')?.addEventListener('click', () => {
      state.editing = { item: newItem(state.section), index: -1 };
      render();
    });

    document.getElementById('save-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('save-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = '⏳ Saving…';
      try {
        await saveSection(state.section);
        showToast('Saved! Site will rebuild in ~1 minute.', 'success');
        render();
      } catch (e: any) {
        showToast('Save failed: ' + e.message, 'error');
        btn.disabled = false; btn.textContent = '💾 Save';
      }
    });

    attachSectionListeners();
  }

  // ═══════════════════════════════════════════════════════
  // SECTION CONTENT
  // ═══════════════════════════════════════════════════════
  function renderSectionContent(): string {
    if (state.editing) return renderEditForm();
    if (state.section === 'profile')      return renderProfileForm();
    if (state.section === 'timelineTags') return renderTagsList();
    const items = state.data[state.section] || [];
    if (!items.length) return `
      <div class="empty">
        <div class="empty-icon">${SECTION_META[state.section].icon}</div>
        <p>No ${SECTION_META[state.section].label.toLowerCase()} yet.</p>
        <button class="btn btn-primary" id="add-btn-empty">+ Add First</button>
      </div>`;

    if (state.section === 'plugins')        return renderPluginList(items);
    if (state.section === 'events')         return renderEventList(items);
    if (state.section === 'technologies')   return renderTechList(items);
    if (state.section === 'techCategories') return renderTechCategoriesList(items);
    return renderCardList(items);
  }

