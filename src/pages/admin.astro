        const color = getTagColor(t);
        return `<span class="tag-pill" style="background:${color}1a;color:${color};border:1px solid ${color}44">${esc(getTagName(t))}</span>`;
      }).join('');
      return `<div class="item-row" data-index="${i}">
        <span class="event-date-badge">${ev.date || '—'}</span>
        <div class="item-info">
          <h3>${esc(ev.title || 'Untitled')}</h3>
          <p>${tagPills} ${esc(ev.description || '')}</p>
