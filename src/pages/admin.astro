  // ═══════════════════════════════════════════════════════
  // SECTION LISTENERS
  // ═══════════════════════════════════════════════════════
  function attachSectionListeners() {
    const content = document.getElementById('content-area')!;

    // List: edit / delete / add empty
    content.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const editBtn = target.closest('.edit-btn') as HTMLElement | null;
      const delBtn  = target.closest('.del-btn')  as HTMLElement | null;
      const addEmpty = target.closest('#add-btn-empty');

      if (editBtn) {
        const idx = parseInt(editBtn.dataset.index!);
        state.editing = { item: deepClone(state.data[state.section][idx]), index: idx };
        render();
      }
      if (delBtn) {
        const idx = parseInt(delBtn.dataset.index!);
        const name = state.data[state.section][idx]?.title || state.data[state.section][idx]?.name || 'this item';
        if (!confirm(`Delete "${name}"?`)) return;
        state.data[state.section].splice(idx, 1);
        state.dirty[state.section] = true;
        render();
      }
      if (addEmpty) {
        state.editing = { item: newItem(state.section), index: -1 };
        render();
      }
    });

    if (state.editing) attachFormListeners();
  }

  function attachFormListeners() {
    const sec = state.section;

    // Cancel
    document.getElementById('cancel-edit-btn2')?.addEventListener('click', () => {
      state.editing = null; render();
    });

    // Save item
    document.getElementById('save-item-btn')?.addEventListener('click', async () => {
      await commitEditItem();
    });

    if (sec === 'events') attachEventFormListeners();
    else attachSimpleFormListeners();
  }

  // ── Event form listeners ────────────────────────────────
  function attachEventFormListeners() {
    const ev = state.editing!.item;

    // Image upload
    const fileInput = document.getElementById('img-file-input') as HTMLInputElement | null;
    const uploadZone = document.getElementById('img-upload-zone')!;

    fileInput?.addEventListener('change', () => handleImageFiles(Array.from(fileInput.files || [])));

    uploadZone.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.classList.add('drag-active'); });
    uploadZone.addEventListener('dragleave', ()=> uploadZone.classList.remove('drag-active'));
    uploadZone.addEventListener('drop', (e) => {
      e.preventDefault(); uploadZone.classList.remove('drag-active');
      handleImageFiles(Array.from(e.dataTransfer?.files || []));
    });

    // Image delete
    document.getElementById('img-grid')?.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest('.img-del') as HTMLElement | null;
      if (!btn) return;
      const idx = parseInt(btn.dataset.index!);
      const images: string[] = ev.images || [];
      const removed = images[idx];
      if (removed?.startsWith('blob:')) {
        URL.revokeObjectURL(removed);
        delete state.pendingUploads[removed];
      }
      images.splice(idx, 1);
      ev.images = images;
      refreshImgGrid();
    });

    // Drag-to-reorder images
    attachImageDragSort();

    // Add paragraph
    document.getElementById('add-para-btn')?.addEventListener('click', () => {
      const list = document.getElementById('ext-desc-list')!;
      const count = list.querySelectorAll('.ext-para').length;
      const row = document.createElement('div');
      row.className = 'dyn-row';
      row.innerHTML = `<span class="dyn-label">¶${count+1}</span>
        <textarea class="ext-para" rows="2"></textarea>
        <button class="btn btn-ghost btn-sm dyn-del" data-i="${count}">✕</button>`;
      list.appendChild(row);
      attachParaDeleteListeners();
    });
    attachParaDeleteListeners();

    // Add link
    document.getElementById('add-link-btn')?.addEventListener('click', () => {
      const list = document.getElementById('links-list')!;
      const row = document.createElement('div');
      row.className = 'dyn-row';
      row.innerHTML = `<input class="link-text" placeholder="Label" style="flex:.4" />
        <input class="link-url" placeholder="https://…" style="flex:.6" />
        <button class="btn btn-ghost btn-sm dyn-del-link">✕</button>`;
      list.appendChild(row);
      attachLinkDeleteListeners();
    });
    attachLinkDeleteListeners();

    // Add document
    document.getElementById('add-doc-btn')?.addEventListener('click', () => {
      const list = document.getElementById('docs-list')!;
      const row = document.createElement('div');
      row.className = 'dyn-row';
      row.innerHTML = `<input class="doc-text" placeholder="Label" style="flex:.4" />
        <input class="doc-url" placeholder="Path or URL" style="flex:.6" />
        <button class="btn btn-ghost btn-sm dyn-del-doc">✕</button>`;
      list.appendChild(row);
      attachDocDeleteListeners();
    });
    attachDocDeleteListeners();
  }

  function attachParaDeleteListeners() {
    document.getElementById('ext-desc-list')?.querySelectorAll('.dyn-del').forEach(btn => {
      btn.replaceWith(btn.cloneNode(true));
    });
    document.getElementById('ext-desc-list')?.querySelectorAll('.dyn-del').forEach(btn => {
      btn.addEventListener('click', () => {
        (btn as HTMLElement).closest('.dyn-row')!.remove();
        document.getElementById('ext-desc-list')?.querySelectorAll('.dyn-label').forEach((el, i) => { el.textContent = `¶${i+1}`; });
      });
    });
  }

  function attachLinkDeleteListeners() {
    document.getElementById('links-list')?.querySelectorAll('.dyn-del-link').forEach(btn => {
      btn.replaceWith(btn.cloneNode(true));
    });
    document.getElementById('links-list')?.querySelectorAll('.dyn-del-link').forEach(btn => {
      btn.addEventListener('click', () => (btn as HTMLElement).closest('.dyn-row')!.remove());
    });
  }

  function attachDocDeleteListeners() {
    document.getElementById('docs-list')?.querySelectorAll('.dyn-del-doc').forEach(btn => {
      btn.replaceWith(btn.cloneNode(true));
    });
    document.getElementById('docs-list')?.querySelectorAll('.dyn-del-doc').forEach(btn => {
      btn.addEventListener('click', () => (btn as HTMLElement).closest('.dyn-row')!.remove());
    });
  }

  // ── Image drag sort ─────────────────────────────────────
  let dragSrc: number | null = null;

  function attachImageDragSort() {
    const grid = document.getElementById('img-grid');
    if (!grid) return;

    grid.querySelectorAll('[data-drag-index]').forEach(item => {
      item.addEventListener('dragstart', (e) => {
        dragSrc = parseInt((item as HTMLElement).dataset.dragIndex!);
        (e as DragEvent).dataTransfer!.effectAllowed = 'move';
        setTimeout(() => item.classList.add('dragging'), 0);
      });
      item.addEventListener('dragend', () => {
        item.classList.remove('dragging');
        grid.querySelectorAll('.drag-over').forEach(el => el.classList.remove('drag-over'));
      });
      item.addEventListener('dragover', (e) => {
        e.preventDefault();
        grid.querySelectorAll('.drag-over').forEach(el => el.classList.remove('drag-over'));
        item.classList.add('drag-over');
      });
      item.addEventListener('dragleave', (e) => {
        if (!(item as HTMLElement).contains((e as DragEvent).relatedTarget as Node)) {
          item.classList.remove('drag-over');
        }
      });
      item.addEventListener('drop', (e) => {
        e.preventDefault();
        item.classList.remove('drag-over');
        const overIdx = parseInt((item as HTMLElement).dataset.dragIndex!);
        if (dragSrc === null || dragSrc === overIdx) return;
        const images: string[] = state.editing!.item.images || [];
        const [moved] = images.splice(dragSrc, 1);
        images.splice(overIdx, 0, moved);
        state.editing!.item.images = images;
        dragSrc = null;
        refreshImgGrid();
      });
    });
  }

  function refreshImgGrid() {
    const grid = document.getElementById('img-grid');
    if (!grid) return;
    const images: string[] = state.editing!.item.images || [];
    grid.innerHTML = renderImageItems(images);
    attachImageDragSort();
    // re-attach delete listeners
    grid.querySelectorAll('.img-del').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt((btn as HTMLElement).dataset.index!);
        const images: string[] = state.editing!.item.images || [];
        const removed = images[idx];
        if (removed?.startsWith('blob:')) { URL.revokeObjectURL(removed); delete state.pendingUploads[removed]; }
        images.splice(idx, 1);
        state.editing!.item.images = images;
        refreshImgGrid();
      });
    });
  }

  // ── Handle image file selection ─────────────────────────
  function handleImageFiles(files: File[]) {
    const ev = state.editing!.item;
    if (!ev.images) ev.images = [];
    files.filter(f => f.type.startsWith('image/')).forEach(file => {
      const blobUrl = URL.createObjectURL(file);
      const folder  = (document.getElementById('f-folder') as HTMLInputElement)?.value.trim() || ev.title || 'uploads';
      state.pendingUploads[blobUrl] = { file, folder };
      ev.images.push(blobUrl);
    });
    refreshImgGrid();
  }

  // ── Simple form listeners (logo upload) ─────────────────
  function attachSimpleFormListeners() {
    const fileInput = document.getElementById('logo-file-input') as HTMLInputElement | null;
    fileInput?.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      // preview immediately
      const blobUrl = URL.createObjectURL(file);
      const preview = document.getElementById('logo-preview-img') as HTMLImageElement;
      if (preview) { preview.tagName === 'IMG' ? (preview.src = blobUrl) : (() => { const img = document.createElement('img'); img.className = 'logo-preview'; img.id = 'logo-preview-img'; img.src = blobUrl; preview.replaceWith(img); })(); }
      const logoInput = document.getElementById('f-logo') as HTMLInputElement || document.getElementById('f-src') as HTMLInputElement;
      const sec = state.section;
      const folder = IMG_FOLDER[sec];
      const repoPath = `${folder}/${file.name}`;
      try {
        showLoading('Uploading image…');
        await uploadImage(repoPath, file);
        hideLoading();
        const publicPath = '/' + repoPath.replace('public/', '');
        if (logoInput) logoInput.value = publicPath;
        URL.revokeObjectURL(blobUrl);
        showToast('Image uploaded!', 'success');
      } catch (e: any) {
        hideLoading();
        showToast('Upload failed: ' + e.message, 'error');
      }
    });
  }

  // ═══════════════════════════════════════════════════════
  // COLLECT & COMMIT EDIT ITEM
  // ═══════════════════════════════════════════════════════
  async function commitEditItem() {
    const sec = state.section;
    const btn = document.getElementById('save-item-btn') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = '⏳ Saving…';

    try {
      let item: any;
      if (sec === 'events') {
        item = collectEventForm();
        // upload pending images
        if (item.images?.some((s: string) => s.startsWith('blob:'))) {
          showLoading('Uploading images…');
          const folder = item.imageFolder || item.title || 'uploads';
          const resolved: string[] = [];
          for (const src of item.images) {
            if (src.startsWith('blob:')) {
              const pending = state.pendingUploads[src];
              if (pending) {
                const repoPath = `public/events/${folder}/${pending.file.name}`;
                await uploadImage(repoPath, pending.file);
                resolved.push(`events/${folder}/${pending.file.name}`);
                URL.revokeObjectURL(src);
                delete state.pendingUploads[src];
              }
            } else {
              resolved.push(src);
            }
          }
          item.images = resolved;
          hideLoading();
        }
        delete item.imageFolder;
      } else if (sec === 'technologies') {
        item = collectTechForm();
      } else {
        item = collectSimpleForm();
      }

      const idx = state.editing!.index;
      if (idx === -1) {
        state.data[sec].push(item);
      } else {
        state.data[sec][idx] = item;
      }
      state.dirty[sec] = true;
      state.editing = null;

      // auto-save
      showLoading('Saving to GitHub…');
      await saveSection(sec);
      hideLoading();
      showToast('Saved! Site will rebuild shortly.', 'success');
      render();
    } catch (e: any) {
      hideLoading();
      showToast('Error: ' + e.message, 'error');
      btn.disabled = false; btn.textContent = '💾 Save';
    }
  }

  function collectEventForm(): any {
    const get = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value.trim() || '';
    const tags = Array.from(document.querySelectorAll<HTMLInputElement>('.tag-check:checked')).map(c => c.value);
    const extDesc = Array.from(document.querySelectorAll<HTMLTextAreaElement>('.ext-para')).map(t => t.value.trim()).filter(Boolean);
    const links = Array.from(document.querySelectorAll('#links-list .dyn-row')).map(row => ({
      text: (row.querySelector('.link-text') as HTMLInputElement)?.value.trim() || '',
      url:  (row.querySelector('.link-url')  as HTMLInputElement)?.value.trim() || '',
    })).filter(l => l.url);
    const docs = Array.from(document.querySelectorAll('#docs-list .dyn-row')).map(row => ({
      text: (row.querySelector('.doc-text') as HTMLInputElement)?.value.trim() || '',
      url:  (row.querySelector('.doc-url')  as HTMLInputElement)?.value.trim() || '',
    })).filter(d => d.url);
    const title = get('f-title');
    const existingId = state.editing!.index !== -1 ? state.editing!.item.id : null;
    return {
      id: existingId || `evt-${get('f-date').substring(0,7)}-${slugify(title)}`,
      date: get('f-date'),
      title,
      tags,
      description: get('f-desc'),
      extendedDescription: extDesc,
      expandable: (document.getElementById('f-expandable') as HTMLInputElement)?.checked ?? true,
      images: state.editing!.item.images || [],
      links,
      documents: docs,
      imageFolder: get('f-folder'),
    };
  }

  function collectSimpleForm(): any {
    const get = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value.trim() || '';
    const sec = state.section;
    if (sec === 'projects') {
      return { href: get('f-href'), image: get('f-logo'), name: get('f-name'), desc: get('f-desc') };
    }
    return { href: get('f-href'), logo: get('f-logo'), name: get('f-name'), role: get('f-role'), period: get('f-period') };
  }

  function collectTechForm(): any {
    const get = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value.trim() || '';
    return { src: get('f-src'), name: get('f-name') };
  }

  // ═══════════════════════════════════════════════════════
  // HELPERS
  // ═══════════════════════════════════════════════════════
  function getTags(ev: any): string[] {
    if (Array.isArray(ev.tags)) return ev.tags;
    if (Array.isArray(ev.categories)) return ev.categories;
    if (ev.category) return [ev.category];
    return [];
  }

  function newItem(sec: string): any {
    if (sec === 'events')       return { id: '', date: '', title: '', tags: [], description: '', extendedDescription: [], expandable: true, images: [], links: [], documents: [] };
    if (sec === 'technologies') return { src: '', name: '' };
    if (sec === 'projects')     return { href: '', image: '', name: '', desc: '' };
    return { href: '', logo: '', name: '', role: '', period: '' };
  }

  function deepClone<T>(obj: T): T { return JSON.parse(JSON.stringify(obj)); }
  function esc(s: string): string {
    return String(s || '').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }
  function slugify(s: string): string { return s.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,''); }

  // ═══════════════════════════════════════════════════════
  // TOAST & LOADING
  // ═══════════════════════════════════════════════════════
  let toastTimer: ReturnType<typeof setTimeout> | null = null;
  function showToast(msg: string, type: 'success'|'error'|'info' = 'success') {
    document.querySelector('.toast')?.remove();
    const t = document.createElement('div');
    t.className = `toast toast-${type}`;
    t.textContent = msg;
    document.body.appendChild(t);
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.remove(), 4500);
  }

  function showLoading(msg = 'Loading…') {
    document.querySelector('.loading-overlay')?.remove();
    const el = document.createElement('div');
    el.className = 'loading-overlay';
    el.innerHTML = `<div class="spinner"></div><span>${msg}</span>`;
    document.body.appendChild(el);
  }
  function hideLoading() { document.querySelector('.loading-overlay')?.remove(); }

  // ═══════════════════════════════════════════════════════
  // INIT
  // ═══════════════════════════════════════════════════════
  async function init() {
    if (!state.token) { render(); return; }
    showLoading('Loading content…');
    try {
      const userRes = await fetch(`${GH_API}/user`, { headers: { Authorization: `Bearer ${state.token}` } });
      if (!userRes.ok) throw Object.assign(new Error('Token expired'), { status: 401 });
      state.user = await userRes.json();
      await Promise.all(Object.keys(FILE_MAP).map(loadSection));
      hideLoading();
      render();
    } catch (e: any) {
      hideLoading();
      if (e.status === 401) { sessionStorage.removeItem('admin_token'); state.token = null; }
      render();
      if (e.status === 401) showToast('Session expired. Please sign in again.', 'error');
    }
  }

  init();
  </script>
</body>
</html>
