          <button class="btn btn-secondary btn-sm edit-btn" data-index="${i}">✏️ Edit</button>
          <button class="btn btn-danger btn-sm del-btn" data-index="${i}">🗑</button>
        </div>
      </div>`;
    }).join('')}</div>`;
  }

