---
import ConsultingLayout from '../../layouts/ConsultingLayout.astro';
import ConsultingHero from '../../components/ConsultingHero.astro';
import ConsultingCta from '../../components/ConsultingCta.astro';
import SegmentContent from '../../components/SegmentContent.astro';
import { BASE } from '../../data/consulting';

const title = 'For Mid-Size Studios · AI Setup Consulting for Game Studios';
const description = 'AI engineering infrastructure for mid-size Unreal studios of 30-80 developers: cross-project knowledge, 40-60% review time reduction, and institutional memory that survives turnover.';

const seen = [
  'Tech leads spend disproportionate time on code review across teams.',
  'Coding standards exist as documents nobody references.',
  'New hires take months to become productive because context is scattered.',
  'Multiple projects mean multiple slightly different conventions, and nobody has time to align them.',
  'Shadow AI adoption is happening, but leadership has no visibility into it.',
];

const deliver = [
  'Centralized brain with your specific conventions, per module.',
  'MCP Perforce server with audit logs and safety controls.',
  'Automated code review pipeline posting to Swarm or Jira.',
  'Cross-project knowledge that transfers automatically.',
  'Privacy tier configured for your IP sensitivity.',
  'Team training for engineers and tech leads.',
];

const investment = {
  caption: 'Typical first-year investment',
  band: '€75,000 - €110,000',
  points: [
    { label: 'Break-even', value: '5-7 months' },
    { label: 'Year 2+ ROI', value: '~3.4x' },
    { label: 'Billing', value: 'Fixed-fee + retainer' },
  ],
  breakdown: [
    { line: 'AI Readiness Audit',        price: '€6,000 - €9,000',   note: 'Fixed-fee, 2-3 weeks. Nine named deliverables.' },
    { line: 'Setup & Integration',       price: '€35,000 - €55,000', note: 'Fixed-fee, 6 weeks. Includes team training and handover.' },
    { line: 'Retainer (12 months)',      price: '€34,000 - €46,000', note: '€3-4k/month. Bi-weekly office hours, PR review, quarterly ROI reports.' },
    { line: 'Anthropic seats + tokens',  price: 'billed separately', note: 'Paid directly to Anthropic. ~€350-500/dev/year at typical usage.' },
  ],
  note: 'Indicative range. Sub-bands scale with codebase size and privacy tier. Exact numbers are scoped in the Discovery Call and confirmed in the Audit.',
};

const faqs = [
  {
    q: 'We run three projects with different conventions. Can one brain handle that?',
    a: 'Yes. The brain is hierarchical: shared studio conventions at the top, per-project and per-module rules below. Cross-project knowledge transfers automatically, while each project keeps the rules that make it different.',
  },
  {
    q: 'Our tech leads are the bottleneck. How does this help them specifically?',
    a: 'Server-side review runs on every submit and catches convention violations before a lead sees them. That removes the mechanical part of review, so leads spend their time on architecture and design instead of style nitpicks.',
  },
  {
    q: 'How disruptive is the rollout while we are mid-production?',
    a: 'Setup is delivered module by module, not big bang. We start where the payback is highest and expand from there, so the team keeps shipping throughout.',
  },
];
---
<ConsultingLayout
  title={title}
  description={description}
  path={`${BASE}/for-mid-size/`}
>
  <ConsultingHero
    eyebrow="For Mid-Size Studios · 30-80 developers"
    title="The pipeline scaled to"
    accent="mid-size Unreal studios."
    subtitle="Multiple projects, dedicated tech leads, and formal standards nobody has time to enforce. All five pipeline layers, calibrated for cross-project knowledge and formalized review. This is the engagement we run most, and the scale where AI infrastructure pays back fastest."
    secondaryLabel="See the pipeline"
    secondaryHref={`${BASE}/technology#pipeline`}
  />

  <SegmentContent seen={seen} deliver={deliver} investment={investment} faqs={faqs} />

  <ConsultingCta
    title="See if it pays back for your studio."
    subtitle="A 30-minute Discovery Call is enough to sketch the ROI for a team your size. Free, no pitch deck, and a clear answer either way."
  />
</ConsultingLayout>
