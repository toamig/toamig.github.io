---
import ConsultingLayout from '../../layouts/ConsultingLayout.astro';
import ConsultingHero from '../../components/ConsultingHero.astro';
import ConsultingCta from '../../components/ConsultingCta.astro';
import ConsultingIcon from '../../components/ConsultingIcon.astro';
import PipelineDiagram from '../../components/PipelineDiagram.astro';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import BrainGovernanceFlow from '../../components/BrainGovernanceFlow.astro';
import {
  BASE, BOOK_PATH,
  PIPELINE, PIPELINE_PRINCIPLE,
  BRAIN_CONTENT, BRAIN_ACCESS, BRAIN_PROTECTION, BRAIN_UPDATE_PATHS, BRAIN_VERSIONING, BRAIN_TELEMETRY,
  ARCHITECTURE_COMPONENTS, ARCHITECTURE_FOOTPRINT,
  PRIVACY_TIERS, PRIVACY_DISTINCTION,
  WHAT_WE_DONT_CLAIM,
} from '../../data/consulting';

const title = 'Technology & Architecture · AI Setup Consulting for Game Studios';
const description = 'The technical brief. The five-layer pipeline, brain governance, six-component architecture, four privacy tiers with the retention-vs-training distinction. Written for CTOs.';
---
<ConsultingLayout
  title={title}
  description={description}
  path={`${BASE}/technology/`}
  active={`${BASE}/technology`}
>
  <ConsultingHero
    eyebrow="Technology"
    title="The technical brief,"
    accent="for CTOs."
    subtitle="How the pipeline fits together, how the brain is governed, how the architecture stays boring, and where the honest limits are. Dense, specific, free of marketing."
    primaryLabel="Discuss your architecture"
    secondaryLabel="See how we work"
    secondaryHref={`${BASE}/approach`}
  />

  <!-- ── The Pipeline (full reference) ─────────────────────── -->
  <section id="pipeline" class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">The pipeline</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Five layers. Each with one job.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] text-text-2 leading-[1.65]">
          Layers reinforce each other rather than repeat each other. Running the same check three times in three places wastes tokens, creates alert fatigue, and erodes trust. Running distinct checks at distinct moments compounds value without compounding cost.
        </p>
      </div>

      <PipelineDiagram layers={PIPELINE} />

      <div data-fade class="max-w-3xl mx-auto mt-14 p-6 md:p-7 rounded-lg border border-amber/40 bg-amber-soft/30">
        <p class="font-mono text-[11.5px] uppercase tracking-[0.14em] text-amber mb-3">Human in the loop, always</p>
        <p class="text-[15.5px] text-text leading-[1.65]">{PIPELINE_PRINCIPLE}</p>
      </div>
    </div>
  </section>

  <!-- ── The Brain ─────────────────────────────────────────── -->
  <section id="brain" class="py-20 md:py-28 border-b border-border/40 bg-ink-2/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">The brain</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Centralized, governed, inviolable.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] text-text-2 leading-[1.65]">
          A structured knowledge layer accessible to all pipeline layers. Version-controlled. Consulted through MCP, not raw file reads. Individual developers can query it. Only tech leads can change it.
        </p>
      </div>

      <!-- What the brain is -->
      <div class="mb-16">
        <h3 data-fade class="font-mono text-[11.5px] uppercase tracking-[0.15em] text-text-3 mb-5">What the brain contains</h3>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-border/60 border border-border/60 rounded-lg overflow-hidden">
          {BRAIN_CONTENT.map((c, i) => (
            <div data-fade data-fade-delay={i * 40} class="bg-surface p-6">
              <h4 class="text-[15px] font-semibold text-text mb-2">{c.title}</h4>
              <p class="text-[13.5px] text-text-2 leading-[1.55]">{c.body}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- How consulted + How protected -->
      <div class="grid md:grid-cols-2 gap-5 mb-16">
        <div data-fade class="p-7 md:p-8 rounded-lg border border-border bg-surface">
          <div class="w-10 h-10 rounded-md bg-amber/10 border border-amber/25 flex items-center justify-center text-amber mb-5">
            <ConsultingIcon name="server" size={19} />
          </div>
          <h3 class="text-[19px] font-semibold text-text mb-4">How the brain is consulted</h3>
          <p class="text-[14.5px] text-text-2 leading-[1.6] mb-5">Agents access the brain through an MCP server, not through direct file reads. This gives:</p>
          <ul class="flex flex-col gap-2.5">
            {BRAIN_ACCESS.map(a => (
              <li class="flex items-start gap-2.5 text-[14px] text-text-2 leading-[1.55]">
                <span class="text-amber mt-0.5 flex-shrink-0"><ConsultingIcon name="check" size={14} class="stroke-[2.5]" /></span>
                {a}
              </li>
            ))}
          </ul>
        </div>
        <div data-fade data-fade-delay="80" class="p-7 md:p-8 rounded-lg border border-border bg-surface">
          <div class="w-10 h-10 rounded-md bg-amber/10 border border-amber/25 flex items-center justify-center text-amber mb-5">
            <ConsultingIcon name="lock" size={19} />
          </div>
          <h3 class="text-[19px] font-semibold text-text mb-4">How the brain is protected</h3>
          <p class="text-[14.5px] text-text-2 leading-[1.6] mb-5">Individual developers cannot modify brain content. Enforcement is technical, not administrative:</p>
          <ul class="flex flex-col gap-2.5">
            {BRAIN_PROTECTION.map(p => (
              <li class="flex items-start gap-2.5 text-[14px] text-text-2 leading-[1.55]">
                <span class="text-amber mt-0.5 flex-shrink-0"><ConsultingIcon name="check" size={14} class="stroke-[2.5]" /></span>
                {p}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- How updated (BrainGovernanceFlow diagram) -->
      <div class="mb-16">
        <div class="max-w-3xl mb-10">
          <h3 data-fade class="font-mono text-[11.5px] uppercase tracking-[0.15em] text-text-3 mb-3">How the brain is updated</h3>
          <p data-fade data-fade-delay="60" class="text-[17px] text-text leading-[1.55]">
            Three approved paths. All converge on the same gate.
          </p>
        </div>
        <div data-fade>
          <BrainGovernanceFlow paths={BRAIN_UPDATE_PATHS} />
        </div>
      </div>

      <!-- Versioning + telemetry -->
      <div class="grid md:grid-cols-2 gap-5">
        <div data-fade class="p-7 md:p-8 rounded-lg border border-border bg-surface">
          <h3 class="text-[19px] font-semibold text-text mb-2">Versioning & rollback</h3>
          <p class="text-[14px] text-text-2 leading-[1.6] mb-5">Semantic versioning. Every version tagged and immutable. Rollback is a matter of pointing the MCP server at a previous tag.</p>
          <div class="flex flex-col gap-3">
            {BRAIN_VERSIONING.map(v => (
              <div class="flex items-start gap-3">
                <span class="font-mono text-[13px] text-amber mt-0.5 flex-shrink-0 min-w-[110px]">{v.label}</span>
                <span class="text-[14px] text-text-2 leading-[1.5]">{v.body}</span>
              </div>
            ))}
          </div>
        </div>
        <div data-fade data-fade-delay="80" class="p-7 md:p-8 rounded-lg border border-border bg-surface">
          <h3 class="text-[19px] font-semibold text-text mb-2">Telemetry</h3>
          <p class="text-[14px] text-text-2 leading-[1.6] mb-5">The MCP server logs (respecting configured privacy tier) to inform quarterly brain-health reviews:</p>
          <ul class="flex flex-col gap-2.5">
            {BRAIN_TELEMETRY.map(t => (
              <li class="flex items-start gap-2.5 text-[14px] text-text-2 leading-[1.55]">
                <span class="text-amber mt-0.5 flex-shrink-0"><ConsultingIcon name="check" size={14} class="stroke-[2.5]" /></span>
                {t}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Architecture ─────────────────────────────────────── -->
  <section id="architecture" class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Architecture</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Two small VMs. Standard components. Nothing exotic.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] text-text-2 leading-[1.65]">
          Six components in three tiers. Brain repo is the source of truth. Context server serves it through MCP. Sessions and workers consume it. Anthropic API and studio systems close the loop.
        </p>
      </div>

      <div data-fade class="mb-14">
        <ArchitectureDiagram components={ARCHITECTURE_COMPONENTS} />
      </div>

      <!-- Footprint metrics -->
      <div data-fade class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-border/60 border border-border/60 rounded-lg overflow-hidden mb-12">
        {ARCHITECTURE_FOOTPRINT.map(f => (
          <div class="bg-surface p-6">
            <p class="font-mono text-[11.5px] uppercase tracking-[0.12em] text-text-3 mb-2">{f.label}</p>
            <p class="text-[17px] text-text font-semibold">{f.value}</p>
          </div>
        ))}
      </div>

      <!-- Component reference -->
      <div class="grid md:grid-cols-2 gap-5">
        {ARCHITECTURE_COMPONENTS.map((c, i) => (
          <div data-fade data-fade-delay={i * 40} class="p-6 rounded-lg border border-border bg-surface">
            <div class="flex items-baseline justify-between mb-2">
              <h3 class="text-[17px] font-semibold text-text">{c.name}</h3>
              <span class="font-mono text-[11.5px] text-text-3">{c.sub}</span>
            </div>
            <p class="text-[14px] text-text-2 leading-[1.6]">{c.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Privacy tiers ─────────────────────────────────────── -->
  <section id="privacy" class="py-20 md:py-28 border-b border-border/40 bg-ink-2/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Privacy tiers</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Data protection matched to your IP sensitivity.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] text-text-2 leading-[1.65]">
          Not every studio has the same requirements. An indie studio with a small proprietary game has different needs than an AAA studio with console SDKs and publisher NDAs. We match the tier to the reality.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-5 mb-12">
        {PRIVACY_TIERS.map((t, i) => (
          <div data-fade data-fade-delay={i * 60} class="p-7 rounded-lg border border-border bg-surface">
            <div class="flex items-baseline gap-3 mb-3">
              <span class="font-mono text-[12px] text-amber tracking-[0.1em] uppercase">{t.tier}</span>
              <span class="font-mono text-[12px] text-text-3">0{i + 1} / 04</span>
            </div>
            <h3 class="text-[19px] font-semibold tracking-tight mb-1">{t.title}</h3>
            <p class="font-mono text-[12.5px] text-text-3 mb-4">{t.subtitle}</p>
            <p class="text-[14.5px] text-text-2 leading-[1.6] mb-4">{t.body}</p>
            <p class="text-[13.5px] text-text-3 leading-[1.55]"><span class="text-text-2 font-medium">When we recommend:</span> {t.when}</p>
          </div>
        ))}
      </div>

      <!-- Retention vs training distinction (critical procurement clarification) -->
      <div class="max-w-4xl mx-auto">
        <div data-fade class="mb-4">
          <p class="font-mono text-[11.5px] uppercase tracking-[0.15em] text-amber">Important distinction</p>
          <h3 class="text-[22px] font-semibold text-text mt-2">Retention is not the same as training.</h3>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          <div data-fade class="p-6 rounded-lg border border-amber/40 bg-amber-soft/20">
            <p class="font-mono text-[11.5px] uppercase tracking-[0.14em] text-amber mb-3">Default in every commercial plan</p>
            <h4 class="text-[16px] font-semibold text-text mb-2">{PRIVACY_DISTINCTION.training.title}</h4>
            <p class="text-[14px] text-text-2 leading-[1.6]">{PRIVACY_DISTINCTION.training.body}</p>
          </div>
          <div data-fade data-fade-delay="80" class="p-6 rounded-lg border border-amber/40 bg-amber-soft/20">
            <p class="font-mono text-[11.5px] uppercase tracking-[0.14em] text-amber mb-3">Requires an addendum</p>
            <h4 class="text-[16px] font-semibold text-text mb-2">{PRIVACY_DISTINCTION.retention.title}</h4>
            <p class="text-[14px] text-text-2 leading-[1.6]">{PRIVACY_DISTINCTION.retention.body}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── What we don't claim ───────────────────────────────── -->
  <section id="limits" class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-4xl mx-auto px-6">
      <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Honest limits</p>
      <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-8">
        What we do not claim.
      </h2>
      <ul class="border-t border-border/60">
        {WHAT_WE_DONT_CLAIM.map((w, i) => (
          <li data-fade data-fade-delay={i * 40} class="flex items-start gap-4 py-5 border-b border-border/60">
            <span class="text-text-3 mt-0.5 flex-shrink-0"><ConsultingIcon name="x" size={17} class="stroke-[2.5]" /></span>
            <span class="text-[16px] text-text-2 leading-[1.6]">{w}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ConsultingCta
    title="Discuss your architecture in a Discovery Call."
    subtitle="Bring your stack, your compliance constraints, and your hardest integration question. 30 minutes, free, engineer to engineer."
    secondaryLabel="See the services"
    secondaryHref={`${BASE}/services`}
  />
</ConsultingLayout>
