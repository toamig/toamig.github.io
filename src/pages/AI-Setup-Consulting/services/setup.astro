---
import ConsultingLayout from '../../../layouts/ConsultingLayout.astro';
import ConsultingHero from '../../../components/ConsultingHero.astro';
import ConsultingCta from '../../../components/ConsultingCta.astro';
import ConsultingIcon from '../../../components/ConsultingIcon.astro';
import PipelineDiagram from '../../../components/PipelineDiagram.astro';
import {
  BASE, BOOK_PATH,
  PIPELINE,
  DELIVERABLE_GROUPS, SKILLS_LIBRARY,
  ENGAGEMENT_EXCLUDES,
} from '../../../data/consulting';

const title = 'Setup & Integration · AI Setup Consulting for Game Studios';
const description = 'Setup & Integration for Unreal studios. Implementation of all five pipeline layers, brain repository, MCP servers, studio-adapted skills library, and system integrations. Fixed-fee, delivered module by module with measurement.';

const facts = [
  { label: 'Duration', value: '3-16 weeks' },
  { label: 'Billing', value: 'Fixed-fee' },
  { label: 'Rollout', value: 'Module by module' },
];

const resources = [
  { role: 'Engineering sponsor', time: '~1h/week (SPOC)', access: 'Decision-maker for scope questions' },
  { role: 'Tech lead(s)', time: '2-4h/week during rollout', access: 'Full repo, Perforce super-user' },
  { role: 'IT contact', time: '4-8h total', access: 'Infra provisioning, CI admin' },
  { role: 'Pilot team (3-5 devs)', time: '2-3 days for training', access: 'Active project code' },
];

const milestones = [
  { week: 'Week 1', title: 'Kickoff & infra', body: 'Provisioning, privacy tier deployment, access setup. Brain repository bootstrapped in your Git provider.' },
  { week: 'Week 2', title: 'First brain module', body: 'One module ships live (chosen with your lead — usually the one with noisiest reviews). Developers can query it.' },
  { week: 'Week 3', title: 'MCP Perforce live', body: 'Official Perforce MCP configured with studio-specific safety rules. Audit logs on. Read-only mode first.' },
  { week: 'Week 4', title: 'Pipeline layers 3 & 4', body: 'Pre-submit hook and automation worker running for the pilot team. Post-submit review posts to Swarm or Jira. Baseline metrics captured.' },
  { week: 'Week 5', title: 'Team training', body: '2-3 days of hands-on training on your real codebase. Recorded for future hires.' },
  { week: 'Week 6', title: 'Full rollout & handover', body: 'Remaining modules and teams onboarded. Handover session with the operating lead, recorded. Post-baseline metrics.' },
];

const handover = [
  'Live handover session with your operating lead (2h, recorded).',
  'All repos transferred to your Git provider.',
  'Operating runbook and onboarding guide live in the brain.',
  'Baseline and post-rollout metrics documented against your ROI targets.',
  '30 days of email support included after handover.',
  'Retainer optional; no obligation to continue.',
];
---
<ConsultingLayout
  title={title}
  description={description}
  path={`${BASE}/services/setup/`}
  active={`${BASE}/services`}
>
  <ConsultingHero
    eyebrow="Setup & Integration"
    title="The pipeline, the brain,"
    accent="and the skills — deployed."
    subtitle="The Audit roadmap becomes working infrastructure your team owns. All five pipeline layers, a governed brain, a studio-adapted skill library, and every integration your existing tooling needs."
    primaryLabel="Book a call to plan your Setup"
    secondaryLabel="Read the technical brief"
    secondaryHref={`${BASE}/technology`}
  />

  <!-- ── What it is ────────────────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-4xl mx-auto px-6">
      <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">What it is</p>
      <p data-fade data-fade-delay="60" class="text-[19px] md:text-[22px] text-text leading-[1.5] mb-10">
        We build the infrastructure from your Audit roadmap and integrate it with the tools your team already uses. Three to sixteen weeks depending on studio size. Delivered one module at a time so nothing breaks all at once.
      </p>
      <div data-fade data-fade-delay="120" class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-border/60 border border-border/60 rounded-lg overflow-hidden">
        {facts.map(f => (
          <div class="bg-surface p-6">
            <p class="font-mono text-[11.5px] uppercase tracking-[0.12em] text-text-3 mb-2">{f.label}</p>
            <p class="text-[16px] text-text font-medium">{f.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── The five layers we deliver ───────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40 bg-ink-2/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">What Setup delivers</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          All five pipeline layers, working end to end.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] text-text-2 leading-[1.65]">
          Not a prototype. Not a proof-of-concept. Every layer configured, integrated, and measured — from write-time assistance in the IDE to Layer 5 continuous evolution feeding back into the brain.
        </p>
      </div>

      <PipelineDiagram layers={PIPELINE} />
    </div>
  </section>

  <!-- ── Deliverable groups ───────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Deliverables</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Concrete artifacts, delivered on schedule, owned by you.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] text-text-2 leading-[1.65]">
          Every artifact is version-controlled, documented, and belongs to the studio at engagement completion. No vendor lock-in, no proprietary formats.
        </p>
      </div>

      <div class="flex flex-col gap-12">
        {DELIVERABLE_GROUPS.map((group, gi) => (
          <div data-fade data-fade-delay={gi * 80}>
            <div class="flex items-center gap-4 mb-6">
              <div class="w-10 h-10 rounded-md bg-amber/10 border border-amber/25 flex items-center justify-center text-amber flex-shrink-0">
                <ConsultingIcon name={group.icon} size={19} />
              </div>
              <div>
                <p class="font-mono text-[11.5px] uppercase tracking-[0.14em] text-text-3">{`0${gi + 1}`.slice(-2)} · {group.items.length} artifacts</p>
                <h3 class="text-[22px] font-semibold text-text tracking-tight">{group.label}</h3>
              </div>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
              {group.items.map(item => (
                <div class="p-6 rounded-lg border border-border bg-surface">
                  <h4 class="text-[15.5px] font-semibold text-text mb-2 leading-snug">{item.name}</h4>
                  <p class="text-[13.5px] text-text-2 leading-[1.6]">{item.body}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Studio-adapted skills library ────────────────────── -->
  <section id="skills" class="py-20 md:py-28 border-b border-border/40 bg-ink-2/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Studio-adapted skills library</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Task-specific patterns. Adapted to your codebase.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] text-text-2 leading-[1.65]">
          Skills are the structured workflows Claude Code uses inside your studio. Delivered as versioned, documented artifacts. Each one adapted to your conventions, framework, and tooling.
        </p>
      </div>

      <div class="flex flex-col gap-8">
        {SKILLS_LIBRARY.map((domain, di) => (
          <div data-fade data-fade-delay={di * 40} class="rounded-lg border border-border bg-surface overflow-hidden">
            <div class="px-6 py-4 border-b border-border flex items-center gap-3">
              <div class="w-8 h-8 rounded-md bg-amber/10 border border-amber/25 flex items-center justify-center text-amber flex-shrink-0">
                <ConsultingIcon name={domain.icon} size={16} />
              </div>
              <h3 class="text-[15px] font-semibold text-text tracking-tight">{domain.domain}</h3>
              <span class="ml-auto font-mono text-[11.5px] text-text-3">{domain.skills.length} skills</span>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-border/60">
              {domain.skills.map(s => (
                <div class="bg-surface p-5">
                  <p class="font-mono text-[13.5px] text-amber mb-1.5">{s.name}</p>
                  <p class="text-[13px] text-text-2 leading-[1.55]">{s.body}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── What we need from your team ──────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-5xl mx-auto px-6">
      <div class="max-w-3xl mb-12">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">What we need from your team</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Predictable time commitment, four roles.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] text-text-2 leading-[1.6]">
          Scoped per week so your leads can plan around it. We do the engineering; you provide direction and access.
        </p>
      </div>
      <div data-fade data-fade-delay="180" class="rounded-lg border border-border overflow-hidden">
        <div class="grid grid-cols-[1.1fr_1fr_1.4fr] gap-px bg-border/60">
          <div class="px-5 md:px-6 py-4 bg-surface/60 font-mono text-[11.5px] uppercase tracking-[0.12em] text-text-3">Role</div>
          <div class="px-5 md:px-6 py-4 bg-surface/60 font-mono text-[11.5px] uppercase tracking-[0.12em] text-text-3">Time</div>
          <div class="px-5 md:px-6 py-4 bg-surface/60 font-mono text-[11.5px] uppercase tracking-[0.12em] text-text-3">Access / responsibility</div>
          {resources.map(r => (
            <>
              <div class="px-5 md:px-6 py-5 bg-ink text-[15px] font-medium text-text">{r.role}</div>
              <div class="px-5 md:px-6 py-5 bg-ink text-[14.5px] font-mono text-amber">{r.time}</div>
              <div class="px-5 md:px-6 py-5 bg-ink text-[14px] text-text-2">{r.access}</div>
            </>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Milestones ───────────────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40 bg-ink-2/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Milestones</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Every week has a visible deliverable.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] text-text-2 leading-[1.6]">
          Standard cadence for a 6-week Setup. Longer engagements (up to 16 weeks) add more modules, deeper MCPs, and multi-team rollout at the same weekly pace.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {milestones.map((m, i) => (
          <div data-fade data-fade-delay={i * 60} class="p-7 rounded-lg border border-border bg-surface">
            <span class="font-mono text-[12px] text-amber tracking-[0.1em] block mb-4">{m.week}</span>
            <h3 class="text-[17px] font-semibold text-text mb-3">{m.title}</h3>
            <p class="text-[14.5px] text-text-2 leading-[1.6]">{m.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Handover ─────────────────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-[1fr_1.1fr] gap-12 lg:gap-16 items-start">
        <div>
          <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Handover</p>
          <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
            Everything transfers, cleanly.
          </h2>
          <p data-fade data-fade-delay="120" class="text-[16px] text-text-2 leading-[1.65]">
            Your operating lead ends Setup owning every artifact, every credential, and every runbook. If you walk away that day, you walk away with the working system.
          </p>
        </div>
        <div data-fade data-fade-delay="120" class="rounded-lg border border-border bg-surface p-7 md:p-9">
          <ul class="flex flex-col gap-4">
            {handover.map(h => (
              <li class="flex items-start gap-3 text-[15px] text-text-2 leading-[1.55]">
                <span class="text-amber mt-0.5 flex-shrink-0"><ConsultingIcon name="check" size={16} class="stroke-[2.5]" /></span>
                {h}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Not in scope ─────────────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-4xl mx-auto px-6">
      <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Not in scope</p>
      <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-8">
        What Setup is not.
      </h2>
      <ul class="border-t border-border/60">
        {ENGAGEMENT_EXCLUDES.map((n, i) => (
          <li data-fade data-fade-delay={i * 40} class="grid grid-cols-[24px_1fr] gap-4 py-5 border-b border-border/60">
            <span class="text-text-3 mt-0.5"><ConsultingIcon name="x" size={17} class="stroke-[2.5]" /></span>
            <div>
              <p class="text-[16px] text-text mb-1 font-medium">{n.title}</p>
              <p class="text-[14.5px] text-text-2 leading-[1.55]">{n.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ConsultingCta
    title="Plan your Setup in a Discovery Call."
    subtitle="Setup scope is agreed after the Audit, so the price and timeline reflect your codebase, not a template. Start with a 30-minute call."
    primaryLabel="Book Discovery Call"
    primaryHref={BOOK_PATH}
    secondaryLabel="Explore the Retainer"
    secondaryHref={`${BASE}/services/retainer`}
  />
</ConsultingLayout>
