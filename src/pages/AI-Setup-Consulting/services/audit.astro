---
import ConsultingLayout from '../../../layouts/ConsultingLayout.astro';
import ConsultingHero from '../../../components/ConsultingHero.astro';
import ConsultingCta from '../../../components/ConsultingCta.astro';
import ConsultingIcon from '../../../components/ConsultingIcon.astro';
import { BASE, BOOK_PATH } from '../../../data/consulting';

const title = 'AI Readiness Audit · AI Setup Consulting for Game Studios';
const description = 'A fixed-fee, time-boxed AI Readiness Audit for Unreal studios. Nine named deliverables including a written report, executive summary, phased roadmap, cost model, and risk register. Week-by-week schedule and explicit scope boundaries.';

const facts = [
  { label: 'Duration', value: '1-3 weeks' },
  { label: 'Billing', value: 'Fixed-fee' },
  { label: 'Delivery', value: '9 named artifacts' },
];

const lookAt = [
  { title: 'Codebase structure', body: 'Module layout, gameplay framework, and where AI can safely operate versus where it must not.' },
  { title: 'Workflow analysis', body: 'How work moves from task to submit today, and where AI removes friction without adding risk.' },
  { title: 'Shadow AI scan', body: 'Where developers are already using consumer AI accounts on proprietary code, and the exposure that creates.' },
  { title: 'Coding standards review', body: 'The conventions that exist on paper versus the ones actually enforced in review.' },
  { title: 'Tooling assessment', body: 'Perforce or Plastic setup, CI, review tools, and how AI integrates with them safely.' },
  { title: 'IP sensitivity assessment', body: 'NDA scope, licensed IP, and console-SDK constraints that determine your privacy tier.' },
];

const deliverables = [
  { icon: 'file-text', title: 'Written report', format: 'PDF · 30-50 pages', body: 'Full assessment sectioned so leadership and engineers can each go straight to what they need.' },
  { icon: 'clipboard-check', title: 'Executive summary', format: 'PDF · 2-3 pages', body: 'Board-ready summary of findings, recommended tier, ROI estimate, and next steps.' },
  { icon: 'route', title: 'AI-safe zones map', format: 'Annotated diagram', body: 'Which parts of your codebase are safe for AI, which are guarded, and which are off-limits entirely.' },
  { icon: 'eye-off', title: 'Shadow AI inventory', format: 'Spreadsheet + narrative', body: 'Where consumer AI accounts are being used today and what code has been exposed. Actionable list, not accusations.' },
  { icon: 'shield-check', title: 'Privacy tier recommendation', format: 'Report section', body: 'The right tier for your IP sensitivity, with the reasoning your legal team will ask for.' },
  { icon: 'workflow', title: 'Implementation roadmap', format: '12-24 week milestone plan', body: 'A phased rollout ordered by payback, with dependencies and go/no-go checkpoints.' },
  { icon: 'gauge', title: 'Cost model', format: 'Spreadsheet', body: 'Setup, retainer, Anthropic seats, and token projections modeled against your team size and usage patterns.' },
  { icon: 'shield-alert', title: 'Risk register', format: 'Prioritized list', body: 'Every risk we surface: technical, IP, procurement, adoption. Prioritized with mitigations you can act on.' },
  { icon: 'clock', title: 'Recorded walkthrough', format: '60 min · video', body: 'Live walkthrough of the report with your team, recorded so anyone who missed it can review it later.' },
];

const resources = [
  { role: 'Executive sponsor', time: '1h kickoff + 1h readout', access: 'Signed mutual NDA' },
  { role: '1-2 tech leads', time: '4-6h of interviews', access: 'Read-only repo, ticket board, CI logs' },
  { role: 'IT / infra contact', time: '2h for tooling review', access: 'List of installed developer tools' },
];

const weekByWeek = [
  { week: 'Week 0', title: 'Prep', body: 'Mutual NDA signed, read-only access provisioned, pre-audit questionnaire completed by your team.' },
  { week: 'Week 1', title: 'Discovery', body: 'Kickoff call, tech-lead interviews, codebase walkthrough, workflow mapping.' },
  { week: 'Week 2', title: 'Analysis', body: 'Shadow AI scan, tooling assessment, IP sensitivity review, cost modeling.' },
  { week: 'Week 3', title: 'Delivery', body: 'Written report and all deliverables handed over, recorded walkthrough call, Q&A with your leads.' },
];

const notInScope = [
  'Building, configuring, or deploying anything (that is Setup)',
  'Team training beyond the walkthrough call (that comes with Setup, or standalone)',
  'Implementation of the roadmap or any code changes',
  'Custom software development',
  'Legal review or compliance certification (the Audit informs both, it does not replace them)',
];

const why = [
  { icon: 'shield-check', title: 'Reduces risk', body: 'You commit to Setup with a scoped plan, not a leap of faith. Every recommendation is grounded in your actual codebase.' },
  { icon: 'target', title: 'Decision-ready', body: 'The report gives leadership the numbers to approve or decline. ROI, cost, and risk in one place.' },
  { icon: 'file-text', title: 'Standalone value', body: 'You keep every deliverable regardless of whether you proceed. Useful even if you implement it yourself.' },
];
---
<ConsultingLayout
  title={title}
  description={description}
  path={`${BASE}/services/audit/`}
  active={`${BASE}/services`}
>
  <ConsultingHero
    eyebrow="AI Readiness Audit"
    title="Nine deliverables, one"
    accent="fixed-fee engagement."
    subtitle="Before you build anything, you get named, tangible artifacts your CTO, CFO, and legal team can each act on. No hourly billing, no open-ended discovery."
    primaryLabel="Book a call to scope your Audit"
    secondaryLabel="See the full process"
    secondaryHref={`${BASE}/approach`}
  />

  <!-- ── What it is ────────────────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-4xl mx-auto px-6">
      <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">What it is</p>
      <p data-fade data-fade-delay="60" class="text-[19px] md:text-[22px] text-text leading-[1.5] mb-10">
        A structured review of your codebase, workflows, and constraints, delivered as nine concrete artifacts. One to three weeks depending on studio size.
      </p>
      <div data-fade data-fade-delay="120" class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-border/60 border border-border/60 rounded-lg overflow-hidden">
        {facts.map(f => (
          <div class="bg-surface p-6">
            <p class="font-mono text-[11.5px] uppercase tracking-[0.12em] text-text-3 mb-2">{f.label}</p>
            <p class="text-[16px] text-text font-medium">{f.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── What we look at ───────────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">What we look at</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[38px] font-bold tracking-[-0.02em] leading-[1.1]">
          Six areas, one pass.
        </h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {lookAt.map((l, i) => (
          <div data-fade data-fade-delay={i * 60} class="p-7 rounded-lg border border-border bg-surface">
            <h3 class="text-[17px] font-semibold text-text mb-2.5 leading-snug">{l.title}</h3>
            <p class="text-[14.5px] text-text-2 leading-[1.6]">{l.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Deliverables ─────────────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Deliverables</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[38px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Nine named artifacts. All yours to keep.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] text-text-2 leading-[1.6]">
          Every deliverable ships in a format your team can act on. Nothing is verbal, nothing lives only in a slide deck.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {deliverables.map((d, i) => (
          <div data-fade data-fade-delay={i * 50} class="flex flex-col p-7 rounded-lg border border-border bg-surface">
            <div class="flex items-center justify-between mb-5">
              <div class="w-10 h-10 rounded-md bg-amber/10 border border-amber/25 flex items-center justify-center text-amber">
                <ConsultingIcon name={d.icon} size={19} />
              </div>
              <span class="font-mono text-[11.5px] text-text-3">{`0${i + 1}`.slice(-2)}</span>
            </div>
            <h3 class="text-[17px] font-semibold text-text mb-1.5 leading-snug">{d.title}</h3>
            <p class="font-mono text-[12px] text-amber mb-3">{d.format}</p>
            <p class="text-[14.5px] text-text-2 leading-[1.6]">{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── What we need from your team ──────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-5xl mx-auto px-6">
      <div class="max-w-3xl mb-12">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">What we need from your team</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[38px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Low load on your side.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] text-text-2 leading-[1.6]">
          Total commitment is under a person-week across three roles. No engineering work, no infrastructure changes.
        </p>
      </div>
      <div data-fade data-fade-delay="180" class="rounded-lg border border-border overflow-hidden">
        <div class="grid grid-cols-[1.1fr_1fr_1.4fr] gap-px bg-border/60">
          <div class="px-5 md:px-6 py-4 bg-surface/60 font-mono text-[11.5px] uppercase tracking-[0.12em] text-text-3">Role</div>
          <div class="px-5 md:px-6 py-4 bg-surface/60 font-mono text-[11.5px] uppercase tracking-[0.12em] text-text-3">Time</div>
          <div class="px-5 md:px-6 py-4 bg-surface/60 font-mono text-[11.5px] uppercase tracking-[0.12em] text-text-3">Access</div>
          {resources.map(r => (
            <>
              <div class="px-5 md:px-6 py-5 bg-ink text-[15px] font-medium text-text">{r.role}</div>
              <div class="px-5 md:px-6 py-5 bg-ink text-[14.5px] font-mono text-amber">{r.time}</div>
              <div class="px-5 md:px-6 py-5 bg-ink text-[14px] text-text-2">{r.access}</div>
            </>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Week by week ─────────────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Week by week</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[38px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          You always know what week we are in.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] text-text-2 leading-[1.6]">
          Standard cadence for a 3-week Audit. Smaller studios finish in 1-2 weeks, larger ones extend to 3.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
        {weekByWeek.map((w, i) => (
          <div data-fade data-fade-delay={i * 70} class="p-7 rounded-lg border border-border bg-surface">
            <span class="font-mono text-[12px] text-amber tracking-[0.1em] block mb-4">{w.week}</span>
            <h3 class="text-[18px] font-semibold text-text mb-3">{w.title}</h3>
            <p class="text-[14.5px] text-text-2 leading-[1.6]">{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Why start here ────────────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Why start here</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[38px] font-bold tracking-[-0.02em] leading-[1.1]">
          The Audit de-risks everything after it.
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        {why.map((w, i) => (
          <div data-fade data-fade-delay={i * 70} class="p-7 rounded-lg border border-border bg-surface">
            <div class="w-10 h-10 rounded-md bg-amber/10 border border-amber/25 flex items-center justify-center text-amber mb-5">
              <ConsultingIcon name={w.icon} size={19} />
            </div>
            <h3 class="text-[18px] font-semibold text-text mb-2.5">{w.title}</h3>
            <p class="text-[14.5px] text-text-2 leading-[1.6]">{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Not in scope ─────────────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-4xl mx-auto px-6">
      <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Not in scope</p>
      <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[38px] font-bold tracking-[-0.02em] leading-[1.1] mb-8">
        What the Audit is not.
      </h2>
      <ul class="border-t border-border/60">
        {notInScope.map((n, i) => (
          <li data-fade data-fade-delay={i * 40} class="flex items-start gap-4 py-5 border-b border-border/60">
            <span class="text-text-3 mt-0.5 flex-shrink-0"><ConsultingIcon name="x" size={17} class="stroke-[2.5]" /></span>
            <span class="text-[16px] text-text-2 leading-[1.6]">{n}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ConsultingCta
    title="Book a Discovery Call to scope your Audit."
    subtitle="We confirm your stack and constraints, then scope the Audit to your studio size. Fixed price agreed before any work starts."
    primaryLabel="Book Discovery Call"
    primaryHref={BOOK_PATH}
    secondaryLabel="Explore Setup & Integration"
    secondaryHref={`${BASE}/services/setup`}
  />
</ConsultingLayout>
