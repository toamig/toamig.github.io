---
import ConsultingLayout from '../../../layouts/ConsultingLayout.astro';
import ConsultingHero from '../../../components/ConsultingHero.astro';
import ConsultingCta from '../../../components/ConsultingCta.astro';
import ConsultingIcon from '../../../components/ConsultingIcon.astro';
import { BASE, SERVICES } from '../../../data/consulting';

const title = 'Services · AI Setup Consulting for Game Studios';
const description = 'AI Readiness Audit, Setup & Integration, and an Optimization Retainer for Unreal Engine studios. Fixed-fee, time-boxed, deliverable-based. Team training and MCP Perforce available.';

const addons = [
  {
    icon: 'graduation-cap',
    title: 'Team Training',
    meta: '2-5 days · standalone or included',
    body: 'Prompting patterns for performance-critical C++, code review of AI output, and safe team workflows on your real codebase. Included in Setup, or available on its own for studios that already have infrastructure in place.',
  },
  {
    icon: 'server',
    title: 'MCP Perforce License',
    meta: 'annual · standalone or bundled',
    body: 'A drop-in MCP server that lets Claude create, shelve, and submit Perforce changelists with your studio conventions and audit logs. Sold standalone or bundled with Setup.',
  },
];
---
<ConsultingLayout
  title={title}
  description={description}
  path={`${BASE}/services/`}
  active={`${BASE}/services`}
>
  <ConsultingHero
    eyebrow="Services"
    title="Four phases, three deep engagements."
    subtitle="Most studios start with an Audit, move into Setup, then keep us on a monthly Retainer. Each engagement is fixed-fee, time-boxed, and deliverable-based."
    secondaryLabel="See how we work"
    secondaryHref={`${BASE}/approach`}
  />

  <!-- ── Core services ─────────────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid md:grid-cols-3 gap-5">
        {SERVICES.map((s, i) => (
          <a href={s.href} data-fade data-fade-delay={i * 80} class="group flex flex-col p-8 rounded-lg border border-border bg-surface hover:border-border-2 hover:bg-surface-2 transition-all duration-200">
            <div class="flex items-center justify-between mb-6">
              <div class="w-11 h-11 rounded-md bg-amber/10 border border-amber/25 flex items-center justify-center text-amber">
                <ConsultingIcon name={s.icon} size={20} />
              </div>
              <span class="font-mono text-[12px] text-text-3">0{i + 1}</span>
            </div>
            <h2 class="text-[21px] font-semibold tracking-tight mb-3">{s.title}</h2>
            <div class="flex flex-wrap gap-x-4 gap-y-1 mb-5 font-mono text-[12.5px]">
              <span class="text-text-3">{s.duration}</span>
              <span class="text-border-2">·</span>
              <span class="text-amber">{s.cadence}</span>
            </div>
            <p class="text-[15px] text-text-2 leading-[1.65] mb-6">{s.blurb}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 text-[14px] font-medium text-text group-hover:text-amber transition-colors">
              Explore {s.title.split(' ')[0]}
              <ConsultingIcon name="arrow-right" size={14} class="stroke-[2.5] group-hover:translate-x-0.5 transition-transform" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Add-ons ───────────────────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Also available</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[38px] font-bold tracking-[-0.02em] leading-[1.1]">
          Standalone add-ons.
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-5">
        {addons.map((a, i) => (
          <div data-fade data-fade-delay={i * 80} class="flex flex-col p-8 rounded-lg border border-border bg-surface">
            <div class="w-11 h-11 rounded-md bg-amber/10 border border-amber/25 flex items-center justify-center text-amber mb-6">
              <ConsultingIcon name={a.icon} size={20} />
            </div>
            <h3 class="text-[20px] font-semibold tracking-tight mb-2">{a.title}</h3>
            <p class="font-mono text-[12.5px] text-text-3 mb-4">{a.meta}</p>
            <p class="text-[15px] text-text-2 leading-[1.65]">{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ConsultingCta
    title="Not sure where to start?"
    subtitle="Most engagements begin with a 30-minute Discovery Call. We confirm fit, your stack, and which service maps to your situation. If we are not the right call, we will say so."
    secondaryLabel="See our methodology"
    secondaryHref={`${BASE}/approach`}
  />
</ConsultingLayout>
