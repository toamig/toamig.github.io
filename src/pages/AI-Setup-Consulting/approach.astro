---
import ConsultingLayout from '../../layouts/ConsultingLayout.astro';
import ConsultingHero from '../../components/ConsultingHero.astro';
import ConsultingCta from '../../components/ConsultingCta.astro';
import ConsultingIcon from '../../components/ConsultingIcon.astro';
import {
  BASE, PHASES,
  SUCCESS_BASELINES, SUCCESS_THRESHOLDS, REPORTING_CADENCE,
  ENGAGEMENT_INCLUDES, ENGAGEMENT_EXCLUDES, ENGAGEMENT_REFERS,
} from '../../data/consulting';

const title = 'Approach & Methodology · AI Setup Consulting for Game Studios';
const description = 'How we work: outcome-based fixed-fee engagements, baseline metrics captured before implementation, defined success thresholds, and explicit engagement boundaries. The methodology behind every engagement.';

const philosophy = [
  { title: 'Outcomes, not hours',      body: 'We do not sell time. We sell fixed-fee engagements aligned with fixed deliverables. You know the price and the outcome before we start.' },
  { title: 'Measurement, end to end', body: 'We baseline before, re-measure during, and report after. The ROI is defensible when your CFO asks — grounded in your own baselines.' },
  { title: 'Governance-first',        body: 'Brain updates flow through PR review. Every layer runs human-in-the-loop. No developer silently breaks conventions. No autonomous code modification.' },
  { title: 'A multiplier, not a substitute', body: 'AI does not replace engineering judgment. It makes good engineers faster. Your seniors still make the architectural calls.' },
];

const escalation = [
  'Is the baseline still accurate, or have external factors changed?',
  'Are the pipeline layers configured optimally for actual workflows?',
  'Is there team adoption friction we need to address?',
  'Are there blockers outside the AI infrastructure we should surface?',
];

const staysWithYou = [
  'All code, configuration, infrastructure',
  'All documentation and runbooks',
  'The brain repository, hosted on your Git provider',
  'Your Anthropic account remains yours',
  'Zero vendor lock-in',
];
---
<ConsultingLayout
  title={title}
  description={description}
  path={`${BASE}/approach/`}
  active={`${BASE}/approach`}
>
  <ConsultingHero
    eyebrow="Approach"
    title="How we work, and why it"
    accent="earns a CTO's trust."
    subtitle="Fixed-fee engagements. Measured outcomes with named thresholds. Governance-first infrastructure. Explicit engagement boundaries. Nothing you cannot walk away with."
    secondaryLabel="See the services"
    secondaryHref={`${BASE}/services`}
  />

  <!-- ── Philosophy ────────────────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Philosophy</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1]">
          Four principles that shape everything.
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-5">
        {philosophy.map((p, i) => (
          <div data-fade data-fade-delay={i * 70} class="p-8 rounded-lg border border-border bg-surface">
            <span class="font-mono text-[11.5px] text-text-3 tracking-[0.14em]">0{i + 1}</span>
            <h3 class="text-[19px] font-semibold text-text mt-3 mb-3">{p.title}</h3>
            <p class="text-[15px] text-text-2 leading-[1.65]">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Engagement lifecycle ──────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40 bg-ink-2/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Engagement lifecycle</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1]">
          Discovery. Audit. Setup. Retainer.
        </h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
        {PHASES.map((p, i) => (
          <div data-fade data-fade-delay={i * 70} class="flex flex-col p-7 rounded-lg border border-border bg-surface">
            <div class="flex items-center justify-between mb-5">
              <span class="font-mono text-[13px] text-amber tracking-[0.1em]">STEP {p.step}</span>
              <span class="font-mono text-[11.5px] text-text-3">{p.meta}</span>
            </div>
            <h3 class="text-[18px] font-semibold tracking-tight mb-4">{p.title}</h3>
            <ul class="flex flex-col gap-2.5">
              {p.points.map(pt => (
                <li class="flex items-start gap-2.5 text-[13.5px] text-text-2 leading-[1.5]">
                  <span class="text-amber mt-0.5 flex-shrink-0"><ConsultingIcon name="check" size={13} class="stroke-[2.5]" /></span>
                  {pt}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Baselines we capture ──────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Baseline metrics</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Baseline before. Measure during. Report after.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] text-text-2 leading-[1.65]">
          Before implementation begins, we capture the metrics that will define success. If your CFO asks "what did we get for our investment," there is a written answer with numbers, not vibes.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-border/60 border border-border/60 rounded-lg overflow-hidden">
        {SUCCESS_BASELINES.map((b, i) => (
          <div data-fade data-fade-delay={i * 40} class="bg-surface p-6">
            <div class="text-amber mb-4"><ConsultingIcon name="gauge" size={18} /></div>
            <h3 class="text-[16px] font-semibold text-text mb-1.5">{b.title}</h3>
            <p class="text-[13.5px] text-text-2 leading-[1.55]">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Success thresholds ────────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40 bg-ink-2/40">
    <div class="max-w-5xl mx-auto px-6">
      <div class="max-w-3xl mb-12">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Success thresholds</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Named targets, with time bounds.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] text-text-2 leading-[1.6]">
          Thresholds are defined per engagement based on baselines and studio context. These are typical targets we agree to before we start.
        </p>
      </div>
      <div data-fade data-fade-delay="180" class="rounded-lg border border-border overflow-hidden">
        <div class="grid grid-cols-[2fr_1fr_1.4fr] gap-px bg-border/60">
          <div class="px-5 md:px-6 py-4 bg-surface/60 font-mono text-[11.5px] uppercase tracking-[0.12em] text-text-3">Metric</div>
          <div class="px-5 md:px-6 py-4 bg-surface/60 font-mono text-[11.5px] uppercase tracking-[0.12em] text-text-3">Target</div>
          <div class="px-5 md:px-6 py-4 bg-surface/60 font-mono text-[11.5px] uppercase tracking-[0.12em] text-text-3">Window</div>
          {SUCCESS_THRESHOLDS.map(t => (
            <>
              <div class="px-5 md:px-6 py-5 bg-ink text-[14.5px] text-text">{t.metric}</div>
              <div class="px-5 md:px-6 py-5 bg-ink text-[14.5px] font-mono text-amber">{t.target}</div>
              <div class="px-5 md:px-6 py-5 bg-ink text-[13.5px] text-text-2">{t.window}</div>
            </>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Reporting cadence + escalation ────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-5">
      <div data-fade class="p-8 rounded-lg border border-border bg-surface">
        <div class="w-10 h-10 rounded-md bg-amber/10 border border-amber/25 flex items-center justify-center text-amber mb-6">
          <ConsultingIcon name="clock" size={19} />
        </div>
        <h3 class="text-[20px] font-semibold tracking-tight mb-5">Reporting cadence</h3>
        <ul class="flex flex-col divide-y divide-border/60">
          {REPORTING_CADENCE.map(r => (
            <li class="grid grid-cols-[110px_1fr] gap-4 py-4 first:pt-0 last:pb-0">
              <span class="font-mono text-[13px] text-amber">{r.rhythm}</span>
              <span class="text-[14.5px] text-text-2 leading-[1.55]">{r.what}</span>
            </li>
          ))}
        </ul>
      </div>
      <div data-fade data-fade-delay="80" class="p-8 rounded-lg border border-border bg-surface">
        <div class="w-10 h-10 rounded-md bg-amber/10 border border-amber/25 flex items-center justify-center text-amber mb-6">
          <ConsultingIcon name="shield-alert" size={19} />
        </div>
        <h3 class="text-[20px] font-semibold tracking-tight mb-3">Escalation protocol</h3>
        <p class="text-[14.5px] text-text-2 leading-[1.6] mb-5">If targets are not being met, we investigate systematically. Adjustment happens through structured retrospective, not vague optimization.</p>
        <ul class="flex flex-col gap-3">
          {escalation.map(e => (
            <li class="flex items-start gap-3 text-[14px] text-text-2 leading-[1.55]">
              <span class="text-amber mt-0.5 flex-shrink-0"><ConsultingIcon name="check" size={14} class="stroke-[2.5]" /></span>
              {e}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Engagement boundaries ─────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40 bg-ink-2/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Engagement boundaries</p>
        <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Clear about what we do. Honest about what we don't.
        </h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-5 mb-5">
        <div data-fade class="p-8 rounded-lg border border-border bg-surface">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-md bg-amber/10 border border-amber/25 flex items-center justify-center text-amber">
              <ConsultingIcon name="check-circle" size={19} />
            </div>
            <h3 class="text-[19px] font-semibold">What this engagement includes</h3>
          </div>
          <ul class="flex flex-col gap-3">
            {ENGAGEMENT_INCLUDES.map(i => (
              <li class="flex items-start gap-3 text-[14.5px] text-text-2 leading-[1.55]">
                <span class="text-amber mt-0.5 flex-shrink-0"><ConsultingIcon name="check" size={15} class="stroke-[2.5]" /></span>
                {i}
              </li>
            ))}
          </ul>
        </div>
        <div data-fade data-fade-delay="80" class="p-8 rounded-lg border border-border bg-surface">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-md bg-border-2/40 border border-border-2/60 flex items-center justify-center text-text-3">
              <ConsultingIcon name="x-circle" size={19} />
            </div>
            <h3 class="text-[19px] font-semibold">What this engagement does not include</h3>
          </div>
          <ul class="flex flex-col gap-4">
            {ENGAGEMENT_EXCLUDES.map(e => (
              <li class="grid grid-cols-[16px_1fr] gap-3">
                <span class="text-text-3 mt-0.5"><ConsultingIcon name="x" size={14} class="stroke-[2.5]" /></span>
                <div>
                  <p class="text-[14.5px] text-text font-medium">{e.title}</p>
                  <p class="text-[13.5px] text-text-2 leading-[1.5] mt-0.5">{e.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div data-fade class="p-7 rounded-lg border border-border bg-surface">
        <div class="flex items-baseline gap-3 mb-4">
          <ConsultingIcon name="arrow-up-right" size={17} class="text-amber" />
          <h3 class="text-[18px] font-semibold">When we refer elsewhere</h3>
        </div>
        <p class="text-[14.5px] text-text-2 leading-[1.6] mb-5">
          We refer to specialist consultants when the need falls outside our scope. Our scope is defined, deep, and honest. If we are not the right fit, we say so.
        </p>
        <div class="flex flex-wrap gap-2">
          {ENGAGEMENT_REFERS.map(r => (
            <span class="px-3 py-1.5 rounded-md border border-border bg-ink font-mono text-[12.5px] text-text-2">{r}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── What stays with you ───────────────────────────────── -->
  <section class="py-20 md:py-28 border-b border-border/40">
    <div class="max-w-4xl mx-auto px-6">
      <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">What stays with you</p>
      <h2 data-fade data-fade-delay="60" class="text-[30px] md:text-[40px] font-bold tracking-[-0.02em] leading-[1.1] mb-6">
        Zero vendor lock-in. Everything is yours.
      </h2>
      <p data-fade data-fade-delay="120" class="text-[16.5px] text-text-2 leading-[1.7] mb-8">
        Every artifact ships to your infrastructure and stays there. If you walk away, you walk away with a working system, documentation your team can operate, and an Anthropic account that was always yours.
      </p>
      <ul class="flex flex-col gap-3.5 max-w-2xl">
        {staysWithYou.map(s => (
          <li data-fade class="flex items-start gap-3 text-[15px] text-text-2 leading-[1.55]">
            <span class="text-amber mt-0.5 flex-shrink-0"><ConsultingIcon name="check" size={16} class="stroke-[2.5]" /></span>
            {s}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ConsultingCta
    title="Want to walk through the method?"
    subtitle="A Discovery Call is the fastest way to see how this maps to your studio. 30 minutes, free, no pitch deck."
  />
</ConsultingLayout>
