---
import ConsultingLayout from '../../layouts/ConsultingLayout.astro';
import ConsultingIcon from '../../components/ConsultingIcon.astro';
import {
  SITE, BRAND, EMAIL, LINKEDIN_URL, BASE, BOOK_PATH,
  STACK, BUILD_CARDS, SEGMENTS, PHASES,
} from '../../data/consulting';

const title = 'AI engineering infrastructure for Unreal game studios · Miguel Vieira';
const description = 'Centrally governed, measurably faster AI workflows for Unreal Engine teams. Built by engineers who ship games, with guardrails for C++, Perforce, and proprietary IP.';

const pains = [
  {
    icon: 'eye-off',
    title: 'Shadow AI is already in your studio',
    body: 'Developers are using consumer AI accounts on proprietary code right now. Consumer accounts retain data for up to 5 years and may use it for training. Most studios have no visibility into this. Most legal teams would object if they knew.',
  },
  {
    icon: 'git-branch',
    title: 'AI without guardrails creates technical debt',
    body: 'Ad-hoc AI adoption produces code that does not respect your conventions, your gameplay framework, or your architectural decisions. The cleanup cost often exceeds the productivity gains.',
  },
  {
    icon: 'users',
    title: 'Senior time is being wasted',
    body: 'Tech leads spend 15-25% of their week on code review, and most of that time catches convention violations that could be caught at write-time. AI properly integrated recovers that time.',
  },
];

const credibility = [
  'Custom MCP servers for Perforce, Plastic SCM, and internal tooling',
  'Governance-first brain repos with branch protection, CI validation, and controlled updates',
  'Prompt caching optimization to keep API costs viable at scale',
  'Four-tier privacy framework aligned with Anthropic commercial terms and enterprise agreements',
  'Integration with Perforce triggers, CI hooks, Swarm, Jira, and Slack for event-driven automation',
  'Compliance architecture including Zero Data Retention, AWS Bedrock, and Google Vertex AI deployment paths',
];

const notThis = [
  'Not a chatbot subscription. Not a plugin. Not something you install and forget.',
  'Not a replacement for engineering judgment. Your seniors still make architectural calls.',
  'Not a promise of code generation. AI accelerates good engineers; it does not replace them.',
  'Not vendor lock-in. Deliverables remain your IP. You can walk away with everything we built.',
  'Not a one-time setup. Real value comes from continuous evolution as your codebase and Claude both change.',
  'Not generic AI consulting. We only work with game studios.',
];

const faqs = [
  {
    q: 'How is this different from just using Claude Code with our team?',
    a: 'Claude Code out of the box is a great tool for individual developers. It does not come with your studio conventions, does not enforce architectural rules, does not integrate with Perforce safely, and does not provide governance. We build the infrastructure that makes AI reliable at team scale.',
  },
  {
    q: 'What is the smallest studio you work with?',
    a: 'We start at around 10 developers. Below that, the investment does not pay back within a reasonable window. Indie teams can often achieve enough value with off-the-shelf tools and public documentation.',
  },
  {
    q: 'Do you replace our seniors or reduce our hiring needs?',
    a: 'No. AI properly integrated makes your existing team more effective. It does not replace senior judgment on architecture or design. Studios that treat this as "we can hire less" usually get worse outcomes than studios that treat it as "our seniors focus on higher-value work".',
  },
  {
    q: 'How do you handle our proprietary code and IP?',
    a: 'Four privacy tiers are available. We recommend the appropriate one during the Audit based on your IP sensitivity, compliance requirements, and infrastructure preferences. Zero Data Retention agreements and AWS Bedrock or Google Vertex AI deployments are common for studios with strict IP concerns.',
  },
  {
    q: 'How is pricing structured?',
    a: 'Fixed-fee for Audit and Setup phases, scoped in advance, no hourly billing. Monthly retainer for ongoing optimization. Anthropic seats and API tokens are paid directly by the studio to Anthropic; we do not mark up their pricing. Full details are discussed during the Discovery Call.',
  },
  {
    q: 'What if we already use ChatGPT or GitHub Copilot?',
    a: 'We can work alongside existing tools or replace them where appropriate. Most studios end up with a stack: Claude for engineering work, other tools for specific niches. The Audit identifies what is working and what should change.',
  },
  {
    q: 'Do you offer training only, without full setup?',
    a: 'Team training is available as a standalone service, 2 to 5 days depending on team size. It is less impactful than a full engagement but useful for studios that already have infrastructure in place and just need their team to use it effectively.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: BRAND,
      url: SITE,
      sameAs: [LINKEDIN_URL],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        email: EMAIL,
      },
    },
    {
      '@type': 'Service',
      name: 'AI engineering infrastructure for game studios',
      provider: { '@id': `${SITE}/#organization` },
      serviceType: 'AI adoption, tooling, and governance for game engineering',
      areaServed: 'EU, UK, Nordic countries',
      audience: {
        '@type': 'Audience',
        audienceType: 'Game studios using Unreal Engine 4/5',
      },
      url: `${SITE}${BASE}/`,
    },
  ],
};
---
<ConsultingLayout
  title={title}
  description={description}
  path={`${BASE}/`}
  jsonLd={jsonLd}
>
  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="hero-grid pt-32 pb-24 md:pt-44 md:pb-32 border-b border-border/40">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <div data-fade class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border bg-surface text-text-2 text-[12px] font-mono mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-amber"></span>
        For studios using Unreal 4/5, C++, Perforce
      </div>

      <h1 data-fade data-fade-delay="80" class="text-[40px] md:text-[62px] lg:text-[72px] font-bold tracking-[-0.03em] leading-[1.03] mb-6">
        AI engineering infrastructure<br class="hidden md:block" />
        <span class="text-amber">for Unreal game studios.</span>
      </h1>

      <p data-fade data-fade-delay="160" class="text-[18px] md:text-[21px] text-text-2 leading-[1.5] max-w-2xl mx-auto mb-10">
        Centrally governed, measurably faster, built by engineers who ship games.
      </p>

      <div data-fade data-fade-delay="240" class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href={BOOK_PATH} class="inline-flex items-center gap-2 px-6 py-3 rounded-md bg-amber text-ink font-semibold text-[15px] hover:bg-amber-2 transition-colors">
          Book Discovery Call
          <ConsultingIcon name="arrow-right" size={16} class="stroke-[2.5]" />
        </a>
        <a href={`${BASE}/technology`} class="inline-flex items-center gap-2 px-6 py-3 rounded-md border border-border text-text hover:border-border-2 hover:bg-surface text-[15px] font-medium transition-colors">
          Read the technical brief
        </a>
      </div>

      <div data-fade data-fade-delay="320" class="mt-14">
        <p class="text-[11.5px] font-mono uppercase tracking-[0.16em] text-text-3 mb-4">Built on and integrated with</p>
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
          {STACK.map(s => (
            <span class="font-mono text-[14px] text-text-2">{s}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── The Problem ─────────────────────────────────────────── -->
  <section id="problem" class="py-24 md:py-32 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-16">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">The problem</p>
        <h2 data-fade data-fade-delay="60" class="text-[34px] md:text-[44px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Your team is already using AI. Nobody owns how.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[17px] text-text-2 leading-[1.6]">
          The friction is rarely technical genius. It is governance, integration, and measurement that nobody has time to own.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-px bg-border/60 border border-border/60 rounded-lg overflow-hidden">
        {pains.map((p, i) => (
          <div data-fade data-fade-delay={i * 80} class="bg-ink p-7 lg:p-9 hover:bg-surface/80 transition-colors">
            <div class="w-9 h-9 rounded-md bg-amber/10 border border-amber/20 flex items-center justify-center mb-5 text-amber">
              <ConsultingIcon name={p.icon} size={18} />
            </div>
            <h3 class="text-[18px] font-semibold text-text mb-3 leading-snug">{p.title}</h3>
            <p class="text-[15px] text-text-2 leading-[1.65]">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── What We Build ─────────────────────────────────────────── -->
  <section id="build" class="py-24 md:py-32 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-16">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">What we build</p>
        <h2 data-fade data-fade-delay="60" class="text-[34px] md:text-[44px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Infrastructure, not chatbots.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[17px] text-text-2 leading-[1.6]">
          Four systems that make AI reliable at team scale. Each one is governed, observable, and yours to keep.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        {BUILD_CARDS.map((c, i) => (
          <div data-fade data-fade-delay={i * 80} class="group p-8 rounded-lg border border-border bg-surface hover:border-border-2 hover:bg-surface-2 transition-all duration-200">
            <div class="w-11 h-11 rounded-md bg-amber/10 border border-amber/25 flex items-center justify-center text-amber mb-6">
              <ConsultingIcon name={c.icon} size={20} />
            </div>
            <h3 class="text-[20px] font-semibold tracking-tight mb-3">{c.title}</h3>
            <p class="text-[15px] text-text-2 leading-[1.65] mb-5">{c.body}</p>
            <a href={`${BASE}/technology`} class="inline-flex items-center gap-1.5 text-[14px] font-medium text-text hover:text-amber transition-colors">
              Learn more
              <ConsultingIcon name="arrow-right" size={14} class="stroke-[2.5] group-hover:translate-x-0.5 transition-transform" />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Auto-Segmentation ─────────────────────────────────────── -->
  <section id="segments" class="py-24 md:py-32 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-16">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Find your fit</p>
        <h2 data-fade data-fade-delay="60" class="text-[34px] md:text-[44px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Needs scale with team size and IP sensitivity.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[17px] text-text-2 leading-[1.6]">
          Start with the profile that matches yours.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-5">
        {SEGMENTS.map((s, i) => (
          <a
            href={s.href}
            data-fade
            data-fade-delay={i * 80}
            class:list={[
              'group relative flex flex-col p-8 rounded-lg border bg-surface hover:bg-surface-2 transition-all duration-200',
              s.badge ? 'border-amber/40 hover:border-amber/60' : 'border-border hover:border-border-2',
            ]}
          >
            {s.badge && (
              <span class="absolute -top-3 left-8 px-3 py-1 rounded-full bg-amber text-ink text-[11px] font-mono font-semibold uppercase tracking-[0.08em]">
                {s.badge}
              </span>
            )}
            <div class="w-11 h-11 rounded-md bg-amber/10 border border-amber/25 flex items-center justify-center text-amber mb-6">
              <ConsultingIcon name={s.icon} size={20} />
            </div>
            <h3 class="text-[21px] font-semibold tracking-tight mb-1">{s.title}</h3>
            <p class="font-mono text-[13px] text-amber mb-3">{s.size}</p>
            <p class="text-[15px] text-text-2 leading-[1.6] mb-6">{s.tagline}</p>
            <ul class="flex flex-col gap-2 mb-7">
              {s.benefits.map(b => (
                <li class="flex items-start gap-2.5 text-[14px] text-text-2">
                  <span class="text-amber mt-0.5 flex-shrink-0"><ConsultingIcon name="check" size={15} class="stroke-[2.5]" /></span>
                  {b}
                </li>
              ))}
            </ul>
            <span class="mt-auto inline-flex items-center gap-1.5 text-[14px] font-medium text-text group-hover:text-amber transition-colors">
              {s.cta}
              <ConsultingIcon name="arrow-right" size={14} class="stroke-[2.5] group-hover:translate-x-0.5 transition-transform" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── How This Works ─────────────────────────────────────────── -->
  <section id="process" class="py-24 md:py-32 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-16">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">How this works</p>
        <h2 data-fade data-fade-delay="60" class="text-[34px] md:text-[44px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Four phases. Time-boxed. Deliverable-based.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[17px] text-text-2 leading-[1.6]">
          A predictable process. No open-ended retainers to start. No "we will figure it out".
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
        {PHASES.map((p, i) => (
          <div data-fade data-fade-delay={i * 70} class="flex flex-col p-7 rounded-lg border border-border bg-surface">
            <div class="flex items-center justify-between mb-5">
              <span class="font-mono text-[13px] text-amber tracking-[0.1em]">STEP {p.step}</span>
              <span class="font-mono text-[11.5px] text-text-3">{p.meta}</span>
            </div>
            <h3 class="text-[19px] font-semibold tracking-tight mb-4">{p.title}</h3>
            <ul class="flex flex-col gap-2.5">
              {p.points.map(pt => (
                <li class="flex items-start gap-2.5 text-[14px] text-text-2 leading-[1.55]">
                  <span class="text-amber mt-0.5 flex-shrink-0"><ConsultingIcon name="check" size={14} class="stroke-[2.5]" /></span>
                  {pt}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div data-fade class="mt-12 text-center">
        <a href={BOOK_PATH} class="inline-flex items-center gap-2 text-[15px] font-medium text-text hover:text-amber transition-colors">
          Start with a Discovery Call
          <ConsultingIcon name="arrow-right" size={15} class="stroke-[2.5]" />
        </a>
      </div>
    </div>
  </section>

  <!-- ── Technical Credibility ─────────────────────────────────── -->
  <section id="credibility" class="py-24 md:py-32 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-[1fr_1.1fr] gap-12 lg:gap-16 items-start">
        <div>
          <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Technical credibility</p>
          <h2 data-fade data-fade-delay="60" class="text-[34px] md:text-[42px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
            Built by engineers who ship games.
          </h2>
          <p data-fade data-fade-delay="120" class="text-[17px] text-text-2 leading-[1.65] mb-6">
            Not general AI consultants. Our practice is built on hands-on experience with Unreal Engine 5, C++ gameplay engineering, Perforce workflows at scale, and the specific realities of shipping games. Not adapting generic AI consulting frameworks to a market we do not know.
          </p>
          <a data-fade data-fade-delay="180" href={`${BASE}/technology`} class="inline-flex items-center gap-2 text-[15px] font-medium text-text hover:text-amber transition-colors">
            Read the technical brief
            <ConsultingIcon name="arrow-right" size={15} class="stroke-[2.5]" />
          </a>
        </div>

        <div data-fade data-fade-delay="120" class="rounded-lg border border-border bg-surface p-7 md:p-9">
          <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-text-3 mb-6">Technical capabilities</p>
          <ul class="flex flex-col gap-4">
            {credibility.map(c => (
              <li class="flex items-start gap-3 text-[15px] text-text-2 leading-[1.55]">
                <span class="text-amber mt-0.5 flex-shrink-0"><ConsultingIcon name="check" size={16} class="stroke-[2.5]" /></span>
                {c}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── What This Is Not ─────────────────────────────────────── -->
  <section id="not" class="py-24 md:py-32 border-b border-border/40">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">What this is not</p>
        <h2 data-fade data-fade-delay="60" class="text-[34px] md:text-[44px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Setting realistic expectations upfront.
        </h2>
      </div>
      <ul class="border-t border-border/60">
        {notThis.map((n, i) => (
          <li data-fade data-fade-delay={i * 40} class="flex items-start gap-4 py-5 border-b border-border/60">
            <span class="text-text-3 mt-0.5 flex-shrink-0"><ConsultingIcon name="x" size={17} class="stroke-[2.5]" /></span>
            <span class="text-[16px] text-text-2 leading-[1.6]">{n}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── FAQ ─────────────────────────────────────────────── -->
  <section id="faq" class="py-24 md:py-32 border-b border-border/40">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-12 md:mb-16">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">FAQ</p>
        <h2 data-fade data-fade-delay="60" class="text-[34px] md:text-[44px] font-bold tracking-[-0.02em] leading-[1.1]">
          Common questions.
        </h2>
      </div>

      <div class="border-t border-border/60">
        {faqs.map((f) => (
          <details data-faq class="group border-b border-border/60">
            <summary class="flex items-start justify-between gap-6 py-6 md:py-7">
              <span class="text-[16.5px] md:text-[18px] font-medium text-text leading-snug">{f.q}</span>
              <span class="chevron flex-shrink-0 mt-1 text-text-3 group-hover:text-amber transition-colors">
                <ConsultingIcon name="chevron-down" size={18} />
              </span>
            </summary>
            <div class="answer pb-6 md:pb-7 max-w-3xl">
              <p class="text-[15.5px] text-text-2 leading-[1.7]">{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Final CTA ─────────────────────────────────────────── -->
  <section id="contact" class="py-28 md:py-40">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 data-fade class="text-[32px] md:text-[46px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
        Ready to see if this fits your studio?
      </h2>
      <p data-fade data-fade-delay="100" class="text-[17px] md:text-[18px] text-text-2 leading-[1.6] mb-10 max-w-2xl mx-auto">
        Discovery calls are 30 minutes, free, and end with a clear answer: either we are a fit or we are not. No pitch decks.
      </p>
      <div data-fade data-fade-delay="200" class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-6">
        <a href={BOOK_PATH} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-md bg-amber text-ink font-semibold text-[15px] hover:bg-amber-2 transition-colors">
          Book Discovery Call
          <ConsultingIcon name="arrow-right" size={16} class="stroke-[2.5]" />
        </a>
        <a href={`mailto:${EMAIL}`} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-md border border-border text-text hover:border-border-2 hover:bg-surface text-[15px] font-medium transition-colors">
          <ConsultingIcon name="mail" size={16} />
          {EMAIL}
        </a>
      </div>
      <p data-fade data-fade-delay="280" class="text-[13px] text-text-3 font-mono">
        Or read the technical brief first.
      </p>
    </div>
  </section>
</ConsultingLayout>
