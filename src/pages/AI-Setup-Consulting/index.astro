---
import ConsultingLayout from '../../layouts/ConsultingLayout.astro';
import ConsultingIcon from '../../components/ConsultingIcon.astro';
import PipelineDiagram from '../../components/PipelineDiagram.astro';
import GsapEffects from '../../components/GsapEffects.astro';
import {
  SITE, BRAND, EMAIL, LINKEDIN_URL, BASE, BOOK_PATH,
  STACK, HERO, PROBLEMS, PROBLEM_PATTERN,
  SOLUTION_INTRO,
  PIPELINE, PIPELINE_PRINCIPLE,
  TYPICAL_DAY, TYPICAL_DAY_TAKEAWAY,
  DELIVERABLE_EXAMPLES, DELIVERABLES_INTRO,
  ENGAGEMENT_FLOW,
  SEGMENTS, DIFFERENTIATORS,
} from '../../data/consulting';

const title = 'AI infrastructure engineered for game studios · Miguel Vieira';
const description = HERO.lede;

const faqs = [
  {
    q: 'Does this lock us into a specific AI vendor?',
    a: 'No. Everything is model-agnostic by design. We work with whichever AI stack you prefer — Claude, GPT, Gemini, or open-weight models via Bedrock, Vertex, Azure OpenAI, or self-hosted. We advise on the trade-offs during the Audit; the choice is yours. MCP is an open standard, not a vendor product.',
  },
  {
    q: 'How is this different from just installing an AI coding assistant?',
    a: 'An AI coding assistant out of the box is a great tool for individual developers. It does not come with your studio conventions, does not enforce architectural rules, does not integrate with Perforce safely at team scale, does not provide governance for shared knowledge, and does not compose multiple tools into pipelines. We build the infrastructure that makes AI reliable at team scale — the part that is not in the tool itself.',
  },
  {
    q: 'Can our internal team build this after seeing your setup?',
    a: 'Parts of it, yes. Setting up a Git repo with markdown files is not hard. Configuring the official Perforce MCP server is documented. Writing linters is standard engineering work. What is harder: designing the right layer separation without redundancy, calibrating each layer to avoid alert fatigue, integrating systems without brittle glue, establishing governance that survives team changes, measuring outcomes honestly, and evolving as your chosen AI vendor ships new capabilities. Studios that try to build this internally typically spend 6-12 months and multiple iterations.',
  },
  {
    q: 'How do you handle proprietary code and IP?',
    a: 'Through four privacy tiers spanning SaaS with commercial terms, API with zero-retention addendum, model hosted in your cloud (Bedrock / Vertex / Azure OpenAI), and self-hosted open-weight models behind MCP tunnels. Tier recommendation is made during the Audit based on your IP sensitivity, compliance requirements, and infrastructure preferences.',
  },
  {
    q: 'What is the pricing structure?',
    a: 'Fixed-fee for Audit and Build phases, scoped in advance, no hourly billing. Optional monthly Support afterwards. AI vendor seats and API tokens are paid directly by your studio to whichever vendor you use; we do not mark up their pricing. Full details discussed during the Discovery Call and detailed in the written proposal after the Audit.',
  },
  {
    q: 'Do you replace our senior engineers?',
    a: 'No. AI properly integrated makes your existing team more effective. It does not replace senior judgment on architecture or design. Studios that treat this as "we can hire less" typically get worse outcomes than studios that treat it as "our seniors focus on higher-value work."',
  },
  {
    q: 'What about the AI making mistakes?',
    a: 'It will. Every layer is designed with this expectation. Human review is mandatory for all code changes. AI proposes, engineers decide. The measurement framework tracks whether AI-assisted work quality is improving or degrading, and we adjust when issues appear. Autonomous code modification is not a feature we ship, regardless of client requests.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: BRAND,
      url: SITE,
      sameAs: [LINKEDIN_URL],
      contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: EMAIL },
    },
    {
      '@type': 'Service',
      name: 'AI engineering infrastructure for game studios',
      provider: { '@id': `${SITE}/#organization` },
      serviceType: 'Model-agnostic AI adoption, governance, and pipeline engineering for game studios',
      areaServed: 'EU, UK, Nordic countries',
      audience: { '@type': 'Audience', audienceType: 'Game studios using Unreal Engine 4/5' },
      url: `${SITE}${BASE}/`,
    },
  ],
};
---
<ConsultingLayout
  title={title}
  description={description}
  path={`${BASE}/`}
  jsonLd={jsonLd}
>
  <GsapEffects />

  <!-- ══ HERO ══════════════════════════════════════════════════════════ -->
  <section class="hero-grid pt-32 pb-32 md:pt-44 md:pb-40 relative overflow-hidden">
    <div data-anim="hero-parallax" class="absolute inset-0 pointer-events-none opacity-70"
         style="background: radial-gradient(ellipse 55% 45% at 50% 10%, rgba(184, 74, 43, 0.10), transparent 65%);">
    </div>
    <div class="relative max-w-5xl mx-auto px-6">
      <div data-fade class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border bg-surface/70 text-text-2 text-[12px] font-mono mb-10 backdrop-blur-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-amber"></span>
        Model-agnostic · Unreal 4/5 · C++ · Perforce
      </div>

      <h1 data-fade data-fade-delay="80" class="font-display text-[46px] md:text-[68px] lg:text-[80px] font-normal leading-[1.02] tracking-[-0.03em] mb-10 max-w-4xl">
        AI infrastructure <em class="not-italic text-amber font-medium">engineered for game studios.</em>
      </h1>

      <p data-fade data-fade-delay="160" class="text-[19px] md:text-[22px] text-text leading-[1.5] max-w-3xl mb-4 font-normal">
        {HERO.lede}
      </p>
      <p data-fade data-fade-delay="220" class="text-[16px] md:text-[17px] text-text-2 leading-[1.6] max-w-3xl mb-14 italic font-display">
        {HERO.clarifier}
      </p>

      <div data-fade data-fade-delay="300" class="flex flex-col sm:flex-row items-start sm:items-center gap-4 mb-16">
        <a href={BOOK_PATH} class="inline-flex items-center gap-2 px-6 py-3.5 rounded-md bg-text text-ink font-semibold text-[15px] hover:bg-text-2 transition-colors">
          Book Discovery Call
          <ConsultingIcon name="arrow-right" size={16} class="stroke-[2.5]" />
        </a>
        <a href="#pipeline" data-scroll class="inline-flex items-center gap-2 text-text hover:text-amber text-[15px] font-medium transition-colors">
          See how it works
          <ConsultingIcon name="arrow-down" size={16} class="stroke-[2.5]" />
        </a>
      </div>

      <div data-fade data-fade-delay="380" class="pt-8 border-t border-border/60">
        <p class="text-[11px] font-mono uppercase tracking-[0.18em] text-text-3 mb-3">Built on and integrated with</p>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {STACK.map(s => (
            <span class="font-mono text-[13.5px] text-text-2">{s}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══ 01 · THE PROBLEM ══════════════════════════════════════════════ -->
  <section id="problem" class="py-28 md:py-40 border-t border-border/50">
    <div class="max-w-5xl mx-auto px-6">
      <header class="mb-16 md:mb-20 max-w-3xl">
        <p data-fade class="font-mono text-[11.5px] uppercase tracking-[0.2em] text-amber mb-6">01 · The problem</p>
        <h2 data-fade data-fade-delay="60" class="font-display text-[34px] md:text-[48px] leading-[1.08] font-normal tracking-[-0.02em]">
          Adding AI without infrastructure creates more problems than it solves.
        </h2>
      </header>

      <div class="max-w-3xl space-y-14 md:space-y-16">
        {PROBLEMS.map((p, i) => (
          <article data-fade data-fade-delay={i * 80} class="grid grid-cols-[48px_1fr] md:grid-cols-[64px_1fr] gap-6 md:gap-8">
            <div class="pt-2">
              <span class="font-display italic text-[26px] md:text-[32px] text-amber leading-none">{['I','II','III'][i]}</span>
            </div>
            <div>
              <h3 class="font-display text-[22px] md:text-[26px] font-medium leading-[1.25] mb-3 text-text">{p.title}</h3>
              <p class="text-[16px] md:text-[17px] text-text-2 leading-[1.7]">{p.body}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-20 md:mt-24 max-w-3xl">
        <div class="editorial-rule mb-8"></div>
        <p data-fade class="font-display italic text-[19px] md:text-[22px] text-text leading-[1.55]">
          {PROBLEM_PATTERN}
        </p>
      </div>
    </div>
  </section>

  <!-- ══ 02 · THE SOLUTION ═════════════════════════════════════════════ -->
  <section id="pipeline" class="py-28 md:py-40 border-t border-border/50 bg-ink-2/50">
    <div class="max-w-6xl mx-auto px-6">
      <header class="mb-16 md:mb-20 max-w-3xl">
        <p data-fade class="font-mono text-[11.5px] uppercase tracking-[0.2em] text-amber mb-6">02 · Our solution</p>
        <h2 data-fade data-fade-delay="60" class="font-display text-[34px] md:text-[48px] leading-[1.08] font-normal tracking-[-0.02em] mb-8">
          A layered pipeline of specialized checkpoints.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[17px] md:text-[19px] text-text-2 leading-[1.65] mb-5">
          {SOLUTION_INTRO}
        </p>
        <p data-fade data-fade-delay="180" class="text-[16px] text-text-2 leading-[1.65]">
          Each of five layers has a specific responsibility, a specific audience, and runs at a specific moment in the development lifecycle. Layers reinforce each other rather than repeat each other — no redundant checks, no alert fatigue, no wasted tokens.
        </p>
        <p data-fade data-fade-delay="240" class="hidden md:block mt-6 text-[13px] text-text-3 font-mono">
          <span class="text-amber">↓</span> Hover a layer to reveal its metadata
        </p>
      </header>

      <PipelineDiagram layers={PIPELINE} />

      <div data-fade class="mt-16 md:mt-20 max-w-3xl mx-auto">
        <div class="editorial-rule mb-8"></div>
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-amber mb-3">Human in the loop, always</p>
        <p class="text-[16px] md:text-[17px] text-text leading-[1.7]">{PIPELINE_PRINCIPLE}</p>
      </div>
    </div>
  </section>

  <!-- ══ 03 · IN PRACTICE — A TYPICAL DAY ══════════════════════════════ -->
  <section id="day" class="py-28 md:py-40 border-t border-border/50">
    <div class="max-w-5xl mx-auto px-6">
      <header class="mb-16 md:mb-20 max-w-3xl">
        <p data-fade class="font-mono text-[11.5px] uppercase tracking-[0.2em] text-amber mb-6">03 · In practice</p>
        <h2 data-fade data-fade-delay="60" class="font-display text-[34px] md:text-[48px] leading-[1.08] font-normal tracking-[-0.02em] mb-8">
          What the pipeline looks like on a Tuesday.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[17px] md:text-[19px] text-text-2 leading-[1.65]">
          One gameplay engineer. One damage-over-time ability. One day. Every layer earns its place without the developer noticing.
        </p>
      </header>

      <ol class="relative max-w-4xl">
        <div class="absolute left-[68px] md:left-[132px] top-2 bottom-2 w-px bg-border" aria-hidden="true"></div>
        {TYPICAL_DAY.map((e, i) => (
          <li data-anim="day-entry" class="day-entry relative grid grid-cols-[88px_1fr] md:grid-cols-[152px_1fr] gap-6 md:gap-12 pb-12 last:pb-0">
            <div class="flex flex-col items-end pt-1">
              <span class="font-mono text-[13.5px] text-text tracking-[0.02em]">{e.time}</span>
              <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-text-3 mt-1.5">{e.actor}</span>
            </div>
            <div class="relative pl-8 pt-1">
              <span class="timeline-dot absolute left-0 top-2 w-3 h-3 rounded-full border-2 border-border-2 bg-ink transition-all duration-300"></span>
              <p class="text-[16px] md:text-[17px] text-text-2 leading-[1.7]">{e.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="mt-16 max-w-3xl">
        <div class="editorial-rule mb-8"></div>
        <p data-fade class="font-display italic text-[19px] md:text-[22px] text-text leading-[1.55]">
          {TYPICAL_DAY_TAKEAWAY}
        </p>
      </div>
    </div>
  </section>

  <!-- ══ 04 · WHAT WE DELIVER ══════════════════════════════════════════ -->
  <section id="deliverables" class="py-28 md:py-40 border-t border-border/50 bg-ink-2/50">
    <div class="max-w-5xl mx-auto px-6">
      <header class="mb-14 md:mb-16 max-w-3xl">
        <p data-fade class="font-mono text-[11.5px] uppercase tracking-[0.2em] text-amber mb-6">04 · What we deliver</p>
        <h2 data-fade data-fade-delay="60" class="font-display text-[34px] md:text-[48px] leading-[1.08] font-normal tracking-[-0.02em] mb-8">
          Custom deliverables. Scoped per engagement.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[17px] md:text-[19px] text-text-2 leading-[1.65]">
          {DELIVERABLES_INTRO}
        </p>
      </header>

      <div class="grid md:grid-cols-2 gap-x-12 md:gap-x-16 gap-y-12 md:gap-y-14 max-w-4xl">
        {DELIVERABLE_EXAMPLES.map((d, i) => (
          <article data-fade data-fade-delay={i * 50} class="flex gap-5">
            <div class="flex-shrink-0 w-11 h-11 rounded-md border border-border bg-surface flex items-center justify-center text-amber mt-0.5">
              <ConsultingIcon name={d.icon} size={20} />
            </div>
            <div>
              <h3 class="font-display text-[19px] md:text-[21px] font-medium text-text mb-2 leading-[1.3]">{d.title}</h3>
              <p class="text-[15px] md:text-[15.5px] text-text-2 leading-[1.65]">{d.body}</p>
            </div>
          </article>
        ))}
      </div>

      <div data-fade class="mt-16 max-w-3xl p-6 md:p-7 border-l-2 border-amber bg-surface/70">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-amber mb-3">A note on price</p>
        <p class="text-[15.5px] text-text leading-[1.65]">
          Every engagement is scoped and priced in the proposal after a short Audit — never in a menu. Fixed-fee for Audit and Build. Optional monthly Support afterwards. AI vendor seats and tokens are billed directly by your studio to your chosen vendor; no markup, no lock-in.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ 05 · HOW WE ENGAGE ════════════════════════════════════════════ -->
  <section id="engagement" class="py-28 md:py-40 border-t border-border/50">
    <div class="max-w-5xl mx-auto px-6">
      <header class="mb-16 md:mb-20 max-w-3xl">
        <p data-fade class="font-mono text-[11.5px] uppercase tracking-[0.2em] text-amber mb-6">05 · How we engage</p>
        <h2 data-fade data-fade-delay="60" class="font-display text-[34px] md:text-[48px] leading-[1.08] font-normal tracking-[-0.02em] mb-8">
          One path forward. Four stages. All optional after the first.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[17px] md:text-[19px] text-text-2 leading-[1.65]">
          No package menu. No hourly billing. Each stage stands on its own — if the Audit is all you need, that is what you get.
        </p>
      </header>

      <ol class="max-w-4xl">
        {ENGAGEMENT_FLOW.map((s, i) => (
          <li data-anim="flow-step" class="flow-step relative grid grid-cols-[64px_1fr] md:grid-cols-[80px_1fr] gap-5 md:gap-8 pb-14 last:pb-0">
            {i < ENGAGEMENT_FLOW.length - 1 && (
              <div class="absolute left-[30px] md:left-[38px] top-[38px] bottom-4 w-px bg-border-2" aria-hidden="true"></div>
            )}
            <div class="relative flex flex-col items-center pt-1">
              <span class="w-[60px] h-[60px] md:w-[76px] md:h-[76px] rounded-full border border-border bg-surface flex items-center justify-center font-mono text-[13px] text-amber tracking-[0.1em] relative z-10">
                {s.n}
              </span>
            </div>
            <div class="pt-2">
              <div class="flex items-baseline gap-3 mb-2 flex-wrap">
                <h3 class="font-display text-[22px] md:text-[26px] font-medium text-text leading-[1.2]">{s.label}</h3>
                <span class="font-mono text-[11.5px] uppercase tracking-[0.14em] text-text-3">{s.meta}</span>
              </div>
              <p class="text-[16px] md:text-[17px] text-text-2 leading-[1.7]">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══ 06 · WHO THIS FITS ════════════════════════════════════════════ -->
  <section id="fit" class="py-28 md:py-40 border-t border-border/50 bg-ink-2/50">
    <div class="max-w-5xl mx-auto px-6">
      <header class="mb-14 md:mb-16 max-w-3xl">
        <p data-fade class="font-mono text-[11.5px] uppercase tracking-[0.2em] text-amber mb-6">06 · Who this fits</p>
        <h2 data-fade data-fade-delay="60" class="font-display text-[34px] md:text-[48px] leading-[1.08] font-normal tracking-[-0.02em] mb-8">
          Calibrated to your studio size.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[17px] md:text-[19px] text-text-2 leading-[1.65]">
          The layered pipeline is the same shape across studio sizes. The calibration — governance weight, privacy tier, rollout cadence — matches your reality.
        </p>
      </header>

      <div class="max-w-4xl divide-y divide-border">
        {SEGMENTS.map((s, i) => (
          <article data-fade data-fade-delay={i * 60}
                   class:list={['grid md:grid-cols-[200px_1fr] gap-4 md:gap-10 py-8 md:py-10',
                                s.highlighted && 'relative']}>
            <div>
              <div class="flex items-center gap-3 mb-2">
                <div class:list={['w-9 h-9 rounded-md border flex items-center justify-center',
                                  s.highlighted ? 'border-amber/40 bg-amber-soft text-amber' : 'border-border bg-surface text-amber']}>
                  <ConsultingIcon name={s.icon} size={17} />
                </div>
                {s.highlighted && (
                  <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-amber">Most common</span>
                )}
              </div>
              <h3 class="font-display text-[20px] md:text-[22px] font-medium text-text leading-[1.2]">{s.title}</h3>
              <p class="font-mono text-[12.5px] text-text-3 mt-1">{s.size}</p>
            </div>
            <p class="text-[16px] text-text-2 leading-[1.7] pt-1">{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ 07 · WHY THIS APPROACH WORKS ══════════════════════════════════ -->
  <section id="why" class="py-28 md:py-40 border-t border-border/50">
    <div class="max-w-5xl mx-auto px-6">
      <header class="mb-14 md:mb-16 max-w-3xl">
        <p data-fade class="font-mono text-[11.5px] uppercase tracking-[0.2em] text-amber mb-6">07 · Why this approach works</p>
        <h2 data-fade data-fade-delay="60" class="font-display text-[34px] md:text-[48px] leading-[1.08] font-normal tracking-[-0.02em] mb-8">
          Boring infrastructure. Predictable outcomes. Compounding value.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[17px] md:text-[19px] text-text-2 leading-[1.65]">
          We do not sell hype. We sell engineering discipline applied to AI adoption in a specific industry that most consultants do not understand.
        </p>
      </header>

      <div class="grid md:grid-cols-2 gap-x-12 gap-y-10 max-w-4xl">
        {DIFFERENTIATORS.map((d, i) => (
          <article data-fade data-fade-delay={i * 50}>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-amber mb-3">0{i + 1}</p>
            <h3 class="font-display text-[19px] md:text-[21px] font-medium text-text mb-2 leading-[1.3]">{d.title}</h3>
            <p class="text-[15px] md:text-[15.5px] text-text-2 leading-[1.65]">{d.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ FAQ ═══════════════════════════════════════════════════════════ -->
  <section id="faq" class="py-28 md:py-40 border-t border-border/50 bg-ink-2/50">
    <div class="max-w-4xl mx-auto px-6">
      <header class="mb-14 max-w-3xl">
        <p data-fade class="font-mono text-[11.5px] uppercase tracking-[0.2em] text-amber mb-6">Questions</p>
        <h2 data-fade data-fade-delay="60" class="font-display text-[34px] md:text-[48px] leading-[1.08] font-normal tracking-[-0.02em]">
          Questions engineering leaders ask.
        </h2>
      </header>

      <div class="border-t border-border">
        {faqs.map((f) => (
          <details data-faq class="group border-b border-border">
            <summary class="flex items-start justify-between gap-6 py-7">
              <span class="font-display text-[19px] md:text-[21px] font-medium text-text leading-[1.35]">{f.q}</span>
              <span class="chevron flex-shrink-0 mt-1.5 text-text-3 group-hover:text-amber transition-colors">
                <ConsultingIcon name="chevron-down" size={18} />
              </span>
            </summary>
            <div class="answer pb-7 pr-12 max-w-3xl">
              <p class="text-[15.5px] md:text-[16px] text-text-2 leading-[1.75]">{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ CTA ═══════════════════════════════════════════════════════════ -->
  <section id="contact" class="py-32 md:py-44 border-t border-border/50">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p data-fade class="font-mono text-[11.5px] uppercase tracking-[0.2em] text-amber mb-8">Get started</p>
      <h2 data-fade data-fade-delay="80" class="font-display text-[36px] md:text-[54px] leading-[1.06] font-normal tracking-[-0.02em] mb-8">
        Start with a Discovery Call. Then decide.
      </h2>
      <p data-fade data-fade-delay="140" class="font-display italic text-[19px] md:text-[22px] text-text-2 leading-[1.55] mb-12 max-w-2xl mx-auto">
        30 minutes. Free. No pitch deck. We confirm fit, discuss your stack and constraints, and either identify a clear path forward or honestly tell you we are not the right partner.
      </p>
      <div data-fade data-fade-delay="220" class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-6">
        <a href={BOOK_PATH} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-md bg-text text-ink font-semibold text-[15px] hover:bg-text-2 transition-colors">
          Book Discovery Call
          <ConsultingIcon name="arrow-right" size={16} class="stroke-[2.5]" />
        </a>
        <a href={`${BASE}/technology`} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-md border border-border text-text hover:border-border-2 hover:bg-surface text-[15px] font-medium transition-colors">
          Read the method
        </a>
      </div>
      <p data-fade data-fade-delay="300" class="text-[13px] text-text-3 font-mono mt-2">
        Or <a href={`mailto:${EMAIL}`} class="text-amber hover:underline">{EMAIL}</a>
      </p>
    </div>
  </section>
</ConsultingLayout>

<style>
