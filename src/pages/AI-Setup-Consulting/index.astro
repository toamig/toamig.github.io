---
import ConsultingLayout from '../../layouts/ConsultingLayout.astro';
import ConsultingIcon from '../../components/ConsultingIcon.astro';
import PipelineDiagram from '../../components/PipelineDiagram.astro';
import {
  SITE, BRAND, EMAIL, LINKEDIN_URL, BASE, BOOK_PATH,
  STACK, HERO, PROBLEMS, PROBLEM_PATTERN,
  PIPELINE, PIPELINE_PRINCIPLE,
  TYPICAL_DAY, TYPICAL_DAY_TAKEAWAY,
  SEGMENTS, DIFFERENTIATORS,
} from '../../data/consulting';

const title = 'AI infrastructure engineered for game studios · Miguel Vieira';
const description = HERO.subhead;

const faqs = [
  {
    q: 'How is this different from just using Claude Code with our team?',
    a: 'Claude Code out of the box is a great tool for individual developers. It does not come with your studio conventions, does not enforce architectural rules, does not integrate with Perforce safely at team scale, does not provide governance for shared knowledge, and does not compose multiple tools into pipelines. We build the infrastructure that makes AI reliable at team scale — the part that is not in the tool itself.',
  },
  {
    q: 'Can our internal team build this after seeing your setup?',
    a: 'Parts of it, yes. Setting up a Git repo with markdown files is not hard. Configuring the official Perforce MCP server is documented. Writing linters is standard engineering work. What is harder: designing the right layer separation without redundancy, calibrating each layer to avoid alert fatigue, integrating systems without brittle glue, establishing governance that survives team changes, measuring outcomes honestly, and evolving as Anthropic ships new capabilities. Studios that try to build this internally typically spend 6-12 months and multiple iterations. We deliver in 6-8 weeks with patterns already tested.',
  },
  {
    q: 'What if we already use ChatGPT or GitHub Copilot?',
    a: 'We can work alongside existing tools or replace them where appropriate. Most studios end up with a stack: Claude for engineering work through structured pipelines, other tools for specific niches (ChatGPT for brainstorming, Copilot for individual autocomplete). The Audit identifies what should stay, what should change, and how the tools should compose.',
  },
  {
    q: 'How do you handle proprietary code and IP?',
    a: 'Through the four privacy tiers detailed on the technology page. Recommendation is made during the Audit based on your IP sensitivity, compliance requirements, and infrastructure preferences. For studios with the strictest IP requirements: self-hosted sandboxes with MCP tunnels keep sensitive operations inside your perimeter while still using Anthropic frontier models.',
  },
  {
    q: 'What is the pricing structure?',
    a: 'Fixed-fee for Audit and Setup phases, scoped in advance, no hourly billing. Monthly retainer for ongoing optimization. Anthropic seats and API tokens are paid directly by your studio to Anthropic; we do not mark up their pricing. Full details discussed during Discovery Call and detailed in written proposals after the Audit.',
  },
  {
    q: 'Do you replace our senior engineers?',
    a: 'No. AI properly integrated makes your existing team more effective. It does not replace senior judgment on architecture or design. Studios that treat this as "we can hire less" typically get worse outcomes than studios that treat it as "our seniors focus on higher-value work."',
  },
  {
    q: 'What about the AI making mistakes?',
    a: 'It will. Every layer is designed with this expectation. Human review is mandatory for all code changes. AI proposes, engineers decide. The measurement framework tracks whether AI-assisted work quality is improving or degrading, and we adjust when issues appear. Autonomous code modification is not a feature we ship, regardless of client requests.',
  },
  {
    q: 'Can you show us the code you would build?',
    a: 'After NDA, yes. Architecture diagrams, sample MCP server configurations, brain repo templates, skill libraries — all shareable in detail once mutual protection is in place. Before NDA, we describe the destination clearly; the specific implementation is the deliverable that requires the engagement.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: BRAND,
      url: SITE,
      sameAs: [LINKEDIN_URL],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        email: EMAIL,
      },
    },
    {
      '@type': 'Service',
      name: 'AI engineering infrastructure for game studios',
      provider: { '@id': `${SITE}/#organization` },
      serviceType: 'AI adoption, tooling, governance, and pipeline engineering for game studios',
      areaServed: 'EU, UK, Nordic countries',
      audience: {
        '@type': 'Audience',
        audienceType: 'Game studios using Unreal Engine 4/5',
      },
      url: `${SITE}${BASE}/`,
    },
  ],
};
---
<ConsultingLayout
  title={title}
  description={description}
  path={`${BASE}/`}
  jsonLd={jsonLd}
>
  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="hero-grid pt-32 pb-24 md:pt-44 md:pb-32 border-b border-border/40">
    <div class="max-w-5xl mx-auto px-6">
      <div data-fade class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border bg-surface text-text-2 text-[12px] font-mono mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-amber"></span>
        For studios using Unreal 4/5, C++, Perforce
      </div>

      <h1 data-fade data-fade-delay="80" class="text-[40px] md:text-[60px] lg:text-[70px] font-bold tracking-[-0.03em] leading-[1.03] mb-6 max-w-4xl">
        AI infrastructure <span class="text-amber">engineered for game studios.</span>
      </h1>

      <p data-fade data-fade-delay="160" class="text-[18px] md:text-[21px] text-text-2 leading-[1.5] max-w-3xl mb-6">
        Centrally governed, layered by design, built on open standards.
      </p>
      <p data-fade data-fade-delay="200" class="text-[16px] md:text-[17px] text-text-3 leading-[1.6] max-w-3xl mb-10">
        Not a chatbot. Not a plugin. The infrastructure your team actually needs to make AI reliable at production scale.
      </p>

      <div data-fade data-fade-delay="280" class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
        <a href={BOOK_PATH} class="inline-flex items-center gap-2 px-6 py-3 rounded-md bg-amber text-ink font-semibold text-[15px] hover:bg-amber-2 transition-colors">
          Book Discovery Call
          <ConsultingIcon name="arrow-right" size={16} class="stroke-[2.5]" />
        </a>
        <a href={`${BASE}/technology`} class="inline-flex items-center gap-2 px-6 py-3 rounded-md border border-border text-text hover:border-border-2 hover:bg-surface text-[15px] font-medium transition-colors">
          Read the technical brief
        </a>
      </div>

      <div data-fade data-fade-delay="360" class="mt-14">
        <p class="text-[11.5px] font-mono uppercase tracking-[0.16em] text-text-3 mb-4">Built on and integrated with</p>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {STACK.map(s => (
            <span class="font-mono text-[14px] text-text-2">{s}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── The Problem ─────────────────────────────────────── -->
  <section id="problem" class="py-24 md:py-32 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-16">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">The problem</p>
        <h2 data-fade data-fade-delay="60" class="text-[34px] md:text-[44px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Adding AI without infrastructure creates more problems than it solves.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-px bg-border/60 border border-border/60 rounded-lg overflow-hidden mb-10">
        {PROBLEMS.map((p, i) => (
          <div data-fade data-fade-delay={i * 80} class="bg-ink p-7 lg:p-9 hover:bg-surface/80 transition-colors">
            <div class="w-9 h-9 rounded-md bg-amber/10 border border-amber/20 flex items-center justify-center mb-5 text-amber">
              <ConsultingIcon name={p.icon} size={18} />
            </div>
            <h3 class="text-[18px] font-semibold text-text mb-3 leading-snug">{p.title}</h3>
            <p class="text-[15px] text-text-2 leading-[1.65]">{p.body}</p>
          </div>
        ))}
      </div>

      <p data-fade class="max-w-3xl text-[16px] text-text-2 leading-[1.7] border-l-2 border-amber/60 pl-5">
        {PROBLEM_PATTERN}
      </p>
    </div>
  </section>

  <!-- ── The Layered Pipeline ─────────────────────────────── -->
  <section id="pipeline" class="py-24 md:py-32 border-b border-border/40 bg-ink-2/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-14">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">The pipeline</p>
        <h2 data-fade data-fade-delay="60" class="text-[34px] md:text-[44px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Five layers. Each with one job.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[17px] text-text-2 leading-[1.6]">
          Most AI adoption failures come from throwing tools at problems without thinking about where each tool belongs in the development lifecycle. We design integration as a layered pipeline where each layer has a specific responsibility, serves a specific audience, and runs at a specific moment. Layers reinforce each other rather than repeat each other.
        </p>
        <p data-fade data-fade-delay="180" class="hidden md:block mt-4 text-[13px] text-text-3 font-mono">
          <span class="text-amber">→</span> Hover a layer to reveal its metadata.
        </p>
      </div>

      <PipelineDiagram layers={PIPELINE} />

      <div data-fade class="max-w-3xl mx-auto mt-14 p-6 md:p-7 rounded-lg border border-amber/40 bg-amber-soft/30">
        <p class="font-mono text-[11.5px] uppercase tracking-[0.14em] text-amber mb-3">Human in the loop, always</p>
        <p class="text-[15.5px] text-text leading-[1.65]">{PIPELINE_PRINCIPLE}</p>
      </div>
    </div>
  </section>

  <!-- ── A Typical Day ────────────────────────────────────── -->
  <section id="day" class="py-24 md:py-32 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-16">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">A typical day</p>
        <h2 data-fade data-fade-delay="60" class="text-[34px] md:text-[44px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          What the pipeline looks like in practice.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[17px] text-text-2 leading-[1.6]">
          One gameplay engineer, one damage-over-time ability, one day. Every layer earns its place without the developer noticing.
        </p>
      </div>

      <ol class="max-w-4xl mx-auto relative">
        <div class="absolute left-[62px] md:left-[110px] top-0 bottom-0 w-px bg-border-2/60" aria-hidden="true"></div>
        {TYPICAL_DAY.map((e, i) => (
          <li data-fade data-fade-delay={i * 50} class="relative grid grid-cols-[80px_1fr] md:grid-cols-[140px_1fr] gap-6 md:gap-10 pb-10 last:pb-0">
            <div class="flex flex-col items-end pt-1">
              <span class="font-mono text-[13px] text-amber">{e.time}</span>
              <span class="font-mono text-[10.5px] uppercase tracking-[0.12em] text-text-3 mt-1">{e.actor}</span>
            </div>
            <div class="relative pl-6 md:pl-8 pt-0.5">
              <span class="absolute left-0 top-2.5 w-3 h-3 rounded-full border-2 border-amber bg-ink"></span>
              <p class="text-[15.5px] text-text-2 leading-[1.65]">{e.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <p data-fade class="max-w-3xl mx-auto mt-10 text-[16px] text-text-2 leading-[1.7]">
        {TYPICAL_DAY_TAKEAWAY}
      </p>
    </div>
  </section>

  <!-- ── The Brain (summary) ──────────────────────────────── -->
  <section id="brain" class="py-24 md:py-32 border-b border-border/40 bg-ink-2/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-[1fr_1.15fr] gap-12 lg:gap-16 items-start">
        <div>
          <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">The brain</p>
          <h2 data-fade data-fade-delay="60" class="text-[32px] md:text-[42px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
            Your studio’s knowledge, structured for AI, protected from drift.
          </h2>
          <p data-fade data-fade-delay="120" class="text-[16.5px] text-text-2 leading-[1.65] mb-6">
            A structured, version-controlled knowledge layer served through MCP. Individual developers can consult it; only tech leads can change it. Every update flows through PR review and CI validation.
          </p>
          <a data-fade data-fade-delay="180" href={`${BASE}/technology#brain`} class="inline-flex items-center gap-2 text-[15px] font-medium text-text hover:text-amber transition-colors">
            See the brain in depth
            <ConsultingIcon name="arrow-right" size={15} class="stroke-[2.5]" />
          </a>
        </div>

        <div data-fade data-fade-delay="120" class="rounded-lg border border-border bg-surface overflow-hidden">
          <div class="px-6 py-4 border-b border-border font-mono text-[11.5px] uppercase tracking-[0.14em] text-text-3">
            brain/
          </div>
          <div class="p-6 md:p-7 font-mono text-[13px] leading-[1.8] text-text-2">
            <div><span class="text-amber">├─</span> conventions/     <span class="text-text-3"># naming, formatting, patterns</span></div>
            <div><span class="text-amber">├─</span> architecture/    <span class="text-text-3"># module boundaries, ownership</span></div>
            <div><span class="text-amber">├─</span> decisions/       <span class="text-text-3"># ADRs with rationale</span></div>
            <div><span class="text-amber">├─</span> examples/        <span class="text-text-3"># canonical implementations</span></div>
            <div><span class="text-amber">├─</span> anti-patterns/   <span class="text-text-3"># explicit "never do this"</span></div>
            <div><span class="text-amber">├─</span> workflows/       <span class="text-text-3"># feature, bug fix, refactor</span></div>
            <div><span class="text-amber">├─</span> platform/        <span class="text-text-3"># console SDK notes</span></div>
            <div><span class="text-amber">└─</span> skills/          <span class="text-text-3"># studio-adapted skill library</span></div>
            <div class="mt-4 pt-4 border-t border-border">
              <div><span class="text-text-3">.github/workflows/</span></div>
              <div>&nbsp;&nbsp;<span class="text-amber">validate.yml</span>  <span class="text-text-3"># CI gate on every PR</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Segments ─────────────────────────────────────────── -->
  <section id="segments" class="py-24 md:py-32 border-b border-border/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-16">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Find your fit</p>
        <h2 data-fade data-fade-delay="60" class="text-[34px] md:text-[44px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Needs scale with team size and IP sensitivity.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[17px] text-text-2 leading-[1.6]">
          Start with the profile that matches yours.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-5">
        {SEGMENTS.map((s, i) => (
          <a
            href={s.href}
            data-fade
            data-fade-delay={i * 80}
            class:list={[
              'group relative flex flex-col p-8 rounded-lg border bg-surface hover:bg-surface-2 transition-all duration-200',
              s.badge ? 'border-amber/40 hover:border-amber/60' : 'border-border hover:border-border-2',
            ]}
          >
            {s.badge && (
              <span class="absolute -top-3 left-8 px-3 py-1 rounded-full bg-amber text-ink text-[11px] font-mono font-semibold uppercase tracking-[0.08em]">
                {s.badge}
              </span>
            )}
            <div class="w-11 h-11 rounded-md bg-amber/10 border border-amber/25 flex items-center justify-center text-amber mb-6">
              <ConsultingIcon name={s.icon} size={20} />
            </div>
            <h3 class="text-[21px] font-semibold tracking-tight mb-1">{s.title}</h3>
            <p class="font-mono text-[13px] text-amber mb-3">{s.size}</p>
            <p class="text-[15px] text-text-2 leading-[1.6] mb-6">{s.tagline}</p>
            <ul class="flex flex-col gap-2 mb-7">
              {s.benefits.map(b => (
                <li class="flex items-start gap-2.5 text-[14px] text-text-2">
                  <span class="text-amber mt-0.5 flex-shrink-0"><ConsultingIcon name="check" size={15} class="stroke-[2.5]" /></span>
                  {b}
                </li>
              ))}
            </ul>
            <span class="mt-auto inline-flex items-center gap-1.5 text-[14px] font-medium text-text group-hover:text-amber transition-colors">
              {s.cta}
              <ConsultingIcon name="arrow-right" size={14} class="stroke-[2.5] group-hover:translate-x-0.5 transition-transform" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Why This Approach Works ──────────────────────────── -->
  <section id="why" class="py-24 md:py-32 border-b border-border/40 bg-ink-2/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-16">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">Why this approach works</p>
        <h2 data-fade data-fade-delay="60" class="text-[34px] md:text-[44px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
          Boring infrastructure. Predictable outcomes. Compounding value.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[17px] text-text-2 leading-[1.6]">
          We do not sell hype. We sell engineering discipline applied to AI adoption in a specific industry that most consultants do not understand.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {DIFFERENTIATORS.map((d, i) => (
          <div data-fade data-fade-delay={i * 50} class="p-7 rounded-lg border border-border bg-surface">
            <span class="font-mono text-[11.5px] text-text-3 tracking-[0.14em]">0{i + 1}</span>
            <h3 class="text-[17px] font-semibold text-text mt-3 mb-2.5 leading-snug">{d.title}</h3>
            <p class="text-[14.5px] text-text-2 leading-[1.6]">{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────── -->
  <section id="faq" class="py-24 md:py-32 border-b border-border/40">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-12 md:mb-16">
        <p data-fade class="text-amber font-mono text-[13px] uppercase tracking-[0.15em] mb-4">FAQ</p>
        <h2 data-fade data-fade-delay="60" class="text-[34px] md:text-[44px] font-bold tracking-[-0.02em] leading-[1.1]">
          Questions engineering leaders ask.
        </h2>
      </div>

      <div class="border-t border-border/60">
        {faqs.map((f) => (
          <details data-faq class="group border-b border-border/60">
            <summary class="flex items-start justify-between gap-6 py-6 md:py-7">
              <span class="text-[16.5px] md:text-[18px] font-medium text-text leading-snug">{f.q}</span>
              <span class="chevron flex-shrink-0 mt-1 text-text-3 group-hover:text-amber transition-colors">
                <ConsultingIcon name="chevron-down" size={18} />
              </span>
            </summary>
            <div class="answer pb-6 md:pb-7 max-w-3xl">
              <p class="text-[15.5px] text-text-2 leading-[1.7]">{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Final CTA ────────────────────────────────────────── -->
  <section id="contact" class="py-28 md:py-40">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 data-fade class="text-[32px] md:text-[46px] font-bold tracking-[-0.02em] leading-[1.1] mb-5">
        Start with a Discovery Call. Then decide.
      </h2>
      <p data-fade data-fade-delay="100" class="text-[17px] md:text-[18px] text-text-2 leading-[1.6] mb-10 max-w-2xl mx-auto">
        30 minutes. Free. No pitch deck. We confirm fit, discuss your stack and constraints, and either identify a clear path forward or honestly tell you we are not the right partner.
      </p>
      <div data-fade data-fade-delay="200" class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-6">
        <a href={BOOK_PATH} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-md bg-amber text-ink font-semibold text-[15px] hover:bg-amber-2 transition-colors">
          Book Discovery Call
          <ConsultingIcon name="arrow-right" size={16} class="stroke-[2.5]" />
        </a>
        <a href={`${BASE}/technology`} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-md border border-border text-text hover:border-border-2 hover:bg-surface text-[15px] font-medium transition-colors">
          Read the technical brief
        </a>
      </div>
      <p data-fade data-fade-delay="280" class="text-[13px] text-text-3 font-mono">
        Or <a href={`mailto:${EMAIL}`} class="text-amber hover:underline">{EMAIL}</a>.
      </p>
    </div>
  </section>
</ConsultingLayout>
