---
import ConsultingLayout from '../../layouts/ConsultingLayout.astro';
import ConsultingIcon from '../../components/ConsultingIcon.astro';
import GsapEffects from '../../components/GsapEffects.astro';
import {
  SITE, BRAND, EMAIL, LINKEDIN_URL, BASE, BOOK_PATH, DEEP_PATH,
  HERO, PROBLEMS,
  WHAT_YOU_GET, PIPELINE_SIMPLE,
  ENGAGEMENT_FLOW, SEGMENTS,
} from '../../data/consulting';

const title = 'AI infrastructure engineered for game studios · Miguel Vieira';
const description = HERO.lede;

// Four plain-language FAQs for the landing. The deep detail lives on /architecture.
const faqs = [
  {
    q: 'Does this lock us into one AI vendor?',
    a: 'No. It works with whatever AI you prefer, Claude, ChatGPT, Gemini, or open models you host yourself. We advise on the trade-offs; you choose. Everything we build runs on your infrastructure and is yours to keep.',
  },
  {
    q: 'How is this different from just giving developers an AI tool?',
    a: 'An AI tool on its own does not know your studio’s conventions, does not review submits, and does not keep your team consistent. We build the layer around the tool that makes it reliable across a whole team.',
  },
  {
    q: 'Does it replace our senior engineers?',
    a: 'No. It makes them more effective by handling the repetitive parts of review and onboarding, so their time goes to architecture and design. Humans approve every change.',
  },
  {
    q: 'How does pricing work?',
    a: 'Fixed-fee for the audit and the build, scoped in advance. AI seats and usage are paid directly by you to your chosen vendor, with no markup from us. Full numbers in the proposal after a short audit.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: BRAND,
      url: SITE,
      sameAs: [LINKEDIN_URL],
      contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: EMAIL },
    },
    {
      '@type': 'Service',
      name: 'AI engineering infrastructure for game studios',
      provider: { '@id': `${SITE}/#organization` },
      serviceType: 'Model-agnostic AI adoption, governance, and pipeline engineering for game studios',
      areaServed: 'EU, UK, Nordic countries',
      audience: { '@type': 'Audience', audienceType: 'Game studios using Unreal Engine 4/5' },
      url: `${SITE}${BASE}/`,
    },
  ],
};
---
<ConsultingLayout
  title={title}
  description={description}
  path={`${BASE}/`}
  jsonLd={jsonLd}
>
  <GsapEffects />

  <!-- ══ HERO ══════════════════════════════════════════════════════════ -->
  <section class="hero-grid pt-32 pb-28 md:pt-44 md:pb-36 relative overflow-hidden">
    <div data-anim="hero-parallax" class="absolute inset-0 pointer-events-none opacity-70"
         style="background: radial-gradient(ellipse 55% 45% at 50% 8%, rgba(184,74,43,0.10), transparent 65%);"></div>
    <div class="relative max-w-4xl mx-auto px-6 text-center">
      <div data-fade class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border bg-surface/70 text-text-2 text-[12px] font-mono mb-9 backdrop-blur-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-amber"></span>
        Model-agnostic · Unreal · C++ · Perforce
      </div>

      <h1 data-fade data-fade-delay="80" class="font-display text-[42px] md:text-[64px] lg:text-[72px] font-normal leading-[1.03] tracking-[-0.03em] mb-8">
        AI infrastructure <em class="not-italic text-amber font-medium">engineered for game studios.</em>
      </h1>

      <p data-fade data-fade-delay="160" class="text-[18px] md:text-[21px] text-text-2 leading-[1.55] max-w-2xl mx-auto mb-12">
        We make AI safe, consistent, and genuinely useful across your team, using whatever AI models you prefer. You keep the code, the knowledge, and the infrastructure.
      </p>

      <div data-fade data-fade-delay="240" class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={BOOK_PATH} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-md bg-text text-ink font-semibold text-[15px] hover:bg-text-2 transition-colors">
          Book a call
          <ConsultingIcon name="arrow-right" size={16} class="stroke-[2.5]" />
        </a>
        <a href="#how" data-scroll class="inline-flex items-center gap-2 text-text hover:text-amber text-[15px] font-medium transition-colors">
          See how it works
          <ConsultingIcon name="arrow-down" size={16} class="stroke-[2.5]" />
        </a>
      </div>
    </div>
  </section>

  <!-- ══ THE PROBLEM (3 bullets) ═══════════════════════════════════════ -->
  <section id="problem" class="py-20 md:py-28 border-t border-border/50">
    <div class="max-w-4xl mx-auto px-6">
      <h2 data-fade class="font-display text-[28px] md:text-[38px] leading-[1.12] font-normal tracking-[-0.02em] mb-10 md:mb-12 max-w-2xl">
        Your team is already using AI. That is the problem.
      </h2>
      <ul class="flex flex-col divide-y divide-border">
        {PROBLEMS.map((p, i) => (
          <li data-fade data-fade-delay={i * 60} class="grid grid-cols-[40px_1fr] gap-5 py-6 items-start">
            <div class="w-9 h-9 rounded-md border border-border bg-surface flex items-center justify-center text-amber mt-0.5">
              <ConsultingIcon name={p.icon} size={17} />
            </div>
            <div>
              <p class="text-[17px] md:text-[19px] font-medium text-text leading-[1.35] mb-1">{p.title}</p>
              <p class="text-[15px] text-text-2 leading-[1.6]">{p.body.split('. ')[0]}.</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══ WHAT YOU GET (the money section) ══════════════════════════════ -->
  <section id="what" class="py-20 md:py-28 border-t border-border/50 bg-ink-2/50">
    <div class="max-w-5xl mx-auto px-6">
      <header class="mb-12 md:mb-14 max-w-2xl">
        <p data-fade class="font-mono text-[11.5px] uppercase tracking-[0.2em] text-amber mb-5">What you get</p>
        <h2 data-fade data-fade-delay="60" class="font-display text-[30px] md:text-[44px] leading-[1.1] font-normal tracking-[-0.02em]">
          Six things, in plain terms.
        </h2>
      </header>
      <div class="grid md:grid-cols-2 gap-x-12 gap-y-8 md:gap-y-10">
        {WHAT_YOU_GET.map((w, i) => (
          <article data-fade data-fade-delay={i * 40} class="flex gap-4">
            <span class="text-amber mt-1 flex-shrink-0"><ConsultingIcon name="check" size={18} class="stroke-[2.5]" /></span>
            <div>
              <h3 class="font-display text-[19px] md:text-[21px] font-medium text-text mb-1.5 leading-[1.25]">{w.title}</h3>
              <p class="text-[15px] text-text-2 leading-[1.6]">{w.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ HOW IT WORKS (5 simple steps) ═════════════════════════════════ -->
  <section id="how" class="py-20 md:py-28 border-t border-border/50">
    <div class="max-w-5xl mx-auto px-6">
      <header class="mb-14 md:mb-16 max-w-2xl">
        <p data-fade class="font-mono text-[11.5px] uppercase tracking-[0.2em] text-amber mb-5">How it works</p>
        <h2 data-fade data-fade-delay="60" class="font-display text-[30px] md:text-[44px] leading-[1.1] font-normal tracking-[-0.02em] mb-5">
          Five moments in a developer’s day. Each one, quietly handled.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] md:text-[17px] text-text-2 leading-[1.6]">
          The right check runs at the right moment, and stays out of the way the rest of the time.
        </p>
      </header>

      <ol class="steps">
        {PIPELINE_SIMPLE.map((s, i) => (
          <li data-anim="flow-step" class="step">
            <div class="step-rail">
              <span class="step-num">{s.n}</span>
              {i < PIPELINE_SIMPLE.length - 1 && <span class="step-line" aria-hidden="true"></span>}
            </div>
            <div class="step-body">
              <p class="step-when">{s.when}</p>
              <p class="step-line-text">{s.line}</p>
            </div>
          </li>
        ))}
      </ol>

      <div data-fade class="mt-12 md:mt-14">
        <a href={DEEP_PATH} class="inline-flex items-center gap-2 text-[15px] font-medium text-text hover:text-amber transition-colors">
          See it in depth, wireframes, flows, and architecture
          <ConsultingIcon name="arrow-right" size={15} class="stroke-[2.5]" />
        </a>
      </div>
    </div>
  </section>

  <!-- ══ WHO IT'S FOR ══════════════════════════════════════════════════ -->
  <section id="fit" class="py-20 md:py-28 border-t border-border/50 bg-ink-2/50">
    <div class="max-w-5xl mx-auto px-6">
      <header class="mb-12 md:mb-14 max-w-2xl">
        <p data-fade class="font-mono text-[11.5px] uppercase tracking-[0.2em] text-amber mb-5">Who it’s for</p>
        <h2 data-fade data-fade-delay="60" class="font-display text-[30px] md:text-[44px] leading-[1.1] font-normal tracking-[-0.02em]">
          Studios from ten to a few hundred developers.
        </h2>
      </header>
      <div class="divide-y divide-border">
        {SEGMENTS.map((s, i) => (
          <article data-fade data-fade-delay={i * 60} class="grid md:grid-cols-[240px_1fr] gap-3 md:gap-10 py-7 items-baseline">
            <div class="flex items-center gap-3">
              <h3 class="font-display text-[20px] md:text-[22px] font-medium text-text leading-[1.2]">{s.title}</h3>
              {s.highlighted && <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-amber">Most common</span>}
            </div>
            <div>
              <p class="font-mono text-[12.5px] text-text-3 mb-1">{s.size}</p>
              <p class="text-[16px] text-text-2 leading-[1.6]">{s.tagline ?? s.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ ENGAGEMENT (4 steps) ══════════════════════════════════════════ -->
  <section id="engagement" class="py-20 md:py-28 border-t border-border/50">
    <div class="max-w-5xl mx-auto px-6">
      <header class="mb-12 md:mb-14 max-w-2xl">
        <p data-fade class="font-mono text-[11.5px] uppercase tracking-[0.2em] text-amber mb-5">How we work together</p>
        <h2 data-fade data-fade-delay="60" class="font-display text-[30px] md:text-[44px] leading-[1.1] font-normal tracking-[-0.02em] mb-5">
          Four steps. You can stop after any of them.
        </h2>
        <p data-fade data-fade-delay="120" class="text-[16px] md:text-[17px] text-text-2 leading-[1.6]">
          No package menu. No lock-in. Everything scoped and priced before it starts.
        </p>
      </header>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
        {ENGAGEMENT_FLOW.map((s, i) => (
          <article data-anim="flow-step" class="flow-step">
            <div class="flex items-baseline gap-3 mb-3">
              <span class="font-mono text-[13px] text-amber">{s.n}</span>
              <span class="font-mono text-[10.5px] uppercase tracking-[0.12em] text-text-3">{s.meta}</span>
            </div>
            <h3 class="font-display text-[20px] font-medium text-text mb-2 leading-[1.2]">{s.label}</h3>
            <p class="text-[14.5px] text-text-2 leading-[1.6]">{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ FAQ (4, plain) ════════════════════════════════════════════════ -->
  <section id="faq" class="py-20 md:py-28 border-t border-border/50 bg-ink-2/50">
    <div class="max-w-3xl mx-auto px-6">
      <h2 data-fade class="font-display text-[30px] md:text-[42px] leading-[1.1] font-normal tracking-[-0.02em] mb-10">
        Quick answers.
      </h2>
      <div class="border-t border-border">
        {faqs.map((f) => (
          <details data-faq class="group border-b border-border">
            <summary class="flex items-start justify-between gap-6 py-6">
              <span class="font-display text-[18px] md:text-[20px] font-medium text-text leading-[1.35]">{f.q}</span>
              <span class="chevron flex-shrink-0 mt-1.5 text-text-3 group-hover:text-amber transition-colors">
                <ConsultingIcon name="chevron-down" size={18} />
              </span>
            </summary>
            <div class="answer pb-6 pr-10 max-w-2xl">
              <p class="text-[15.5px] text-text-2 leading-[1.7]">{f.a}</p>
            </div>
          </details>
        ))}
      </div>
      <p data-fade class="mt-8 text-[14px] text-text-3">
        More questions answered on <a href={DEEP_PATH} class="text-amber hover:underline">the how-it-works page</a>.
      </p>
    </div>
  </section>

  <!-- ══ CTA ═══════════════════════════════════════════════════════════ -->
  <section id="contact" class="py-28 md:py-40 border-t border-border/50">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 data-fade class="font-display text-[34px] md:text-[52px] leading-[1.06] font-normal tracking-[-0.02em] mb-6">
        Start with a 30-minute call.
      </h2>
      <p data-fade data-fade-delay="80" class="font-display italic text-[19px] md:text-[22px] text-text-2 leading-[1.5] mb-10">
        Free. No pitch deck. We tell you honestly whether this fits your studio, or not.
      </p>
      <div data-fade data-fade-delay="160" class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={BOOK_PATH} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-md bg-text text-ink font-semibold text-[15px] hover:bg-text-2 transition-colors">
          Book a call
          <ConsultingIcon name="arrow-right" size={16} class="stroke-[2.5]" />
        </a>
        <a href={DEEP_PATH} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-md border border-border text-text hover:border-border-2 hover:bg-surface text-[15px] font-medium transition-colors">
          See how it works
        </a>
      </div>
      <p data-fade data-fade-delay="240" class="text-[13px] text-text-3 font-mono mt-6">
        Or <a href={`mailto:${EMAIL}`} class="text-amber hover:underline">{EMAIL}</a>
      </p>
    </div>
  </section>
</ConsultingLayout>

<style>
  /* How-it-works vertical stepper */
  .steps { list-style: none; margin: 0; padding: 0; }
  .step { display: grid; grid-template-columns: 56px 1fr; gap: 20px; }
  .step-rail { display: flex; flex-direction: column; align-items: center; }
  .step-num {
    flex-shrink: 0;
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1px solid var(--color-border-2);
    background: var(--color-surface);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--color-amber);
  }
  .step-line { flex: 1; width: 1px; background: var(--color-border-2); margin: 6px 0; min-height: 24px; }
  .step-body { padding-bottom: 32px; padding-top: 8px; }
  .step:last-child .step-body { padding-bottom: 0; }
  .step-when {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-3);
    margin: 0 0 6px;
  }
  .step-line-text {
    font-size: 17px;
    color: var(--color-text);
    line-height: 1.5;
    margin: 0;
    max-width: 42rem;
  }
  @media (min-width: 768px) {
    .step-line-text { font-size: 19px; }
  }
</style>
