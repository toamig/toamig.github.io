---
// The Timeline: who Miguel is outside the CV, then every moment, grouped by
// year along a rail, in the same structure as the homepage (styles/site.css)
// with its own rules in styles/timeline.css. Moments are rendered here at build
// time; scripts/timeline.ts filters and re-sorts them. Each card opens the
// moment's page, its photo growing into the page banner.
import BaseLayout        from '../layouts/BaseLayout.astro';
import HeroConstellation from '../components/HeroConstellation.astro';
import TransitionTiles   from '../components/TransitionTiles.astro';
import profile           from '../data/profile.json';
import { moments, years, filterTags } from '../data/timeline';
import '../styles/timeline.css';
import '../styles/work-transition.css';

const first = years[years.length - 1]?.year;
---
<BaseLayout
  title="Miguel Vieira (Toamig) · Timeline"
  description="Learn more about Miguel Vieira: game developer, traveller, and serial hobbyist."
  ogUrl="https://toamig.com/Timeline/"
  bodyClass="theme-dark timeline-page"
>
  <TransitionTiles slot="head" base="/Timeline/" idPrefix="t-" namePrefix="moment-" expect="#tl-end" />

  <section class="tl-intro" aria-labelledby="tl-title">
    <HeroConstellation />
    <div class="hn-wrap tl-intro-grid">
      <img class="tl-photo" src="/me/IMG_7.JPEG" alt="Miguel Vieira, game engineer and tech lead" decoding="async" />
      <div class="tl-intro-text">
        <h1 class="hn-title" id="tl-title">Timeline<sup class="hn-datum">{moments.length} moments since {first}</sup></h1>
        <p class="tl-lead">{profile.timelineAbout.intro}</p>
        <p class="tl-text">{profile.timelineAbout.body}</p>
        <p class="tl-text">{profile.timelineAbout.closing}</p>
      </div>
    </div>
  </section>

  <section class="hn-section tl" id="moments" aria-label="Moments">
    <div class="hn-wrap">
      <div class="tl-controls">
        <div class="hn-chips" role="group" aria-label="Show moments from">
          <button class="hn-chip tl-chip" type="button" data-tag="all" aria-pressed="true">
            All <span class="hn-n">{moments.length}</span>
          </button>
          {filterTags.map(t => (
            <button class="hn-chip tl-chip" type="button" data-tag={t.id} aria-pressed="false" style={`--dot:${t.color}`}>
              <i class="hn-dot" aria-hidden="true"></i>{t.name} <span class="hn-n">{t.count}</span>
            </button>
          ))}
        </div>
        <button class="hn-chip tl-sort" type="button" data-sort aria-label="Change the order">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16M3 16l4 4 4-4M17 20V4M13 8l4-4 4 4" /></svg>
          <span data-sort-label>Newest first</span>
        </button>
      </div>

      <nav class="tl-years" aria-label="Jump to a year" data-tl-years>
        {years.map(y => <a href={`#y-${y.year}`} data-year-link={y.year}>{y.year}</a>)}
      </nav>

      <div class="tl-track" data-tl-track>
        <span class="tl-rail" aria-hidden="true"><span class="tl-rail-fill" data-tl-rail></span></span>
        <div class="tl-yearlist" data-tl-list>
          {years.map(y => (
            <section class="tl-year" id={`y-${y.year}`} data-year={y.year} aria-labelledby={`yl-${y.year}`}>
              <h2 class="tl-year-label" id={`yl-${y.year}`}>{y.year}</h2>
              <ol class="tl-list">
                {y.moments.map(m => (
                  <li class="tl-item" data-tags={m.tags.map(t => t.id).join(' ')}>
                    <a class="tl-card" id={`t-${m.id}`} href={`/Timeline/${m.id}/`} style={`--dot:${m.tags[0]?.color ?? '#64748b'}`}>
                      <span class="tl-node" aria-hidden="true"></span>
                      {m.thumb && (
                        <div class="tl-thumb" data-vt-art>
                          <img src={m.thumb} alt="" decoding="async" />
                        </div>
                      )}
                      <div class="tl-body" data-vt-body>
                        <p class="tl-meta">
                          <time datetime={m.date}>{m.shortDate}</time>
                          {m.tags.map(t => <span class="tl-tag" style={`--dot:${t.color}`}><i class="hn-dot" aria-hidden="true"></i>{t.name}</span>)}
                        </p>
                        <h3 class="tl-title">{m.title}</h3>
                        {m.description && <p class="tl-desc">{m.description}</p>}
                      </div>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </div>
      <p class="tl-empty" data-tl-empty hidden>Nothing under that filter yet.</p>
      <span id="tl-end"></span>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/timeline';
</script>
