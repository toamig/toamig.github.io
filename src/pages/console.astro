---
import ConsoleLayout from '../layouts/ConsoleLayout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/ConsoleIcon.astro';
import Profile from '../components/ConsoleProfile.astro';
import { categories, consoleItems as items } from '../data/console';
import extras from '../data/cvExtras.json';
import profile from '../data/profile.json';
const socials = [{name:'LinkedIn', href:extras.contact.linkedin, detail:'Experience & connections'}, {name:'GitHub', href:extras.contact.github, detail:'Code & experiments'}, {name:'itch.io', href:extras.contact.itch, detail:'Small games. Big ideas.'}, {name:'Instagram', href:extras.contact.instagram, detail:'Life beyond the screen'}];
const profileIcons: Record<string, string> = { overview:'user', career:'briefcase', toolkit:'code', education:'book' };
---
<ConsoleLayout>
  <a class="skip-link" href="#workspace">Skip to portfolio</a>
  <div class="world" aria-hidden="true"><canvas id="ambient-canvas"></canvas><div id="world-art-a" class="world-art"></div><div id="world-art-b" class="world-art"></div><div class="world-shade"></div><div class="world-emblem"><Logo /></div><div class="world-vignette"></div></div>
  <div class="os-shell" id="os-shell">
    <header class="system-header" data-nav-row>
      <button class="system-brand" id="home-control" aria-label="Return to Games"><Logo /><span>TOAMIG</span><span class="brand-edition">Personal universe</span></button>
      <div class="system-tools"><a class="portfolio-exit" id="portfolio-exit" href="/#playroom" title="Return to portfolio"><Icon name="back" /><span>Portfolio</span></a><button class="icon-button" data-open="search" aria-label="Search portfolio" title="Search"><Icon name="search" /></button><button class="icon-button" data-open="settings" aria-label="Settings" title="Settings"><Icon name="settings" /></button><button class="user-button" data-open="profile" aria-label="Meet Miguel Vieira"><img src="/console/miguel.webp" alt="" /><span>Miguel Vieira</span></button><time id="system-clock" aria-label="Local time"></time></div>
    </header>
    <main id="workspace" tabindex="-1">
      <div id="library-screen" data-screen="library">
        <nav class="category-nav" aria-label="Portfolio categories" role="tablist" data-nav-row>{categories.map((c, i) => <button class:list={['category', {'is-active':i === 0}]} id={`category-${c.id}`} data-category={c.id} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls="category-content" tabindex={i === 0 ? 0 : -1}><span class="category-symbol"><Icon name={c.icon} /></span><span>{c.name}</span><span class="category-dot"></span></button>)}</nav>
        <section class="category-content" id="category-content" role="tabpanel" aria-labelledby="category-games">
          <aside class="library-sidebar"><div class="library-heading"><span id="category-description">Games I’ve worked on</span><span id="library-position">1 / 6</span></div><div class="item-rail" role="listbox" aria-label="Games" id="item-rail"><div class="rail-track" id="rail-track">
            {items.map((item, i) => <button class:list={['library-item', {'is-selected':i === 0}]} id={`item-${item.id}`} style={`--i:${items.filter(x => x.category === item.category).indexOf(item)}`} role="option" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-item={item.id} data-group={item.category}>
              <span class:list={['item-cover', {'symbol-cover':!item.thumbnail, 'portrait-cover':item.category === 'profile'}]}>{item.thumbnail ? <img src={item.thumbnail} alt="" loading={i < 2 ? 'eager' : 'lazy'} /> : item.id === 'polyglyph' ? <span class="glyph-mark">文</span> : <Icon name={profileIcons[item.id] || 'spark'} />}</span><span class="item-label"><strong>{item.name}</strong><small>{item.subtitle}</small></span><span class="item-indicator"><Icon name="chevron" /></span>
            </button>)}
          </div></div><div class="rail-hint"><span>↑ ↓</span> Explore this category</div></aside>
          <div class="feature-stage" id="feature-stage">{items.map((item, i) => <article class:list={['feature', {'is-selected':i === 0, 'profile-feature':item.category === 'profile'}]} data-feature={item.id} hidden={i !== 0}>
            {item.category === 'profile' && <img class="feature-portrait" src="/console/miguel.webp" alt="" />}
            <div class="feature-copy"><p class="feature-eyeline">{item.category === 'games' ? 'Games I’ve helped bring to life' : categories.find(c => c.id === item.category)!.description}</p><h1>{item.id === 'overview' ? <>Miguel Vieira<span>.</span></> : item.name}</h1><p class="feature-role">{item.subtitle}</p><p class="feature-description">{item.description}</p><div class="actions" data-nav-row><button class="action primary" data-explore={item.id}>{item.category === 'profile' ? 'Meet the developer' : item.category === 'journal' ? 'Open journal' : 'Explore project'}<Icon name="arrow" /></button>{item.category === 'games' && <a class="action subtle" href={item.href} target="_blank" rel="noopener noreferrer">Visit game</a>}</div><div class="feature-meta">{item.studioLogo && <span class="feature-studio"><img src={item.studioLogo} alt={item.studio} /></span>}<span>{item.meta[0]}</span>{item.meta[1] && <span>{item.meta[1]}</span>}</div></div>
          </article>)}</div>
        </section>
        <div class="library-bottom"><span id="category-count">6 games in this collection</span><button class="developer-shortcut" data-open="profile"><img src="/console/miguel.webp" alt="" /><span>Curious who built this?<strong>Meet your developer</strong></span><Icon name="arrow" /></button></div>
      </div>
      <div class="screen-topbar" id="screen-topbar" hidden data-nav-row><button class="back-button" id="screen-back"><Icon name="back" /><span>Back</span></button><span id="screen-breadcrumb"></span><span class="screen-brand">toamig / portfolio</span></div>
      <Profile />
      <section class="app-screen project-screen" id="screen-project" data-screen="project" aria-labelledby="project-title" hidden>
        <div class="project-overview"><div class="project-intro"><p class="eyeline" id="project-eyeline"></p><h1 id="project-title"></h1><p class="project-role" id="project-role"></p><p class="body-copy" id="project-description"></p><div class="actions" data-nav-row><a class="action primary" id="project-link">Visit project<Icon name="arrow" /></a><button class="action subtle" data-open="contact">Let’s talk</button></div></div><figure class="project-art"><img id="project-image" alt="" /><div id="project-symbol" hidden><Icon name="spark" /></div><figcaption id="project-caption"></figcaption></figure></div>
        <div class="project-contribution"><div><p class="eyeline" id="contribution-eyeline">My contribution</p><h2 id="contribution-title">Behind the experience.</h2><img id="project-studio" alt="" hidden /></div><ul class="contribution-list" id="project-bullets"></ul></div>
      </section>
      <section class="app-screen journal-screen" id="screen-journal" data-screen="journal" aria-labelledby="journal-title" hidden><div class="journal-heading"><div><p class="eyeline" id="journal-date"></p><h1 id="journal-title"></h1></div><p class="body-copy" id="journal-description"></p></div><figure class="journal-main"><img id="journal-backdrop" class="journal-backdrop" alt="" aria-hidden="true" /><img id="journal-image" alt="" /></figure><div class="journal-controls" data-nav-row><button class="icon-button" id="photo-previous" aria-label="Previous photograph"><Icon name="back" /></button><span id="photo-position"></span><button class="icon-button" id="photo-next" aria-label="Next photograph"><Icon name="arrow" /></button><a class="text-link" id="journal-link">Read timeline entry<Icon name="arrow" /></a></div></section>
      <section class="app-screen contact-screen" id="screen-contact" data-screen="contact" aria-labelledby="contact-title" hidden><div class="contact-intro"><p class="eyeline">The next good thing starts with a conversation</p><h1 id="contact-title">Let’s build<br />something<br />worth playing.</h1><p class="body-copy">Games, engineering, a wild idea.<br />I’d love to hear what you’re thinking.</p><p class="contact-location"><Icon name="location" />{extras.contact.location}</p></div><div class="contact-channels"><p class="eyeline">Say hello</p><a class="email-link" id="email-link" href={`mailto:${extras.contact.email}`}>{extras.contact.email}<Icon name="arrow" /></a><button class="text-link" id="copy-email" data-email={extras.contact.email}><Icon name="copy" /><span>Copy email address</span></button><div class="social-list" data-nav-column>{socials.map(s => <a href={`https://${s.href}`} target="_blank" rel="noopener noreferrer"><span><strong>{s.name}</strong><small>{s.detail}</small></span><Icon name="arrow" /></a>)}</div></div></section>
      <section class="app-screen settings-screen" id="screen-settings" data-screen="settings" aria-labelledby="settings-title" hidden><div class="settings-intro"><p class="eyeline">Your space, your way</p><h1 id="settings-title">Make yourself<br />at home.</h1><p class="body-copy">A little atmosphere. A familiar feeling.<br />Settle in and make it yours.</p><Logo /></div><div class="settings-controls" data-nav-column><label class="setting-row"><span>System sound<small>Startup, navigation, and selection cues</small></span><input id="sound-setting" type="checkbox" role="switch" checked /></label><label class="setting-row"><span>Volume<small>Keep the atmosphere comfortable</small></span><input id="volume-setting" type="range" min="0" max="100" value="45" aria-label="System volume" /></label><label class="setting-row"><span>Ambient motion<small>Light ribbons and screen transitions</small></span><input id="motion-setting" type="checkbox" role="switch" checked /></label><button class="setting-row" id="fullscreen-control"><span>Enter fullscreen<small>The whole screen belongs to the experience</small></span><Icon name="fullscreen" /></button><button class="setting-row" id="replay-boot"><span>Replay startup<small>From the very first note</small></span><Icon name="power" /></button><div class="controls-guide"><h2>At your fingertips</h2><p>Left and right switch categories. Up and down explore the collection. Enter opens an item. Escape takes you back.</p><p>On a standard controller, use the D-pad or left stick, the bottom face button to select, and the right face button to return. The shoulder buttons switch categories, and the options button opens these settings.</p></div></div></section>
      <section class="app-screen search-screen" id="screen-search" data-screen="search" aria-labelledby="search-title" hidden><p class="eyeline">Find your next destination</p><h1 id="search-title">What are you looking for?</h1><label class="search-field"><Icon name="search" /><input id="library-search" type="search" placeholder="Games, plugins, a little about me…" aria-label="Search the portfolio" autocomplete="off" /></label><p id="search-count" role="status"></p><div class="search-results" data-nav-grid>{items.map(item => <button class="search-result" data-search-item={item.id} data-search-text={`${item.name} ${item.subtitle} ${item.description}`.toLowerCase()}>{item.thumbnail ? <img src={item.thumbnail} alt="" loading="lazy" /> : <span class="result-symbol"><Icon name={categories.find(c => c.id === item.category)!.icon} /></span>}<span><strong>{item.name}</strong><small>{item.subtitle}</small></span><Icon name="arrow" /></button>)}</div><p id="search-empty" hidden>No matches. Try “Unreal”, a game title, or “Miguel”.</p></section>
      <div class="scroll-hint" id="scroll-hint" hidden aria-hidden="true"><Icon name="chevron" /></div>
    </main>
    <footer class="control-bar" data-nav-row><div class="control-left"><button class="icon-button" id="back-control" aria-label="Go back" title="Back"><Icon name="back" /></button><button class="icon-button" data-open="contact" aria-label="Get in touch" title="Get in touch"><Icon name="mail" /></button><button class="icon-button sound-button" id="sound-control" aria-label="Mute system sound" aria-pressed="true" title="System sound"><Icon name="sound" /><Icon name="muted" /></button><span class="footer-message" id="footer-message">Sound on</span></div><div class="input-hints"><span id="controller-status"><Icon name="controller" /><span>Keyboard ready</span></span><span id="category-hint"><kbd>← →</kbd> Categories</span><span id="item-hint"><kbd>↑ ↓</kbd> Explore</span><span><kbd>↵</kbd> Select</span><span><kbd>esc</kbd> Back</span></div></footer>
  </div>
  <section class="boot-screen" id="boot" aria-label="Welcome to Toamig" hidden><canvas id="boot-canvas" aria-hidden="true"></canvas><div class="boot-mark" id="boot-mark" aria-hidden="true"><Logo /></div><p class="boot-note" id="boot-note">Best enjoyed with sound on and a controller in hand.</p><div class="boot-controls"><button id="start-boot" class="boot-start"><span class="start-symbol"><Icon name="power" /></span><span>Press Enter to start</span></button><button id="skip-boot" class="boot-skip" hidden>Skip <kbd>↵</kbd></button><button id="boot-sound" class="boot-sound" aria-pressed="true"><Icon name="sound" /><span>Sound on</span></button></div></section>
  <div id="console-dock" class="console-dock" aria-hidden="true"><div class="dock-orbit"></div><Logo /><p>Your world. Press start.</p><span>TOAMIG / PORTABLE</span></div>
  <noscript><section class="no-script"><h1>Miguel Vieira</h1><p>{profile.shortVersion.lead}</p><p>Enable JavaScript for the console experience, or explore the links below.</p><a href="/">Return to portfolio</a><a href="/cv">View CV</a><a href={`mailto:${extras.contact.email}`}>Get in touch</a>{items.filter(i => i.href).map(i => <a href={i.href}>{i.name}</a>)}</section></noscript>
  <script id="library-data" type="application/json" set:html={JSON.stringify({items, categories}).replaceAll('<', '\\u003c')} />
  <script>import '../scripts/console';</script>
</ConsoleLayout>
