---
import BaseLayout    from '../../layouts/BaseLayout.astro';
import ResumeChooser from '../../components/ResumeChooser.astro';
---
<BaseLayout
  title="Miguel Vieira (Toamig) · CV"
  description="Read Miguel Vieira's CV in two formats: an editorial layout for human readers and an ATS-friendly version for automated screeners."
  ogUrl="https://toamig.com/cv/"
  bodyClass="solid-header"
>
  <!-- Standalone CV chooser. The section, nav, audio, and footer all come
       from the shared layout; only the picker lives on this page. -->
  <div class="cv-standalone">
    <ResumeChooser />
  </div>
</BaseLayout>

<style>
  /* The chooser is the whole page here, so give it viewport height, vertical
     centering, and enough top room to clear the fixed (solid) header. */
  .cv-standalone :global(#resume) {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: clamp(120px, 16vh, 190px);
    padding-bottom: clamp(72px, 10vh, 120px);
  }
</style>
