---
import BaseLayout        from '../layouts/BaseLayout.astro';
import Logo              from '../components/Logo.astro';
import HeroConstellation from '../components/HeroConstellation.astro';
import ConsolePortal     from '../components/ConsolePortal.astro';
import WorkGrid          from '../components/home/WorkGrid.astro';
import CareerList        from '../components/home/CareerList.astro';
import education      from '../data/education.json';
import experience     from '../data/experience.json';
import technologies   from '../data/technologies.json';
import profile        from '../data/profile.json';
import cvExtras       from '../data/cvExtras.json';
import { work }       from '../data/work';
import '../styles/home.css';
import '../styles/work-transition.css';

const contact = cvExtras.contact;

// cvExtras stores bare hostnames; the markup needs absolute URLs.
const absolute = (u: string) => (/^https?:/i.test(u) ? u : `https://${u}`);

// The social links live here rather than in the site footer: named links in
// the section about reaching me read far better to a recruiter than unlabelled
// icons in page chrome, and this way each link has exactly one home.
const contactChannels = [
  { label: 'LinkedIn',  href: absolute(contact.linkedin)  },
  { label: 'GitHub',    href: absolute(contact.github)    },
  { label: 'itch.io',   href: absolute(contact.itch)      },
  { label: 'Instagram', href: absolute(contact.instagram) },
];

// The hero's "now" strip: what is live this week, each one a way into the page.
// Built from the data so it never claims something the rest of the site doesn't.
const currentJob = experience.find(e => (e as any).current ?? e.period?.includes('Present'));
const byId = (id: string) => work.find(w => w.id === id);
const nowItems = [
  currentJob && {
    title: `${currentJob.role} at ${currentJob.name}`,
    sub: `Since ${currentJob.period.split(' - ')[0]}`,
    href: '#career',
    thumb: currentJob.logo,
    logo: true,
  },
  byId('polyglyph') && {
    title: 'Polyglyph',
    sub: byId('polyglyph')!.state ?? '',
    href: byId('polyglyph')!.href,
    thumb: byId('polyglyph')!.thumb,
    logo: false,
  },
  byId('counting-sheep') && {
    title: 'Counting Sheep',
    sub: byId('counting-sheep')!.state ?? '',
    href: byId('counting-sheep')!.href,
    thumb: byId('counting-sheep')!.thumb,
    logo: false,
  },
  byId('radar') && {
    title: 'Toa Radar',
    sub: byId('radar')!.state ?? '',
    href: '/radar/',
    thumb: '/ventures/radar/mark.svg',
    logo: false,
    radar: true,
  },
].filter(Boolean) as { title: string; sub: string; href: string; thumb?: string; logo: boolean; radar?: boolean }[];

// The About band names the tools rather than grading them; CV-only entries
// (languages and services listed for recruiters' keyword scans) stay on the CV.
const tools = technologies.filter(t => !(t as any).cvOnly && t.src);
---
<BaseLayout
  title="Miguel Vieira (Toamig) · Game Engineer & Tech Lead"
  description={profile.shortVersion.lead}
  ogUrl="https://toamig.com/"
  ogImage="https://toamig.com/og/home.png?v=20260817-4"
  ogImageAlt="Miguel Vieira (Toamig), game engineer and tech lead"
  ogImageWidth={1200}
  ogImageHeight={630}
  bodyClass="home"
>
  <!-- Page transitions to and from /work/<id>/ (styles/work-transition.css).
       Only the tile involved gets transition names, set at the moment of
       navigating: pageswap when leaving for a project, pagereveal when coming
       back from one. Naming every tile up front would lift them all into their
       own layers and fade each one separately. The expect link holds the first
       frame until the grid is parsed, so the tile exists when pagereveal runs. -->
  <link slot="head" rel="expect" href="#career" blocking="render" />
  <script is:inline slot="head">
    (() => {
      // window.__afterTransition (read via scripts/after-transition.ts) lets
      // heavy startup wait until an incoming transition has finished.
      let settle;
      window.__afterTransition = new Promise((resolve) => { settle = resolve; });
      if (!('onpagereveal' in window)) settle();

      const workId = (url) => {
        try {
          const m = new URL(url, location.href).pathname.match(/^\/work\/([^/]+)\/?$/);
          return m ? m[1] : null;
        } catch { return null; }
      };
      const clear = () => document.querySelectorAll('.wk-art, .wk-body').forEach((el) => {
        el.style.removeProperty('view-transition-name');
        el.style.removeProperty('view-transition-class');
      });
      const mark = (id) => {
        clear();
        const tile = id && document.getElementById('w-' + id);
        if (!tile) return;
        const art = tile.querySelector('.wk-art');
        const body = tile.querySelector('.wk-body');
        if (art) {
          art.style.setProperty('view-transition-name', 'work-' + id);
          art.style.setProperty('view-transition-class', 'work-art');
        }
        if (body) {
          body.style.setProperty('view-transition-name', 'work-body');
          body.style.setProperty('view-transition-class', 'work-body');
        }
      };
      addEventListener('pageswap', (e) => {
        if (e.viewTransition && e.activation) mark(workId(e.activation.entry.url));
      });
      addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) { settle(); return; }
        const from = window.navigation && navigation.activation && navigation.activation.from;
        const id = from ? workId(from.url) : null;
        mark(id);
        // Coming back from a project has its own, quicker choreography.
        if (id && e.viewTransition.types) e.viewTransition.types.add('to-grid');
        e.viewTransition.finished.finally(() => { clear(); settle(); });
      });
    })();
  </script>

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <div class="front-page has-now">
    <HeroConstellation />
    <div class="front-page-content">
      <div class="branding">
        <div id="branding-placeholder">
          <Logo class="logo" />
        </div>
        <h1>TOAMIG</h1>
      </div>

      <p class="hero-tagline">
        I lead the engineering<br />
        behind <span class="hero-accent">games</span>.
      </p>

      <div class="hero-disciplines" aria-label="Disciplines">
        <span>Gameplay</span>
        <span>Multiplayer</span>
        <span>Tools</span>
        <span>Animation</span>
        <span>AI</span>
        <span>Leadership</span>
      </div>

      <div class="hero-actions">
        <a class="hero-btn hero-btn-primary" href="/cv">View CV</a>
        <a class="hero-btn hero-btn-ghost" href="#work">See my work</a>
      </div>
      <a class="hero-playroom-link" href="#playroom">Or, take the player entrance <span aria-hidden="true">↗</span></a>
    </div>

    <nav class="now" aria-label="What I'm working on now">
      <span class="now-key"><i aria-hidden="true"></i>Now</span>
      {nowItems.map(n => (
        <a class="now-item" href={n.href}>
          {n.thumb && <img class={`now-thumb${n.logo ? ' is-logo' : ''}`} src={n.thumb} alt="" decoding="async" />}
          <span class="now-text">
            <span class="now-title">{n.title}</span>
            <span class="now-sub" data-radar-now={n.radar ? '' : undefined}>{n.sub}</span>
          </span>
        </a>
      ))}
    </nav>
  </div>

  <div id="content">
    <WorkGrid />
    <CareerList />

    <!-- About -->
    <section id="profile" class="hn-section ab" aria-labelledby="profile-title">
      <div class="hn-wrap ab-grid">
        <img class="ab-photo" src="/me/IMG_7.JPEG" alt="Miguel Vieira, game engineer and tech lead" loading="lazy" decoding="async" />
        <div class="ab-text">
          <h2 class="hn-title" id="profile-title">About</h2>
          <p class="ab-lead">{profile.shortVersion.lead}</p>
          <p class="ab-body">{profile.shortVersion.body}</p>
          <dl class="ab-facts">
            <div>
              <dt>Tools I reach for</dt>
              <dd class="ab-tools">
                {tools.map(t => (
                  <a class="ab-tool" href={t.href} title={t.name} target="_blank" rel="noopener noreferrer">
                    <img src={t.src} alt={t.name} loading="lazy" decoding="async" />
                  </a>
                ))}
              </dd>
            </div>
            <div>
              <dt>Studies</dt>
              <dd class="ab-studies">
                {education.map(e => (
                  <span><a href={e.href} target="_blank" rel="noopener noreferrer">{e.role}</a>, {e.name} <span class="ab-when">{e.period}</span></span>
                ))}
              </dd>
            </div>
            <div>
              <dt>Based in</dt>
              <dd>{contact.location}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="hn-section ct" aria-labelledby="contact-title">
      <div class="hn-wrap">
        <div class="ct-panel">
          <h2 class="hn-title" id="contact-title">Let's talk</h2>
          <p class="ct-lede">
            Open to engineering leadership roles, contract Unreal work, and studio
            consulting. Email is the fastest way to reach me.
          </p>
          <div class="ct-mail-row">
            <a class="ct-mail" href={`mailto:${contact.email}`}>{contact.email}</a>
            <button class="ct-copy" type="button" data-copy={contact.email}>
              <span data-copy-label aria-live="polite">Copy address</span>
            </button>
          </div>
          <div class="ct-channels">
            {contactChannels.map(c => (
              <a href={c.href} target="_blank" rel="noopener noreferrer">{c.label}</a>
            ))}
            <a href="/cv">CV</a>
          </div>
        </div>
      </div>
    </section>
  </div>
  <ConsolePortal />
</BaseLayout>

<script>
  import '../scripts/home';
</script>
