---
import BaseLayout        from '../layouts/BaseLayout.astro';
import Logo              from '../components/Logo.astro';
import ResumeChooser     from '../components/ResumeChooser.astro';
import HeroConstellation from '../components/HeroConstellation.astro';
import education      from '../data/education.json';
import experience     from '../data/experience.json';
import technologies   from '../data/technologies.json';
import techCategories from '../data/techCategories.json';
import projects       from '../data/projects.json';
import profile        from '../data/profile.json';

// Decorative 8x8 Sesqui position for the Personal Projects feature card.
// 'v' = gold piece (links top to bottom), 'h' = pale piece (links left to right).
const boardCells = Array.from({ length: 64 }, (_, i) => {
  const r = Math.floor(i / 8);
  const c = i % 8;
  return { dark: (r + c) % 2 === 1, piece: null as null | 'v' | 'h' };
});
for (const [r, c] of [[0,3],[1,3],[2,4],[3,4],[4,4],[5,3],[6,3],[7,3]]) boardCells[r * 8 + c].piece = 'v';
for (const [r, c] of [[2,6],[3,0],[3,1],[4,6],[5,6]]) boardCells[r * 8 + c].piece = 'h';
---
<BaseLayout
  title="Miguel Vieira (Toamig) · Game Engineer & Tech Lead"
  description={profile.shortVersion.lead}
  ogUrl="https://toamig.com/"
  ogImage="https://toamig.com/og/home.png"
  ogImageAlt="Miguel Vieira (Toamig), game engineer and tech lead"
  ogImageWidth={1200}
  ogImageHeight={630}
>
  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <div class="front-page">
    <HeroConstellation />
    <div class="front-page-content">
      <div class="hero-status" aria-label="Current role">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="status-key">CURRENT</span>
        <span class="status-divider">/</span>
        <span class="status-value">Lead Software Engineer</span>
        <span class="status-divider">·</span>
        <span>Side</span>
      </div>

      <div class="branding">
        <div id="branding-placeholder">
          <Logo class="logo" />
        </div>
        <h1>TOAMIG</h1>
      </div>

      <p class="hero-tagline">
        I lead the engineering<br />
        behind <span class="hero-accent">games</span>.
      </p>

      <div class="hero-disciplines" aria-label="Disciplines">
        <span>Gameplay</span>
        <span>Multiplayer</span>
        <span>Tools</span>
        <span>Animation</span>
        <span>AI</span>
        <span>Leadership</span>
      </div>
    </div>
    <div class="scroll-down">
      <a href="#content" aria-label="Scroll to content"></a>
    </div>
  </div>

  <!-- ── Sections ──────────────────────────────────────────────────── -->
  <div id="content">

    <!-- About -->
    <section id="about">
      <div class="container">
        <div class="about-content">
          <img src="/me/IMG_7.JPEG" alt="Miguel Vieira, game engineer and tech lead" class="profile-image" />
          <div class="about-text">
            <div class="section-header">
              <p class="section-eyebrow">
                <span class="num">01</span>
                <span class="sep">·</span>
                <span class="tag">Profile</span>
              </p>
              <h2>The <em>short version</em>.</h2>
            </div>
            <p class="p1">{profile.shortVersion.lead}</p>
            <p class="p3">{profile.shortVersion.body}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">
            <span class="num">02</span>
            <span class="sep">·</span>
            <span class="tag">Career</span>
          </p>
          <h2>Where I've <em>shipped</em>.</h2>
        </div>
        <div class="cards-container">
          {experience.map(e => (
            <a class="extended-card" href={e.href} target="_blank" rel="noopener noreferrer">
              {/* Explicit `current` flag from the admin wins; if undefined, fall
                  back to auto-detecting from the period text for legacy data. */}
              {((e as any).current ?? (e.period?.includes('Present') || e.period?.includes('Ongoing'))) && (
                <span class="current-pill">Current</span>
              )}
              {e.logo
                ? <img src={e.logo} alt={`${e.name} Logo`} class="card-logo" />
                : <div class="card-logo" />
              }
              <div class="card-details">
                <h3>{e.name}</h3>
                <p class="role">{e.role}</p>
                <p class="time-period">{e.period}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Technologies — system graph (echoes the hero constellation) -->
    <section id="technologies">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">
            <span class="num">03</span>
            <span class="sep">·</span>
            <span class="tag">Toolbox</span>
          </p>
          <h2>What I <em>build with</em>.</h2>
        </div>
        <div class="tech-constellation">
          <svg class="tech-edges" aria-hidden="true" preserveAspectRatio="none"></svg>
          <div class="tech-clusters">
            {techCategories.map(cat => (
              <div class="tech-category" data-cat={cat.id}>
                <div class="tech-hub" data-hub={cat.id}>
                  <span class="tech-hub-dot" aria-hidden="true"></span>
                  <span class="tech-hub-label">{cat.name}</span>
                </div>
                <div class="tech-group">
                  {technologies.filter(t => t.category === cat.id && !(t as any).cvOnly).map((t, i) => (
                    <a
                      class="tech-node"
                      data-cat={cat.id}
                      data-node={`${cat.id}-${i}`}
                      href={t.href}
                      title={t.name}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {t.src
                        ? <img class="tech-logo" src={t.src} alt={t.name} onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'tech-label',textContent:this.alt}));" />
                        : <span class="tech-label">{t.name}</span>
                      }
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Education -->
    <section id="education">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">
            <span class="num">04</span>
            <span class="sep">·</span>
            <span class="tag">Studies</span>
          </p>
          <h2>How I <em>got here</em>.</h2>
        </div>
        <div class="cards-container">
          {education.map(e => (
            <a class="extended-card" href={e.href} target="_blank" rel="noopener noreferrer">
              {/* Same explicit-flag-with-fallback rule as experience above. */}
              {((e as any).current ?? (e.period?.includes('Present') || e.period?.includes('Ongoing'))) && (
                <span class="current-pill">Current</span>
              )}
              <img src={e.logo} alt={`${e.name} Logo`} class="card-logo" />
              <div class="card-details">
                <h3>{e.name}</h3>
                <p class="role">{e.role}</p>
                <p class="time-period">{e.period}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">
            <span class="num">05</span>
            <span class="sep">·</span>
            <span class="tag">Showcase</span>
          </p>
          <h2>Selected <em>projects</em>.</h2>
        </div>
        <div class="cards-container">
          {projects.map((p, i) => (
            <a
              class="project-card"
              style={`background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.7)), url('${p.image}')`}
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="project-index">PRJ / {String(i + 1).padStart(2, '0')}</span>
              <div class="project-details">
                <h3>{p.name}</h3>
                <p>{p.desc}</p>
                <span class="project-cta">View project</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Personal Projects -->
    <section id="personal-projects">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">
            <span class="num">06</span>
            <span class="sep">·</span>
            <span class="tag">Personal</span>
          </p>
          <h2>Built <em>for fun</em>.</h2>
        </div>

        <a class="play-card" href="/sesqui/" aria-label="Play Sesqui">
          <div class="play-card-art" aria-hidden="true">
            <div class="sesqui-board">
              {boardCells.map(cell => (
                <div class={`sq ${cell.dark ? 'sq-d' : 'sq-l'}`}>
                  {cell.piece === 'v' && <span class="pc pc-v"></span>}
                  {cell.piece === 'h' && <span class="pc pc-h"></span>}
                </div>
              ))}
            </div>
          </div>
          <div class="play-card-body">
            <p class="play-card-kicker">
              <span class="dot" aria-hidden="true"></span>
              <span>Board game</span>
              <span class="play-card-sep">·</span>
              <span>Playable</span>
            </p>
            <h3>Sesqui</h3>
            <p class="play-card-desc">
              A two-player connection game on an 8×8 board. Black links top to
              bottom, White links left to right. Play a friend, take on four
              tiers of AI, or watch the engines battle it out.
            </p>
            <div class="play-card-tags">
              <span>Strategy</span>
              <span>React</span>
              <span>4 AI levels</span>
            </div>
            <span class="play-card-cta">Play now</span>
          </div>
        </a>
      </div>
    </section>

    <!-- Resume / CV -->
    <ResumeChooser eyebrowNum="07" />

  </div>
</BaseLayout>

<style>
  /* ─── Technologies · system graph ────────────────────────────────────────
     A dark "engine room" section: the tech stack drawn as a node graph that
     reprises the hero constellation. Category hubs are coral anchor nodes;
     each tool is a bright node wired back to its hub, and the hubs chain into
     one spine. Edges are SVG lines measured from layout (transform-immune),
     drawn by the script at the bottom of this file. */
  #technologies {
    position: relative;
    background:
      radial-gradient(ellipse 60% 50% at 15% 0%, rgba(41,128,185,.16) 0%, transparent 60%),
      radial-gradient(ellipse 55% 55% at 85% 100%, rgba(255,138,76,.10) 0%, transparent 60%),
      linear-gradient(180deg, #0a1628 0%, #0d1c38 50%, #07111e 100%);
    overflow: hidden;
  }
  /* Same faint dot grid the heroes use, tying the section to the constellation */
  #technologies::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255,255,255,.045) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
  }

  /* Dark-section header treatment (mirrors the Timeline hero) */
  #technologies .section-eyebrow { color: rgba(255,255,255,.4); }
  #technologies .section-eyebrow .num { color: var(--accent-l); }
  #technologies .section-eyebrow .tag { color: rgba(255,255,255,.85); }
  #technologies .section-eyebrow .sep { color: rgba(255,255,255,.25); }
  #technologies .section-header h2 { color: #fff; }
  #technologies .section-header h2 em {
    background: linear-gradient(180deg, #ffffff 0%, rgba(255,255,255,.78) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  #technologies .section-header h2 em::after { background: var(--accent-l); }

  .tech-constellation {
    position: relative;              /* offsetParent anchor for edge maths */
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
  }
  .tech-edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: visible;
  }
  .tech-edge {
    stroke: rgba(120,170,220,.30);
    stroke-width: 1.2;
    transition: stroke .3s ease, stroke-width .3s ease;
  }
  .tech-edge--spine {
    stroke: rgba(255,138,76,.32);
    stroke-width: 1.4;
    stroke-dasharray: 3 6;
  }
  .tech-edge.lit { stroke: rgba(255,156,96,.9); stroke-width: 1.9; }

  .tech-clusters {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 46px 40px;
  }
  /* Break the grid out of a rigid row so it reads as a scattered constellation */
  .tech-clusters .tech-category:nth-child(even) { margin-top: 44px; }

  .tech-hub {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
  }
  .tech-hub-dot {
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(255,138,76,.14), 0 0 14px rgba(255,138,76,.55);
  }
  .tech-hub-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(255,255,255,.74);
  }

  .tech-group { display: flex; flex-wrap: wrap; gap: 14px; }
  .tech-node {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 62px; height: 62px;
    border-radius: 16px;
    background: rgba(255,255,255,.94);
    border: 1px solid rgba(255,255,255,.5);
    box-shadow:
      0 2px 10px rgba(0,0,0,.3),
      0 0 18px rgba(90,150,210,.20),
      inset 0 1px 0 rgba(255,255,255,.7);
    text-decoration: none;
    transition: transform .25s cubic-bezier(.2,.7,.2,1), box-shadow .25s ease, border-color .25s ease;
  }
  .tech-node:hover,
  .tech-node:focus-visible {
    transform: translateY(-4px) scale(1.04);
    border-color: rgba(255,180,120,.95);
    box-shadow:
      0 10px 26px rgba(0,0,0,.4),
      0 0 26px rgba(255,138,76,.42),
      inset 0 1px 0 rgba(255,255,255,.7);
    outline: none;
  }
  .tech-logo {
    width: 34px; height: 34px;
    object-fit: contain;
    transition: transform .3s ease;
  }
  .tech-node:hover .tech-logo,
  .tech-node:focus-visible .tech-logo { transform: scale(1.12) rotate(3deg); }
  .tech-label {
    font-family: var(--font-mono);
    font-size: 10.5px; font-weight: 700;
    letter-spacing: .04em; text-transform: uppercase;
    color: var(--text-sub);
    text-align: center;
    line-height: 1.1;
    padding: 0 6px;
  }

  /* Clusters fade in place (no vertical slide) so the drawn edges never
     detach from the nodes during the scroll-reveal. */
  .tech-constellation .tech-category.rv { transform: none; }

  @media (prefers-reduced-motion: no-preference) {
    .tech-edges { animation: tech-edges-breathe 6.5s ease-in-out infinite; }
    .tech-edge--spine { animation: tech-spine-flow 9s linear infinite; }
  }
  @keyframes tech-edges-breathe { 0%, 100% { opacity: .72; } 50% { opacity: 1; } }
  @keyframes tech-spine-flow { to { stroke-dashoffset: -90; } }

  @media (max-width: 900px) {
    .tech-clusters { grid-template-columns: repeat(2, 1fr); gap: 38px 30px; }
    .tech-clusters .tech-category:nth-child(even) { margin-top: 0; }
  }
  @media (max-width: 560px) {
    .tech-clusters { grid-template-columns: 1fr; gap: 32px; }
    .tech-node { width: 56px; height: 56px; }
    .tech-logo { width: 30px; height: 30px; }
  }

  /* ─── Personal Projects ──────────────────────────────────────────────── */
  #personal-projects {
    background-color: var(--bg);
    background-image:
      radial-gradient(ellipse 50% 40% at 100% 0%, rgba(255,138,76,.05) 0%, transparent 60%),
      radial-gradient(ellipse 50% 40% at 0% 100%, rgba(41,128,185,.05) 0%, transparent 60%);
  }

  /* Feature card — Sesqui board art + copy, modelled on the About panel */
  .play-card {
    position: relative;
    display: flex;
    align-items: stretch;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    background: linear-gradient(135deg, #fbf6ee 0%, #ffffff 60%);
    border: 1px solid rgba(255,138,76,.14);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    box-shadow:
      0 1px 2px rgba(10,22,40,.04),
      0 12px 28px rgba(10,22,40,.05),
      0 24px 56px rgba(255,138,76,.10);
    transition: transform .35s cubic-bezier(.2,.7,.2,1), box-shadow .35s ease, border-color .35s ease;
  }
  .play-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255,138,76,.4);
    box-shadow:
      0 1px 2px rgba(10,22,40,.04),
      0 16px 40px rgba(10,22,40,.08),
      0 32px 72px rgba(255,138,76,.16);
  }

  /* Art panel — authentic Sesqui "Midnight" palette */
  .play-card-art {
    flex: 0 0 42%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 36px;
    background: radial-gradient(ellipse 80% 70% at 50% 18%, #2c2552 0%, #17172e 55%, #0e0e1c 100%);
  }
  .sesqui-board {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 2px;
    width: min(78%, 240px);
    aspect-ratio: 1;
    padding: 8px;
    border-radius: 10px;
    background: #20203a;
    box-shadow: 0 14px 30px rgba(0,0,0,.45), inset 0 0 0 1px rgba(255,213,74,.10);
    transition: transform .35s cubic-bezier(.2,.7,.2,1);
  }
  .play-card:hover .sesqui-board { transform: scale(1.04) rotate(-1deg); }
  .sq {
    aspect-ratio: 1;
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sq-l { background: #34345a; }
  .sq-d { background: #262648; }
  .pc { width: 68%; height: 68%; border-radius: 50%; }
  .pc-v {
    background: radial-gradient(circle at 35% 30%, #ffe488 0%, #ffd54a 55%, #ecae28 100%);
    box-shadow: 0 1px 2px rgba(0,0,0,.45), 0 0 8px rgba(255,213,74,.45);
  }
  .pc-h {
    background: radial-gradient(circle at 35% 30%, #ffffff 0%, #d7d8e6 70%, #aeb0c6 100%);
    box-shadow: 0 1px 2px rgba(0,0,0,.4);
  }

  /* Copy panel */
  .play-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    padding: clamp(28px, 4vw, 44px);
  }
  .play-card-kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }
  .play-card-kicker .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent-glow);
    animation: status-pulse 2.4s ease-out infinite;
  }
  .play-card-kicker .play-card-sep { opacity: .4; }
  .play-card-body h3 {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: 1.05;
    font-variation-settings: 'opsz' 48, 'wght' 600;
    color: var(--text);
    margin: 0;
  }
  .play-card-desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-sub);
    max-width: 46ch;
    margin: 0;
  }
  .play-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 2px;
  }
  .play-card-tags span {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--text-sub);
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: 100px;
    background: rgba(255,255,255,.6);
  }
  .play-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--accent-d);
    transition: gap .25s ease, color .25s ease;
  }
  .play-card-cta::after {
    content: '→';
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: 0;
  }
  .play-card:hover .play-card-cta { gap: 14px; color: var(--accent); }

  @media (max-width: 768px) {
    .play-card { flex-direction: column; }
    .play-card-art { flex-basis: auto; padding: 32px; }
    .sesqui-board { width: min(60%, 220px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .play-card,
    .sesqui-board,
    .play-card-cta { transition: none; }
    .play-card-kicker .dot { animation: none; }
    .play-card:hover { transform: none; }
    .play-card:hover .sesqui-board { transform: none; }
  }
</style>

<!-- Technologies · system graph — draw the edges wiring each tool node back to
     its category hub, then chain the hubs into one spine. Positions come from
     layout offsets (immune to the scroll-reveal transform), and everything is
     redrawn on resize / font load. Hovering a node or hub lights its wires. -->
<script>
  (() => {
    const stage = document.querySelector<HTMLElement>('.tech-constellation');
    const svg = stage?.querySelector<SVGSVGElement>('.tech-edges');
    if (!stage || !svg) return;

    const NS = 'http://www.w3.org/2000/svg';
    const hubs  = Array.from(stage.querySelectorAll<HTMLElement>('.tech-hub'));
    const nodes = Array.from(stage.querySelectorAll<HTMLElement>('.tech-node'));

    // Centre of an element in stage-local coordinates. Uses offset* (layout
    // position, ignores CSS transforms) so revealed/animating nodes still
    // report their final resting spot.
    const centre = (el: HTMLElement) => {
      let x = el.offsetWidth / 2, y = el.offsetHeight / 2;
      let n: HTMLElement | null = el;
      while (n && n !== stage) { x += n.offsetLeft; y += n.offsetTop; n = n.offsetParent as HTMLElement | null; }
      return { x, y };
    };

    // id -> the SVG lines that should light when that id is hovered
    let wires = new Map<string, SVGLineElement[]>();
    const add = (id: string, ln: SVGLineElement) => {
      (wires.get(id) ?? wires.set(id, []).get(id)!).push(ln);
    };
    const line = (a: {x:number;y:number}, b: {x:number;y:number}, cls: string) => {
      const ln = document.createElementNS(NS, 'line');
      ln.setAttribute('x1', String(a.x)); ln.setAttribute('y1', String(a.y));
      ln.setAttribute('x2', String(b.x)); ln.setAttribute('y2', String(b.y));
      ln.setAttribute('class', cls);
      svg.appendChild(ln);
      return ln;
    };

    function build() {
      const W = stage!.offsetWidth, H = stage!.offsetHeight;
      svg!.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg!.replaceChildren();
      wires = new Map();

      // Branches: each hub dot out to every node in its category.
      for (const hub of hubs) {
        const cat = hub.dataset.hub!;
        const dot = hub.querySelector<HTMLElement>('.tech-hub-dot') ?? hub;
        const hc  = centre(dot);
        for (const nd of nodes) {
          if (nd.dataset.cat !== cat) continue;
          const ln = line(hc, centre(nd), 'tech-edge');
          add('hub:' + cat, ln);
          add('node:' + nd.dataset.node, ln);
        }
      }

      // Spine: chain consecutive hub dots into one system.
      for (let i = 0; i < hubs.length - 1; i++) {
        const a = hubs[i].querySelector<HTMLElement>('.tech-hub-dot') ?? hubs[i];
        const b = hubs[i + 1].querySelector<HTMLElement>('.tech-hub-dot') ?? hubs[i + 1];
        const ln = line(centre(a), centre(b), 'tech-edge tech-edge--spine');
        add('hub:' + hubs[i].dataset.hub, ln);
        add('hub:' + hubs[i + 1].dataset.hub, ln);
      }
    }

    const lit = (id: string, on: boolean) =>
      (wires.get(id) ?? []).forEach(l => l.classList.toggle('lit', on));

    for (const nd of nodes) {
      const id = 'node:' + nd.dataset.node;
      nd.addEventListener('pointerenter', () => lit(id, true));
      nd.addEventListener('pointerleave', () => lit(id, false));
      nd.addEventListener('focus', () => lit(id, true));
      nd.addEventListener('blur',  () => lit(id, false));
    }
    for (const hub of hubs) {
      const id = 'hub:' + hub.dataset.hub;
      hub.addEventListener('pointerenter', () => lit(id, true));
      hub.addEventListener('pointerleave', () => lit(id, false));
    }

    build();
    let t = 0;
    addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(build, 120); }, { passive: true });
    if ((document as any).fonts?.ready) (document as any).fonts.ready.then(build);
  })();
</script>

