---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import education    from '../data/education.json';
import experience   from '../data/experience.json';
import technologies from '../data/technologies.json';
import projects     from '../data/projects.json';
---
<BaseLayout
  title="Toamig"
  description="Discover my projects, skills, and experience."
  ogUrl="https://toamig.github.io/"
>
  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <div class="front-page">
    <div class="front-page-content">
      <div class="branding">
        <div id="branding-placeholder">
          <Logo class="logo" />
        </div>
        <h1>TOAMIG</h1>
      </div>
      <h1>Welcome to my <span class="strong-text">Game Developer</span> Portfolio</h1>
      <p>Discover my projects, skills, and experience</p>
    </div>
    <div class="scroll-down">
      <a href="#content"></a>
    </div>
  </div>

  <!-- ── Sections ──────────────────────────────────────────────────── -->
  <div id="content">

    <!-- About -->
    <section id="about">
      <div class="container">
        <div class="about-content">
          <img src="/me/IMG_7.JPEG" alt="Profile Picture" class="profile-image" />
          <div class="about-text">
            <h2>Summary</h2>
            <span class="underline"></span>
            <p class="p1">My name is Miguel "Toamig" Vieira, and I'm a software engineer specialized in game development and interactive systems.</p>
            <p class="p3">My experience spans nearly every area of game programming, including Gameplay, Multiplayer, Tools, Animation, and AI.</p>
            <p class="p2">Currently I'm working as a Lead Software Engineer at Flama Craftworks, where I'm responsible for the gameplay development of the Timefront project.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience">
      <div class="container">
        <h2>Work Experience</h2>
        <span class="underline"></span>
        <div class="cards-container">
          {experience.map(e => (
            <a class="extended-card" href={e.href} target="_blank" rel="noopener noreferrer">
              {e.logo
                ? <img src={e.logo} alt={`${e.name} Logo`} class="card-logo" />
                : <div class="card-logo" />
              }
              <div class="card-details">
                <h3>{e.name}</h3>
                <p class="role">{e.role}</p>
                <p class="time-period">{e.period}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Technologies -->
    <section id="technologies">
      <div class="container">
        <h2>Professional Proficiency</h2>
        <span class="underline"></span>
        <div class="tech-grid">
          {technologies.map(t => (
            <div class="tech-card" title={t.name}>
              <img class="tech-logo" src={t.src} alt={t.name} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Education -->
    <section id="education">
      <div class="container">
        <h2>Education</h2>
        <span class="underline"></span>
        <div class="cards-container">
          {education.map(e => (
            <a class="extended-card" href={e.href} target="_blank" rel="noopener noreferrer">
              <img src={e.logo} alt={`${e.name} Logo`} class="card-logo" />
              <div class="card-details">
                <h3>{e.name}</h3>
                <p class="role">{e.role}</p>
                <p class="time-period">{e.period}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects">
      <div class="container">
        <h2>Professional Projects</h2>
        <span class="underline"></span>
        <div class="cards-container">
          {projects.map(p => (
            <a
              class="project-card"
              style={`background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.7)), url('${p.image}')`}
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="project-details">
                <h3>{p.name}</h3>
                <p>{p.desc}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

