---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import education    from '../data/education.json';
import experience   from '../data/experience.json';
import technologies from '../data/technologies.json';
import projects     from '../data/projects.json';
---
<BaseLayout
  title="Toamig"
  description="Discover my projects, skills, and experience."
  ogUrl="https://toamig.github.io/"
  ogImage="https://migueltechlead.pt/og/home.png"
  ogImageWidth={1200}
  ogImageHeight={630}
>
  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <div class="front-page">
    <div class="front-page-content">
      <div class="hero-status" aria-label="Current role">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="status-key">CURRENT</span>
        <span class="status-divider">/</span>
        <span class="status-value">Lead Software Engineer</span>
        <span class="status-divider">·</span>
        <span>Flama Craftworks</span>
      </div>

      <div class="branding">
        <div id="branding-placeholder">
          <Logo class="logo" />
        </div>
        <h1>TOAMIG</h1>
      </div>

      <p class="hero-tagline">
        I lead the engineering<br />
        behind <span class="hero-accent">games</span>.
      </p>

      <div class="hero-disciplines" aria-label="Disciplines">
        <span>Gameplay</span>
        <span>Multiplayer</span>
        <span>Tools</span>
        <span>Animation</span>
        <span>AI</span>
        <span>Leadership</span>
      </div>
    </div>
    <div class="scroll-down">
      <a href="#content" aria-label="Scroll to content"></a>
    </div>
  </div>

  <!-- ── Sections ──────────────────────────────────────────────────── -->
  <div id="content">

    <!-- About -->
    <section id="about">
      <div class="container">
        <div class="about-content">
          <img src="/me/IMG_7.JPEG" alt="Profile Picture" class="profile-image" />
          <div class="about-text">
            <div class="section-header">
              <p class="section-eyebrow">
                <span class="num">01</span>
                <span class="sep">—</span>
                <span class="tag">Profile</span>
              </p>
              <h2>The <em>short version</em>.</h2>
            </div>
            <p class="p1">Game engineer turned tech lead — building gameplay, tools, and the engineering teams that ship them.</p>
            <p class="p3">Five years across studios shipping gameplay, multiplayer, tools, animation, and AI systems on PC, console, and VR — currently leading engineering at Flama Craftworks on Timefront, after a stretch as Tools Lead at Saber Interactive.</p>
            <p class="p2">I care about the systems behind the systems — the tooling, patterns, and tech direction that let a team ship without burning out.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">
            <span class="num">02</span>
            <span class="sep">—</span>
            <span class="tag">Career</span>
          </p>
          <h2>Where I've <em>shipped</em>.</h2>
        </div>
        <div class="cards-container">
          {experience.map(e => (
            <a class="extended-card" href={e.href} target="_blank" rel="noopener noreferrer">
              {(e.period?.includes('Present') || e.period?.includes('Ongoing')) && (
                <span class="current-pill">Current</span>
              )}
              {e.logo
                ? <img src={e.logo} alt={`${e.name} Logo`} class="card-logo" />
                : <div class="card-logo" />
              }
              <div class="card-details">
                <h3>{e.name}</h3>
                <p class="role">{e.role}</p>
                <p class="time-period">{e.period}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Technologies -->
    <section id="technologies">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">
            <span class="num">03</span>
            <span class="sep">—</span>
            <span class="tag">Toolbox</span>
          </p>
          <h2>What I <em>build with</em>.</h2>
        </div>
        <div class="tech-grid">
          {(['Languages', 'Engines', 'Art Tools', 'Version Control'] as const).map(cat => (
            <div class="tech-category">
              <span class="tech-category-label">{cat}</span>
              <div class="tech-group">
                {technologies.filter(t => t.category === cat).map(t => (
                  <a class="tech-card" href={t.href} title={t.name} target="_blank" rel="noopener noreferrer">
                    <img class="tech-logo" src={t.src} alt={t.name} />
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Education -->
    <section id="education">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">
            <span class="num">04</span>
            <span class="sep">—</span>
            <span class="tag">Studies</span>
          </p>
          <h2>How I <em>got here</em>.</h2>
        </div>
        <div class="cards-container">
          {education.map(e => (
            <a class="extended-card" href={e.href} target="_blank" rel="noopener noreferrer">
              {(e.period?.includes('Present') || e.period?.includes('Ongoing')) && (
                <span class="current-pill">Current</span>
              )}
              <img src={e.logo} alt={`${e.name} Logo`} class="card-logo" />
              <div class="card-details">
                <h3>{e.name}</h3>
                <p class="role">{e.role}</p>
                <p class="time-period">{e.period}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">
            <span class="num">05</span>
            <span class="sep">—</span>
            <span class="tag">Showcase</span>
          </p>
          <h2>Selected <em>projects</em>.</h2>
        </div>
        <div class="cards-container">
          {projects.map((p, i) => (
            <a
              class="project-card"
              style={`background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.7)), url('${p.image}')`}
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="project-index">PRJ / {String(i + 1).padStart(2, '0')}</span>
              <div class="project-details">
                <h3>{p.name}</h3>
                <p>{p.desc}</p>
                <span class="project-cta">View project</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

