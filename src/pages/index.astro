---
import BaseLayout        from '../layouts/BaseLayout.astro';
import Logo              from '../components/Logo.astro';
import HeroConstellation from '../components/HeroConstellation.astro';
import education      from '../data/education.json';
import experience     from '../data/experience.json';
import technologies   from '../data/technologies.json';
import techCategories from '../data/techCategories.json';
import projects       from '../data/projects.json';
import ventures       from '../data/ventures.json';
import pluginsData    from '../data/plugins.json';
import profile        from '../data/profile.json';
import cvExtras       from '../data/cvExtras.json';

const contact = cvExtras.contact;

// cvExtras stores bare hostnames; the markup needs absolute URLs.
const absolute = (u: string) => (/^https?:/i.test(u) ? u : `https://${u}`);

// The social links live here rather than in the site footer: named links in
// the section about reaching me read far better to a recruiter than unlabelled
// icons in page chrome, and this way each link has exactly one home.
const contactChannels = [
  { label: 'LinkedIn',  href: absolute(contact.linkedin)  },
  { label: 'GitHub',    href: absolute(contact.github)    },
  { label: 'itch.io',   href: absolute(contact.itch)      },
  { label: 'Instagram', href: absolute(contact.instagram) },
];

// Only real off-site URLs become links. Some experience entries carry '' or '/'
// as a placeholder, and those should not render a dead affordance.
const isExternal = (u?: string) => !!u && /^https?:/i.test(u);

// Ventures marked `hidden` are parked, not deleted: Sesqui has no /sesqui route
// on this site yet, so linking it would 404. Flip `hidden` once it deploys.
const shownVentures = ventures.filter(v => !v.hidden);
const featuredVenture = shownVentures.find(v => v.featured);
const otherVentures   = shownVentures.filter(v => !v.featured);

// Derived so the plugins card can never drift out of sync with plugins.json.
const visiblePlugins = pluginsData.filter(p => !p.hidden);
const livePluginCount = visiblePlugins.filter(p => p.status === 'live').length;
const pluginStat = `${visiblePlugins.length} plugins · ${livePluginCount} live on Fab`;

// ── Polyglyph hero mock ───────────────────────────────────────────────────
// Redrawn from the product's own landing page rather than its dashboard. The
// personality there is the brand glyph field (six writing systems, straight
// from frontend/src/lib/glyphs.ts) sitting behind one line of game prose that
// resolves into a new language. The string, the locales, the drafting model
// and the status colours are all the product's own.
const PG_SOURCE = 'The dragon awaits beyond the gate.';
const PG_TARGETS = [
  { code: 'de',    text: 'Der Drache wartet jenseits des Tors.', status: 'approved' },
  { code: 'ja',    text: '竜は門の向こうで待っている。',              status: 'approved' },
  { code: 'fr',    text: 'Le dragon attend au-delà de la porte.', status: 'approved' },
  { code: 'pt-BR', text: 'O dragão aguarda além do portão.',      status: 'review'   },
  { code: 'ko',    text: '용은 문 너머에서 기다린다.',                status: 'review'   },
];

// The brand's alphabet: poly + glyph, as actual characters. Six writing systems
// evenly weighted so no one script dominates the field.
const PG_GLYPH_CHARS = [
  'Ω', 'Δ', 'Λ', 'Σ', 'Φ', 'Ψ', 'Ξ',
  'Ж', 'Д', 'Я', 'Б', 'Ф', 'Э', 'Ч',
  'É', 'Ü', 'Ñ', 'Ç', 'Ø', 'Å', 'Æ',
  'あ', 'さ', 'ゆ', 'ア', 'ネ', '語', '字',
  '한', '글', '어', '문', '말', '사', '랑',
  'א', 'ש', 'ל', 'מ', 'ת', 'נ', 'ר',
];

// The product's own deterministic PRNG, so the scatter is identical on every
// build instead of reshuffling between deploys.
function pgSeeded(seed: number): () => number {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// A jittered grid rather than pure randomness, so the field reads as evenly
// textured without ever looking tiled.
const pgGlyphs = (() => {
  const rand = pgSeeded(20260720);
  const cols = 6;
  const rows = 6;
  return Array.from({ length: cols * rows }, (_, i) => ({
    char:    PG_GLYPH_CHARS[Math.floor(rand() * PG_GLYPH_CHARS.length)],
    x:       ((i % cols) + 0.5) * (100 / cols) + (rand() - 0.5) * 12,
    y:       (Math.floor(i / cols) + 0.5) * (100 / rows) + (rand() - 0.5) * 12,
    size:    11 + rand() * 18,
    opacity: (0.07 + rand() * 0.13).toFixed(3),
    rotate:  ((rand() - 0.5) * 16).toFixed(1),
    pulses:  rand() < 0.25,
    delay:   (rand() * 11).toFixed(2),
  }));
})();
---
<BaseLayout
  title="Miguel Vieira (Toamig) · Game Engineer & Tech Lead"
  description={profile.shortVersion.lead}
  ogUrl="https://toamig.com/"
  ogImage="https://toamig.com/og/home.png?v=20260817-4"
  ogImageAlt="Miguel Vieira (Toamig), game engineer and tech lead"
  ogImageWidth={1200}
  ogImageHeight={630}
>
  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <div class="front-page">
    <HeroConstellation />
    <div class="front-page-content">
      <div class="hero-status" aria-label="Current role">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="status-key">CURRENT</span>
        <span class="status-divider">/</span>
        <span class="status-value">Lead Software Engineer</span>
        <span class="status-divider">·</span>
        <span>Side</span>
      </div>

      <div class="branding">
        <div id="branding-placeholder">
          <Logo class="logo" />
        </div>
        <h1>TOAMIG</h1>
      </div>

      <p class="hero-tagline">
        I lead the engineering<br />
        behind <span class="hero-accent">games</span>.
      </p>

      <div class="hero-disciplines" aria-label="Disciplines">
        <span>Gameplay</span>
        <span>Multiplayer</span>
        <span>Tools</span>
        <span>Animation</span>
        <span>AI</span>
        <span>Leadership</span>
      </div>

      <div class="hero-actions">
        <a class="hero-btn hero-btn-primary" href="/cv">View CV</a>
        <a class="hero-btn hero-btn-ghost" href="#contact">Get in touch</a>
      </div>
    </div>
    <div class="scroll-down">
      <a href="#content" aria-label="Scroll to content"></a>
    </div>
  </div>

  <!-- ── Sections ──────────────────────────────────────────────────── -->
  <div id="content">

    <!-- 01 · Profile -->
    <section id="about">
      <div class="container">
        <div class="about-content">
          <img src="/me/IMG_7.JPEG" alt="Miguel Vieira, game engineer and tech lead" class="profile-image" />
          <div class="about-text">
            <div class="section-header">
              <p class="section-eyebrow">
                <span class="num">01</span>
                <span class="sep">·</span>
                <span class="tag">Profile</span>
              </p>
              <h2>The <em>short version</em>.</h2>
            </div>
            <p class="p1">{profile.shortVersion.lead}</p>
            <p class="p3">{profile.shortVersion.body}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 · Career -->
    <section id="experience">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">
            <span class="num">02</span>
            <span class="sep">·</span>
            <span class="tag">Career</span>
          </p>
          <h2>Where I've <em>shipped</em>.</h2>
        </div>
        <div class="role-grid">
          {experience.map(e => (
            <div class="role-card">
              <div class="role-inner">

                <div class="role-face role-front">
                  {/* Explicit `current` flag from the admin wins; if undefined, fall
                      back to auto-detecting from the period text for legacy data. */}
                  {((e as any).current ?? (e.period?.includes('Present') || e.period?.includes('Ongoing'))) && (
                    <span class="current-pill">Current</span>
                  )}
                  {e.logo
                    ? <img src={e.logo} alt={`${e.name} logo`} class="role-logo" />
                    : <div class="role-logo role-logo-empty" aria-hidden="true">{e.name.charAt(0)}</div>
                  }
                  <h3>{e.name}</h3>
                  <p class="role-title">{e.role}</p>
                  <p class="role-period">{e.period}</p>
                  <button class="role-toggle" data-role-toggle aria-expanded="false">
                    <span>What I did</span>
                  </button>
                </div>

                <div class="role-face role-back" aria-hidden="true">
                  <p class="role-back-head">{e.name}</p>
                  <ul class="role-bullets">
                    {e.bullets?.map(b => <li>{b}</li>)}
                  </ul>
                  <div class="role-back-foot">
                    {isExternal(e.href)
                      ? <a class="role-link" href={e.href} target="_blank" rel="noopener noreferrer">Company site</a>
                      : <span></span>
                    }
                    <button class="role-toggle role-toggle-back" data-role-toggle aria-expanded="false">
                      <span>Back</span>
                    </button>
                  </div>
                </div>

              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 03 · Showcase -->
    <section id="projects">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">
            <span class="num">03</span>
            <span class="sep">·</span>
            <span class="tag">Showcase</span>
          </p>
          <h2>Games I've <em>worked on</em>.</h2>
        </div>
        <div class="cards-container">
          {projects.map((p, i) => (
            <a
              class="project-card"
              style={`background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.7)), url('${p.image}')`}
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="project-index">PRJ / {String(i + 1).padStart(2, '0')}</span>
              <div class="project-details">
                {p.role && <p class="project-role">{p.role}</p>}
                <h3>{p.name}</h3>
                <p>{p.desc}</p>
                <span class="project-cta">View project</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 04 · Building -->
    <section id="building">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">
            <span class="num">04</span>
            <span class="sep">·</span>
            <span class="tag">Building</span>
          </p>
          <h2>What I'm <em>building</em>.</h2>
        </div>

        {featuredVenture && (
          <a
            class="venture-hero"
            href={featuredVenture.href}
            target={featuredVenture.external ? '_blank' : null}
            rel={featuredVenture.external ? 'noopener noreferrer' : null}
          >
            <div class="venture-hero-art" aria-hidden="true">
              <div class="pg-stage">
                <div class="pg-field">
                  {pgGlyphs.map(g => (
                    <span
                      class={`pg-glyph${g.pulses ? ' is-pulsing' : ''}`}
                      style={`left:${g.x}%;top:${g.y}%;font-size:${g.size}px;--o:${g.opacity};--rot:${g.rotate}deg;animation-delay:${g.delay}s`}
                    >{g.char}</span>
                  ))}
                </div>

                <div class="pg-card">
                  <div class="pg-card-head">
                    <span class="pg-key">quest.dragon_intro</span>
                    <span class="pg-live"><i></i>translating</span>
                  </div>

                  <p class="pg-label">source · en</p>
                  <p class="pg-source">{PG_SOURCE}</p>

                  <div class="pg-target">
                    <div class="pg-target-head">
                      <span class="pg-code" data-pg-code>{PG_TARGETS[0].code}</span>
                      <span class="pg-status is-approved" data-pg-status>approved</span>
                    </div>
                    <p class="pg-line" data-pg-line lang="de"></p>
                    <p class="pg-drafted">drafted · Claude Sonnet 5</p>
                  </div>

                  <div class="pg-progress-head">
                    <span>9 languages</span>
                    <span class="pg-approved">6 approved · human sign-off</span>
                  </div>
                  <div class="pg-bar"><i class="pg-bar-a"></i><i class="pg-bar-r"></i></div>
                </div>
              </div>
            </div>
            <div class="venture-hero-body">
              <p class="venture-kicker">
                <span class="dot" aria-hidden="true"></span>
                <span>{featuredVenture.kicker}</span>
                <span class="venture-sep">·</span>
                <span>{featuredVenture.state}</span>
              </p>
              <h3>{featuredVenture.name}</h3>
              <p class="venture-role">{featuredVenture.role}</p>
              <p class="venture-desc">{featuredVenture.desc}</p>
              <div class="venture-tags">
                {featuredVenture.tags.map(t => <span>{t}</span>)}
              </div>
              <span class="venture-cta">{featuredVenture.cta}</span>
            </div>
          </a>
        )}

        <script type="application/json" id="pg-targets" set:html={JSON.stringify(PG_TARGETS)}></script>

        <div class="venture-grid">
          {otherVentures.map(v => (
            <a
              class="venture-card"
              href={v.href}
              target={v.external ? '_blank' : null}
              rel={v.external ? 'noopener noreferrer' : null}
            >
              <p class="venture-kicker">
                <span>{v.kicker}</span>
                <span class="venture-sep">·</span>
                <span>{v.id === 'plugins' ? pluginStat : v.state}</span>
              </p>
              <h3>{v.name}</h3>
              <p class="venture-desc">{v.desc}</p>
              <div class="venture-tags">
                {v.tags.map(t => <span>{t}</span>)}
              </div>
              <span class="venture-cta">{v.cta}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 05 · Toolbox -->
    <section id="technologies">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">
            <span class="num">05</span>
            <span class="sep">·</span>
            <span class="tag">Toolbox</span>
          </p>
          <h2>What I <em>build with</em>.</h2>
        </div>
        <div class="tech-grid">
          {techCategories.map(cat => (
            <div class="tech-category">
              <span class="tech-category-label">{cat.name}</span>
              <div class="tech-group">
                {technologies.filter(t => t.category === cat.id && !(t as any).cvOnly).map(t => (
                  <a class="tech-card" href={t.href} title={t.name} target="_blank" rel="noopener noreferrer">
                    {t.src
                      ? <img class="tech-logo" src={t.src} alt={t.name} onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'tech-label',textContent:this.alt}));" />
                      : <span class="tech-label">{t.name}</span>
                    }
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 06 · Studies -->
    <section id="education">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow">
            <span class="num">06</span>
            <span class="sep">·</span>
            <span class="tag">Studies</span>
          </p>
          <h2>How I <em>got here</em>.</h2>
        </div>
        <div class="study-grid">
          {education.map(e => (
            <a class="study-card" href={e.href} target="_blank" rel="noopener noreferrer">
              <img src={e.logo} alt={`${e.name} logo`} class="study-logo" />
              <div class="study-details">
                <h3>{e.name}</h3>
                <p class="study-role">{e.role}</p>
              </div>
              <span class="study-period">{e.period}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 07 · Contact -->
    <section id="contact">
      <div class="container">
        <div class="contact-panel">
          <div class="section-header">
            <p class="section-eyebrow">
              <span class="num">07</span>
              <span class="sep">·</span>
              <span class="tag">Contact</span>
            </p>
            <h2>Let's <em>talk</em>.</h2>
          </div>
          <p class="contact-lede">
            Open to engineering leadership roles, contract Unreal work, and studio
            consulting. The fastest way to reach me is email.
          </p>
          <div class="contact-actions">
            <a class="contact-btn contact-btn-primary" href={`mailto:${contact.email}`}>Email me</a>
            <a class="contact-btn contact-btn-ghost" href="/cv">View CV</a>
          </div>
          <div class="contact-channels">
            {contactChannels.map(c => (
              <a href={c.href} target="_blank" rel="noopener noreferrer">{c.label}</a>
            ))}
          </div>
          <div class="contact-meta">
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
            <span class="contact-meta-sep" aria-hidden="true">·</span>
            <span class="contact-location">{contact.location}</span>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  // Career cards flip to their reverse rather than growing, so opening one
  // never reflows the grid around it. Both faces stay in the DOM; aria-hidden
  // and pointer-events follow the flip so only the visible face is reachable.
  document.querySelectorAll<HTMLElement>('.role-card').forEach(card => {
    const toggles = card.querySelectorAll<HTMLButtonElement>('[data-role-toggle]');
    const front   = card.querySelector<HTMLElement>('.role-front');
    const back    = card.querySelector<HTMLElement>('.role-back');
    let focusRaf = 0;

    // The incoming face is visibility:hidden until the card passes edge-on (see
    // .role-face in global.css), and a hidden element cannot take focus. Watch
    // for that swap rather than timing it: the delay is tied to the flip's
    // easing, a frame can run long, and reduced motion drops the transition
    // entirely, in which case the very first check already passes.
    const focusFace = (flipped: boolean) => {
      const face = flipped ? back : front;
      const btn = card.querySelector<HTMLButtonElement>(
        flipped ? '.role-toggle-back' : '.role-front .role-toggle');
      if (!face || !btn) return;
      cancelAnimationFrame(focusRaf);
      const deadline = performance.now() + 900;
      const tick = () => {
        const active = document.activeElement;
        // Focus moved outside the card: the reader is somewhere else now and
        // pulling it back would be worse than leaving it.
        if (active && active !== document.body && !card.contains(active)) return;
        if (getComputedStyle(face).visibility === 'visible') { btn.focus(); return; }
        if (performance.now() < deadline) focusRaf = requestAnimationFrame(tick);
      };
      tick();
    };

    const setFlipped = (flipped: boolean) => {
      card.classList.toggle('is-flipped', flipped);
      toggles.forEach(b => b.setAttribute('aria-expanded', String(flipped)));
      front?.setAttribute('aria-hidden', String(flipped));
      back?.setAttribute('aria-hidden', String(!flipped));
      // Move focus with the card so keyboard users land on the face they just
      // revealed instead of a button that just rotated out of view.
      focusFace(flipped);
    };

    toggles.forEach(btn => btn.addEventListener('click', () => {
      setFlipped(!card.classList.contains('is-flipped'));
    }));

    card.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && card.classList.contains('is-flipped')) setFlipped(false);
    });
  });

  // Mark the cards whose history overruns the face, so only those show the
  // scroll fade. Measured after fonts settle, since line wrapping (and so the
  // list height) changes once the display face swaps in.
  const markOverflow = () => {
    document.querySelectorAll<HTMLElement>('.role-card').forEach(card => {
      const list = card.querySelector('.role-bullets');
      if (!list) return;
      card.classList.toggle('has-more', list.scrollHeight > list.clientHeight + 1);
    });
  };
  document.fonts?.ready.then(markOverflow) ?? markOverflow();
  window.addEventListener('resize', markOverflow);

  // Polyglyph card: cycle the target locale, letting each translation resolve
  // into place word by word the way the product hero does. Characters rather
  // than words for scripts that do not space them, so ja and ko settle at a
  // sensible rhythm instead of arriving as one block.
  (() => {
    const data = document.getElementById('pg-targets');
    const line = document.querySelector<HTMLElement>('[data-pg-line]');
    const code = document.querySelector<HTMLElement>('[data-pg-code]');
    const status = document.querySelector<HTMLElement>('[data-pg-status]');
    if (!data?.textContent || !line || !code || !status) return;

    const targets = JSON.parse(data.textContent) as {
      code: string; text: string; status: string;
    }[];
    if (!targets.length) return;

    const paint = (i: number) => {
      const t = targets[i];
      code.textContent = t.code;
      status.textContent = t.status === 'approved' ? 'approved' : 'in review';
      status.className = 'pg-status ' + (t.status === 'approved' ? 'is-approved' : 'is-review');

      line.lang = t.code;
      line.textContent = '';
      const spaced = t.text.includes(' ');
      const parts = spaced ? t.text.split(' ') : [...t.text];
      parts.forEach((part, n) => {
        const span = document.createElement('span');
        span.className = 'pg-word';
        span.textContent = part;
        span.style.animationDelay = (n * (spaced ? 78 : 40)) + 'ms';
        line.appendChild(span);
        if (spaced && n < parts.length - 1) line.appendChild(document.createTextNode(' '));
      });
    };

    paint(0);
    // The cycle is decoration, not information, so it stays put when the
    // visitor has asked for less motion.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let i = 0;
    setInterval(() => { i = (i + 1) % targets.length; paint(i); }, 2600);
  })();
</script>
