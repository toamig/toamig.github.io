---
// One page per Timeline moment, laid out like a /work/ page (styles/work.css)
// so a moment opens the way a project does: the card's photo grows into the
// banner (styles/work-transition.css). Moments without a photo get a plain
// banner in their tag's colour. Moment-only rules are in styles/timeline.css.
import BaseLayout  from '../../layouts/BaseLayout.astro';
import PhotoViewer from '../../components/PhotoViewer.astro';
import { moments, type Moment } from '../../data/timeline';
import '../../styles/work.css';
import '../../styles/timeline.css';
import '../../styles/work-transition.css';

export function getStaticPaths() {
  return moments.map(m => ({ params: { id: m.id }, props: { moment: m } }));
}

const { moment: m } = Astro.props as { moment: Moment };

const SITE = 'https://toamig.com';
const pageUrl = `${SITE}/Timeline/${encodeURIComponent(m.id)}/`;
// OG image: the moment's first photo, otherwise the build-time card.
const ogImage = m.images[0] && /^\//.test(m.images[0])
  ? `${SITE}${m.images[0]}`
  : `${SITE}/og/${encodeURIComponent(m.id)}.png`;

// Older and newer neighbours, in the Timeline's own order.
const at = moments.findIndex(x => x.id === m.id);
const newer = moments[at - 1];
const older = moments[at + 1];
// The banner shows the first photo; the gallery shows the rest, each opening
// the photo viewer at its place in the full set.
const gallery = m.photos.map((p, i) => ({ ...p, i })).slice(1);
const color = m.tags[0]?.color ?? '#64748b';
const shareText = `${m.title}${m.description ? ': ' + m.description : ''}`;
---
<BaseLayout
  title={`${m.title} · Toamig`}
  description={m.description || m.title}
  ogUrl={pageUrl}
  ogImage={ogImage}
  ogType="article"
  ogImageWidth={m.images.length ? undefined : 1200}
  ogImageHeight={m.images.length ? undefined : 630}
  bodyClass="theme-dark work-page moment-page"
>
  <main class="wp">
    <div class={`wp-hero${m.banner ? '' : ' is-plain'}`} style={`--dot:${color}`}>
      {m.banner ? (
        <div class="wp-art" style={`view-transition-name:moment-${m.id};view-transition-class:work-art`}>
          {/* The card's thumbnail, already cached, sits under the banner so the
              morph from the card has a picture from its first frame. */}
          {m.thumb && <img src={m.thumb} alt="" aria-hidden="true" />}
          <img src={m.banner} alt={m.title} decoding="async" fetchpriority="high" data-pv-source="0" />
        </div>
      ) : (
        <div class="mp-plain" aria-hidden="true"></div>
      )}
      <div class="wp-bar" style="view-transition-name:work-back">
        <a class="wp-back" href={`/Timeline/#t-${m.id}`}>All moments</a>
        {m.photos.length > 0 && (
          <button class="wp-back mp-photos" type="button" data-pv-open="0">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" /></svg>
            {m.photos.length === 1 ? 'View photo' : `${m.photos.length} photos`}
          </button>
        )}
      </div>
    </div>

    <div class="wp-wrap">
      <div class="wp-intro" style="view-transition-name:work-intro">
        <p class="wp-shelf">
          <time datetime={m.date}>{m.longDate}</time>
          <span class="mp-tags">
            {m.tags.map(t => <span class="tl-tag" style={`--dot:${t.color}`}><i class="hn-dot" aria-hidden="true"></i>{t.name}</span>)}
          </span>
        </p>
        <h1 class="wp-title">{m.title}</h1>
        {m.description && <p class="wp-line">{m.description}</p>}
        <div class="mp-share" aria-label="Share this moment">
          <button type="button" class="hn-chip" data-share="native" hidden>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
            Share
          </button>
          <a class="hn-chip" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452z"/></svg>
            LinkedIn
          </a>
          <a class="hn-chip" href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(shareText)}`} target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            X
          </a>
          <button type="button" class="hn-chip" data-share="copy">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
            <span data-copy-label aria-live="polite">Copy link</span>
          </button>
        </div>
      </div>

      {(m.paragraphs.length > 0 || gallery.length > 0 || m.links.length > 0 || m.documents.length > 0) && (
        <div class="wp-body mp-body">
          {m.paragraphs.map(p => <p class="wp-desc">{p}</p>)}

          {gallery.length > 0 && (
            <div class="mp-gallery">
              {gallery.map(p => (
                <a href={p.src} target="_blank" rel="noopener noreferrer" data-pv-open={p.i} aria-label={`Open ${p.alt}`}>
                  <img src={p.thumb} alt={p.alt} loading="lazy" decoding="async" data-pv-source={p.i} />
                </a>
              ))}
            </div>
          )}

          {(m.links.length > 0 || m.documents.length > 0) && (
            <div class="mp-links">
              {m.documents.map(d => <a class="hn-chip" href={d.url} target="_blank" rel="noopener noreferrer">{d.label}</a>)}
              {m.links.map(l => <a class="hn-chip" href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
            </div>
          )}
        </div>
      )}

      <nav class="wp-more" aria-label="More moments">
        {[newer, older].map((n, i) => n ? (
          <a class="wp-next" href={`/Timeline/${n.id}/`}>
            {n.thumb && <img src={n.thumb} alt="" loading="lazy" decoding="async" />}
            <span class="wp-next-dir">{i === 0 ? 'Newer' : 'Older'}</span>
            <span class="wp-next-name">{n.title}</span>
          </a>
        ) : <span></span>)}
      </nav>
    </div>
  </main>
  <PhotoViewer photos={m.photos} title={m.title} />
</BaseLayout>

<script>
  // Native share where the platform has it, and copy-the-link everywhere.
  const native = document.querySelector<HTMLButtonElement>('[data-share="native"]');
  if (native && typeof navigator.share === 'function') {
    native.hidden = false;
    native.addEventListener('click', async () => {
      try { await navigator.share({ title: document.title, url: location.href }); } catch { /* dismissed */ }
    });
  }
  const copy = document.querySelector<HTMLButtonElement>('[data-share="copy"]');
  const label = copy?.querySelector<HTMLElement>('[data-copy-label]');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.href.split('#')[0]);
      if (label) label.textContent = 'Copied';
    } catch {
      if (label) label.textContent = 'Select the address to copy';
    }
    setTimeout(() => { if (label) label.textContent = 'Copy link'; }, 2000);
  });
</script>
