---
interface Plugin {
  name: string;
  tagline: string;
  version: string;
  logo: string;
  cover: string;
  accent: string;
  accentLight: string;
  status: 'live' | 'pre-launch' | 'in-development' | 'coming-soon';
  docsUrl: string | null;
  fabUrl: string | null;
}

const STATUS_ORDER: Record<Plugin['status'], number> = {
  'live': 0,
  'pre-launch': 1,
  'in-development': 2,
  'coming-soon': 3,
};

const plugins: Plugin[] = ([
  {
    name: 'Cascade Combat System',
    tagline: 'Branching combo trees built on GAS — input-agnostic, damage-agnostic, and multiplayer-ready without writing replication code.',
    version: '1.0',
    logo: '/plugins/cascadecombatsystem/CascadeCombatSystem.png',
    cover: '/plugins/cascadecombatsystem/CascadeCombatSystemCover.png',
    accent: '#d4600a',
    accentLight: '#f07820',
    status: 'pre-launch',
    docsUrl: '/Plugins/CascadeCombatSystem',
    fabUrl: null,
  },
  {
    name: 'WorldSweep',
    tagline: 'Batch scripting for any UE5 world — sweep World Partition, Streaming Levels, or flat maps cell by cell.',
    version: '1.0',
    logo: '/plugins/worldsweep/WorldSweep.png',
    cover: '/plugins/worldsweep/WorldSweepCover.png',
    accent: '#0e9fd4',
    accentLight: '#22d4f8',
    status: 'pre-launch',
    docsUrl: '/Plugins/WorldSweep',
    fabUrl: null,
  },
  {
    name: 'StoryGraph',
    tagline: 'Modular dialog and quest system with a graph editor — multiplayer-ready and extensible per project.',
    version: '1.0',
    logo: '/plugins/storygraph/StoryGraph.png',
    cover: '/plugins/storygraph/StoryGraphCover.png',
    accent: '#6d28d9',
    accentLight: '#c084fc',
    status: 'in-development',
    docsUrl: null,
    fabUrl: null,
  },
  {
    name: 'GearFlow',
    tagline: 'Modular inventory, crafting & equipment for UE5 — fragment-free data assets, tag-driven slots, multiplayer-ready out of the box.',
    version: '1.0',
    logo: '/plugins/gearflow/GearFlow.png',
    cover: '/plugins/gearflow/GearFlowCover.png',
    accent: '#c47c0a',
    accentLight: '#f0aa22',
    status: 'in-development',
    docsUrl: '/Plugins/GearFlow',
    fabUrl: null,
  },
] as Plugin[]).sort((a, b) => {
  const s = STATUS_ORDER[a.status] - STATUS_ORDER[b.status];
  if (s !== 0) return s;
  return (b.docsUrl ? 1 : 0) - (a.docsUrl ? 1 : 0);
});

const statusMeta: Record<Plugin['status'], { label: string; color: string }> = {
  live:             { label: 'Live on Fab',     color: '#22c55e' },
  'pre-launch':     { label: 'Pre-Launch',       color: '#f59e0b' },
  'in-development': { label: 'In Development',   color: '#6b7280' },
  'coming-soon':    { label: 'Coming Soon',       color: '#8b5cf6' },
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Plugins — Miguel Techlead</title>
  <meta name="description" content="Unreal Engine 5 plugins for world-building, combat, and tooling." />
  <link rel="icon" href="/logo_head.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" />
  <!-- Open Graph (Facebook, LinkedIn, Discord, Slack, iMessage, WhatsApp) -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content="https://toamig.github.io/Plugins" />
  <meta property="og:site_name"   content="Miguel Techlead" />
  <meta property="og:title"       content="Modular Plugins — Miguel Techlead" />
  <meta property="og:description" content="Production-grade UE5 plugins for inventory, combat, dialog, and world-building. Fragment-based, multiplayer-ready, extensible per project." />
  <meta property="og:image"       content="https://toamig.github.io/og-plugins.png" />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt"   content="Modular Plugins — Unreal Engine 5" />
  <!-- Twitter / X -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content="Modular Plugins — Miguel Techlead" />
  <meta name="twitter:description" content="Production-grade UE5 plugins for inventory, combat, dialog, and world-building." />
  <meta name="twitter:image"       content="https://toamig.github.io/og-plugins.png" />
  <meta name="twitter:image:alt"   content="Modular Plugins — Unreal Engine 5" />
</head>
<body>

  <!-- ── Back home ───────────────────────────────────────────────────── -->
  <a href="/" class="home-pill">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 12H5M12 5l-7 7 7 7"/>
    </svg>
    migueltechlead.pt
  </a>

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <canvas id="hero-circuits" aria-hidden="true"></canvas>
    <p class="eyebrow">Unreal Engine 5</p>
    <h1>Plugins</h1>
    <p class="sub">Production-grade tools for world-building, combat systems, and pipeline automation.</p>
  </section>

  <!-- ── Grid ──────────────────────────────────────────────────────────── -->
  <section class="grid-wrap">
    <div class="grid">
      {plugins.map(p => {
        const meta = statusMeta[p.status];
        return (
          <article class="card" style={`--accent:${p.accent};--accent-l:${p.accentLight};`}>
            <div class="card-cover">
              <img src={p.cover} alt={`${p.name} cover`} loading="lazy" />
              <div class="cover-fade" />
              <span class="badge" style={`--s:${meta.color};`}>{meta.label}</span>
            </div>
            <div class="card-body">
              <div class="card-header">
                <img src={p.logo} alt={`${p.name} logo`} class="card-logo" />
                <div>
                  <h2>{p.name}</h2>
                  <span class="ver">v{p.version}</span>
                </div>
              </div>
              <p class="tagline">{p.tagline}</p>
              <div class="actions">
                {p.docsUrl && <a href={p.docsUrl} class="btn-docs">Documentation</a>}
                {p.fabUrl
                  ? <a href={p.fabUrl} class="btn-fab" target="_blank" rel="noopener">Get on Fab ↗</a>
                  : <span class="btn-fab disabled">Not on Fab yet</span>
                }
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>


<script>
(function () {
  function rng(seed) {
    let s = seed >>> 0;
    return () => {
      s ^= s << 13; s ^= s >>> 17; s ^= s << 5;
      return (s >>> 0) / 4294967296;
    };
  }

  const canvas = document.getElementById('hero-circuits');
  const hero   = canvas.parentElement;

  function draw() {
    const W = hero.offsetWidth;
    const H = hero.offsetHeight;
    canvas.width  = W;
    canvas.height = H;

    const ctx  = canvas.getContext('2d');
    const rand = rng(6487);

    const STEP   = 26;
    const OX     = W / 2;
    const OY     = H * 0.26;   // grid origin — upper hero, where the glow is
    const FOLD_Y = H * 0.64;   // where the wall surface folds into the floor
    const R_FOLD = Math.round((FOLD_Y - OY) / STEP); // grid row at the fold
    const CAM    = 190;        // perspective camera distance — higher = gentler
    const VS     = 0.52;       // floor vertical scale (< 1 = floor recedes at angle, not straight down)

    // Dual projection: flat wall above fold, perspective floor below
    function project(c, r) {
      const flatY = OY + r * STEP;
      if (flatY <= FOLD_Y) {
        // Wall — straight H/V
        return { x: OX + c * STEP, y: flatY };
      }
      // Floor — perspective diverging away from centre as depth grows
      const depth  = r - R_FOLD;                        // steps below the fold
      const spread = 1 + (depth * STEP) / CAM;          // grows with depth → traces fan outward
      return {
        x: OX + c * STEP * spread,
        y: FOLD_Y + depth * STEP * VS,
      };
    }

    // 4 dirs: R / D / L / U
    const DC      = [ 1,  0, -1,  0];
    const DR      = [ 0,  1,  0, -1];
    const REVERSE = [ 2,  3,  0,  1];

    const visited  = new Set();
    const segments = [];
    const dots     = [];

    function walk(c, r, dir, energy) {
      if (energy <= 0) return;

      const steps = 3 + Math.floor(rand() * 7);
      let pc = c, pr = r, walked = 0;

      for (let i = 0; i < steps; i++) {
        const nc = pc + DC[dir];
        const nr = pr + DR[dir];
        const nk = `${nc},${nr}`;
        if (visited.has(nk)) break;
        const sp = project(nc, nr);
        if (sp.x < -STEP || sp.x > W + STEP || sp.y < -STEP || sp.y > H + STEP) break;
        visited.add(nk);
        segments.push({ c1: pc, r1: pr, c2: nc, r2: nr });
        pc = nc; pr = nr;
        walked++;
      }

      if (walked === 0) return;

      const nextEnergy = energy - walked * 2 - rand() * 4;
      const { x: sx } = project(pc, pr);

      if (nextEnergy < 6) {
        dots.push({ c: pc, r: pr });
        return;
      }

      const distFromCenter = Math.abs(sx - OX) / (W / 2); // 0 = centre, 1 = edge
      const options = [];
      for (let d = 0; d < 4; d++) {
        if (d === REVERSE[dir]) continue;
        let w = 1;
        // Strong outward push — near centre gets no boost, edges get heavy boost
        const goesRight = DC[d] > 0, goesLeft = DC[d] < 0;
        if (goesRight && sx > OX) w += 1 + Math.round(distFromCenter * 4);
        if (goesLeft  && sx < OX) w += 1 + Math.round(distFromCenter * 4);
        if (DR[d] > 0)            w += 1;
        for (let j = 0; j < w; j++) options.push(d);
      }

      const nd = options[Math.floor(rand() * options.length)];
      dots.push({ c: pc, r: pr });
      walk(pc, pr, nd, nextEnergy);

      // Branch more eagerly and at lower energy threshold
      if (rand() < 0.55 && nextEnergy > 14) {
        const others = options.filter(d => d !== nd);
        if (others.length)
          walk(pc, pr, others[Math.floor(rand() * others.length)], nextEnergy * 0.6);
      }
    }

    // Seeds: cluster around the grid origin
    const seeds = 20 + Math.floor(rand() * 6);
    for (let i = 0; i < seeds; i++) {
      const c = Math.round((rand() - 0.5) * 20);
      const r = Math.round((rand() - 0.5) * 6);
      visited.add(`${c},${r}`);
      walk(c, r, Math.floor(rand() * 4), 95 + rand() * 95);
    }

    // ── Glow pass ─────────────────────────────────────────────────────────
    ctx.lineWidth   = 4;
    ctx.lineCap     = 'round';
    ctx.strokeStyle = 'rgba(99,102,241,0.05)';
    ctx.beginPath();
    for (const s of segments) {
      const p1 = project(s.c1, s.r1), p2 = project(s.c2, s.r2);
      ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y);
    }
    ctx.stroke();

    // ── Main traces ───────────────────────────────────────────────────────
    ctx.lineWidth   = 1;
    ctx.lineCap     = 'square';
    ctx.strokeStyle = 'rgba(109,112,251,0.22)';
    ctx.beginPath();
    for (const s of segments) {
      const p1 = project(s.c1, s.r1), p2 = project(s.c2, s.r2);
      ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y);
    }
    ctx.stroke();

    // ── Junction dots ─────────────────────────────────────────────────────
    for (const d of dots) {
      const p = project(d.c, d.r);
      ctx.fillStyle = 'rgba(129,140,248,0.18)';
      ctx.beginPath();
      ctx.arc(p.x, p.y, 4.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = 'rgba(160,168,255,0.50)';
      ctx.beginPath();
      ctx.arc(p.x, p.y, 1.8, 0, Math.PI * 2);
      ctx.fill();
    }

    // ── Radial centre fade — dissolves wires behind title/description ──────
    ctx.globalCompositeOperation = 'destination-out';
    const radial = ctx.createRadialGradient(OX, OY, W * 0.04, OX, OY, W * 0.38);
    radial.addColorStop(0,    'rgba(0,0,0,0.68)');
    radial.addColorStop(0.25, 'rgba(0,0,0,0)');
    radial.addColorStop(1,    'rgba(0,0,0,0)');
    ctx.fillStyle = radial;
    ctx.fillRect(0, 0, W, H);
    ctx.globalCompositeOperation = 'source-over';
  }

  draw();
  window.addEventListener('resize', draw);
})();
</script>

</body>
</html>

<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Inter', system-ui, sans-serif;
  background: #06090f;
  color: #e2e8f0;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

/* ── Back pill ───────────────────────────────────────────────────────── */
.home-pill {
  position: fixed;
  top: 20px;
  left: 24px;
  z-index: 50;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 14px;
  border-radius: 99px;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.1);
  color: rgba(255,255,255,.6);
  font-size: .78rem;
  font-weight: 500;
  text-decoration: none;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  transition: color .15s, background .15s, border-color .15s;
}
.home-pill:hover {
  color: #fff;
  background: rgba(255,255,255,.1);
  border-color: rgba(255,255,255,.2);
}
.home-pill svg { flex-shrink: 0; opacity: .7; }

/* ── Hero ────────────────────────────────────────────────────────────── */
.hero {
  position: relative;
  padding: 120px 24px 56px;
  text-align: center;
  background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(99,102,241,.1) 0%, transparent 70%);
  border-bottom: 1px solid rgba(255,255,255,.05);
  overflow: hidden;
}

#hero-circuits {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  opacity: 0;
  animation: circuits-fadein 1.2s ease forwards;
  -webkit-mask-image: linear-gradient(to bottom, black 35%, transparent 92%);
  mask-image: linear-gradient(to bottom, black 35%, transparent 92%);
}

@keyframes circuits-fadein {
  to { opacity: 1; }
}

.hero .eyebrow,
.hero h1,
.hero .sub {
  position: relative;
  z-index: 1;
}

.eyebrow {
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: #6366f1;
  margin-bottom: 14px;
}

h1 {
  font-size: clamp(2.6rem, 6vw, 4rem);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -.03em;
  margin-bottom: 18px;
  padding-bottom: 0.12em;
  background: linear-gradient(140deg, #fff 40%, #64748b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.sub {
  font-size: 1rem;
  color: #64748b;
  line-height: 1.7;
  max-width: 520px;
  margin: 0 auto;
}

/* ── Grid ────────────────────────────────────────────────────────────── */
.grid-wrap {
  padding: 56px 24px 96px;
  max-width: 1100px;
  margin: 0 auto;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 24px;
}

/* ── Card ────────────────────────────────────────────────────────────── */
.card {
  background: #0b0f18;
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
}
.card:hover {
  transform: translateY(-5px);
  border-color: color-mix(in srgb, var(--accent) 35%, transparent);
  box-shadow: 0 20px 56px color-mix(in srgb, var(--accent) 10%, transparent);
}

.card-cover {
  position: relative;
  aspect-ratio: 16 / 7;
  overflow: hidden;
}
.card-cover img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .45s ease;
}
.card:hover .card-cover img { transform: scale(1.05); }

.cover-fade {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 35%, #0b0f18 100%);
}

.badge {
  position: absolute;
  top: 11px; right: 11px;
  padding: 3px 9px;
  border-radius: 99px;
  font-size: .65rem;
  font-weight: 700;
  letter-spacing: .09em;
  text-transform: uppercase;
  color: var(--s);
  background: color-mix(in srgb, var(--s) 12%, #06090f);
  border: 1px solid color-mix(in srgb, var(--s) 30%, transparent);
  backdrop-filter: blur(6px);
}

.card-body {
  padding: 18px 22px 22px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}

.card-logo {
  width: 44px; height: 44px;
  object-fit: contain;
  border-radius: 9px;
  background: rgba(255,255,255,.03);
  padding: 3px;
  flex-shrink: 0;
}

h2 {
  font-size: 1.05rem;
  font-weight: 700;
  color: #f1f5f9;
  margin-bottom: 3px;
  line-height: 1.2;
}

.ver {
  font-size: .67rem;
  font-weight: 600;
  color: var(--accent-l);
  background: color-mix(in srgb, var(--accent) 12%, transparent);
  border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
  padding: 1px 7px;
  border-radius: 99px;
  display: inline-block;
}

.tagline {
  font-size: .87rem;
  color: #64748b;
  line-height: 1.65;
  margin-bottom: 18px;
  flex: 1;
}

.actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.btn-docs {
  display: inline-flex;
  align-items: center;
  padding: 7px 16px;
  border-radius: 7px;
  font-size: .82rem;
  font-weight: 600;
  text-decoration: none;
  background: var(--accent);
  color: #fff;
  transition: opacity .15s;
}
.btn-docs:hover { opacity: .82; }

.btn-fab {
  display: inline-flex;
  align-items: center;
  padding: 7px 16px;
  border-radius: 7px;
  font-size: .82rem;
  font-weight: 500;
  text-decoration: none;
  background: transparent;
  border: 1px solid rgba(255,255,255,.1);
  color: #475569;
  transition: border-color .15s, color .15s;
}
.btn-fab:not(.disabled):hover {
  border-color: rgba(255,255,255,.25);
  color: #94a3b8;
}
.btn-fab.disabled { cursor: default; pointer-events: none; }

/* ── Responsive ──────────────────────────────────────────────────────── */
@media (max-width: 600px) {
  .grid { grid-template-columns: 1fr; }
  .hero { padding: 90px 18px 44px; }
  .grid-wrap { padding: 36px 18px 64px; }
  .home-pill { top: 14px; left: 14px; }
}
</style>
