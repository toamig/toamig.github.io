---
import pluginsData from '../../data/plugins.json';

interface Plugin {
  name: string;
  tagline: string;
  domain: string;
  tags?: string[];
  version: string;
  logo: string;
  cover: string;
  accent: string;
  accentLight: string;
  status: 'live' | 'pre-launch' | 'in-development' | 'coming-soon';
  docsUrl: string | null;
  fabUrl: string | null;
  hidden?: boolean;
}

const STATUS_ORDER: Record<Plugin['status'], number> = {
  'live': 0,
  'pre-launch': 1,
  'in-development': 2,
  'coming-soon': 3,
};

const plugins: Plugin[] = (pluginsData as Plugin[]).filter(p => !p.hidden).sort((a, b) => {
  const s = STATUS_ORDER[a.status] - STATUS_ORDER[b.status];
  if (s !== 0) return s;
  return (b.docsUrl ? 1 : 0) - (a.docsUrl ? 1 : 0);
});

const statusMeta: Record<Plugin['status'], { label: string; color: string }> = {
  live:             { label: 'Live on Fab',     color: '#22c55e' },
  'pre-launch':     { label: 'Pre-Launch',       color: '#f59e0b' },
  'in-development': { label: 'In Development',   color: '#6b7280' },
  'coming-soon':    { label: 'Coming Soon',       color: '#8b5cf6' },
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Plugins — Miguel Techlead</title>
  <meta name="description" content="Unreal Engine 5 plugins for world-building, combat, and tooling." />
  <link rel="icon" href="/logo_head.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" />
  <!-- Open Graph (Facebook, LinkedIn, Discord, Slack, iMessage, WhatsApp) -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content="https://toamig.github.io/Plugins" />
  <meta property="og:site_name"   content="Miguel Techlead" />
  <meta property="og:title"       content="Modular Plugins — Miguel Techlead" />
  <meta property="og:description" content="Production-grade UE5 plugins for inventory, combat, dialog, and world-building. Fragment-based, multiplayer-ready, extensible per project." />
  <meta property="og:image"       content="https://toamig.github.io/og-plugins.png" />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt"   content="Modular Plugins — Unreal Engine 5" />
  <!-- Twitter / X -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content="Modular Plugins — Miguel Techlead" />
  <meta name="twitter:description" content="Production-grade UE5 plugins for inventory, combat, dialog, and world-building." />
  <meta name="twitter:image"       content="https://toamig.github.io/og-plugins.png" />
  <meta name="twitter:image:alt"   content="Modular Plugins — Unreal Engine 5" />
</head>
<body>

  <!-- ── Back home ───────────────────────────────────────────────────── -->
  <a href="/" class="home-pill">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 12H5M12 5l-7 7 7 7"/>
    </svg>
    migueltechlead.pt
  </a>

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <canvas id="hero-circuits" aria-hidden="true"></canvas>
    <p class="eyebrow">Unreal Engine 5</p>
    <h1>Plugins</h1>
    <p class="sub">Production-grade tools for world-building, combat systems, and pipeline automation.</p>
  </section>

  <!-- ── Grid ──────────────────────────────────────────────────────────── -->
  <section class="grid-wrap">
    <div class="grid">
      {plugins.map((p, i) => {
        const meta = statusMeta[p.status];
        return (
          <article class="card" style={`--accent:${p.accent};--accent-l:${p.accentLight};--i:${i};`}>
            <span class="card-rail" aria-hidden="true" />
            <div class="card-cover">
              <img src={p.cover} alt={`${p.name} cover`} loading="lazy" />
              <div class="cover-fade" />
              <span class="badge" style={`--s:${meta.color};`}>
                <span class="badge-dot" aria-hidden="true" />
                {meta.label}
              </span>
            </div>
            <div class="card-body">
              <div class="card-header">
                <span class="card-logo-tile">
                  <img src={p.logo} alt={`${p.name} logo`} class="card-logo" />
                </span>
                <div class="card-title-block">
                  <h2>{p.name}</h2>
                  <div class="card-meta">
                    <span class="domain">{p.domain}</span>
                    <span class="meta-dot" aria-hidden="true">·</span>
                    <span class="ver">v{p.version}</span>
                  </div>
                </div>
              </div>
              <p class="tagline">{p.tagline}</p>
              {p.tags && p.tags.length > 0 && (
                <ul class="chips" aria-label="Capabilities">
                  {p.tags.map(t => <li class="chip">{t}</li>)}
                </ul>
              )}
              <div class="actions">
                {p.docsUrl && <a href={p.docsUrl} class="btn-docs">Documentation</a>}
                {p.fabUrl
                  ? <a href={p.fabUrl} class="btn-fab" target="_blank" rel="noopener">Get on Fab ↗</a>
                  : <span class="btn-fab disabled">Fab soon</span>
                }
              </div>
            </div>
          </article>
        );
      })}
    </div>
    <p class="grid-foot">More plugins in development.</p>
  </section>


<script>
(function () {
  function rng(seed) {
    let s = seed >>> 0;
    return () => {
      s ^= s << 13; s ^= s >>> 17; s ^= s << 5;
      return (s >>> 0) / 4294967296;
    };
  }

  const canvas  = document.getElementById('hero-circuits');
  const hero    = canvas.parentElement;
  const ctx     = canvas.getContext('2d');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Built once per layout: the static circuit baked to an offscreen canvas,
  // plus the segment list + projection so pulses can travel the same traces.
  let base = null, segments = [], project = null;
  let W = 0, H = 0, OX = 0, OY = 0;
  let pulses = [];

  function build() {
    W = hero.offsetWidth;
    H = hero.offsetHeight;
    canvas.width  = W;
    canvas.height = H;

    const rand = rng(6487);
    const STEP   = 26;
    OX = W / 2;
    OY = H * 0.26;            // grid origin — upper hero, where the glow is
    const FOLD_Y = H * 0.64;  // where the wall surface folds into the floor
    const R_FOLD = Math.round((FOLD_Y - OY) / STEP);
    const CAM    = 190;
    const VS     = 0.52;

    project = function (c, r) {
      const flatY = OY + r * STEP;
      if (flatY <= FOLD_Y) return { x: OX + c * STEP, y: flatY };
      const depth  = r - R_FOLD;
      const spread = 1 + (depth * STEP) / CAM;
      return { x: OX + c * STEP * spread, y: FOLD_Y + depth * STEP * VS };
    };

    const DC      = [ 1,  0, -1,  0];
    const DR      = [ 0,  1,  0, -1];
    const REVERSE = [ 2,  3,  0,  1];
    const visited = new Set();
    segments = [];
    const dots = [];

    function walk(c, r, dir, energy) {
      if (energy <= 0) return;
      const steps = 3 + Math.floor(rand() * 7);
      let pc = c, pr = r, walked = 0;
      for (let i = 0; i < steps; i++) {
        const nc = pc + DC[dir], nr = pr + DR[dir], nk = `${nc},${nr}`;
        if (visited.has(nk)) break;
        const sp = project(nc, nr);
        if (sp.x < -STEP || sp.x > W + STEP || sp.y < -STEP || sp.y > H + STEP) break;
        visited.add(nk);
        segments.push({ c1: pc, r1: pr, c2: nc, r2: nr });
        pc = nc; pr = nr; walked++;
      }
      if (walked === 0) return;
      const nextEnergy = energy - walked * 2 - rand() * 4;
      const { x: sx } = project(pc, pr);
      if (nextEnergy < 6) { dots.push({ c: pc, r: pr }); return; }
      const distFromCenter = Math.abs(sx - OX) / (W / 2);
      const options = [];
      for (let d = 0; d < 4; d++) {
        if (d === REVERSE[dir]) continue;
        let w = 1;
        if (DC[d] > 0 && sx > OX) w += 1 + Math.round(distFromCenter * 4);
        if (DC[d] < 0 && sx < OX) w += 1 + Math.round(distFromCenter * 4);
        if (DR[d] > 0)            w += 1;
        for (let j = 0; j < w; j++) options.push(d);
      }
      const nd = options[Math.floor(rand() * options.length)];
      dots.push({ c: pc, r: pr });
      walk(pc, pr, nd, nextEnergy);
      if (rand() < 0.55 && nextEnergy > 14) {
        const others = options.filter(d => d !== nd);
        if (others.length) walk(pc, pr, others[Math.floor(rand() * others.length)], nextEnergy * 0.6);
      }
    }

    const seeds = 20 + Math.floor(rand() * 6);
    for (let i = 0; i < seeds; i++) {
      const c = Math.round((rand() - 0.5) * 20);
      const r = Math.round((rand() - 0.5) * 6);
      visited.add(`${c},${r}`);
      walk(c, r, Math.floor(rand() * 4), 95 + rand() * 95);
    }

    // Bake the static circuit (no centre fade — that's applied per-frame so
    // it dissolves the pulses behind the title too).
    base = document.createElement('canvas');
    base.width = W; base.height = H;
    const bx = base.getContext('2d');

    bx.lineWidth = 4; bx.lineCap = 'round'; bx.strokeStyle = 'rgba(99,102,241,0.05)';
    bx.beginPath();
    for (const s of segments) {
      const p1 = project(s.c1, s.r1), p2 = project(s.c2, s.r2);
      bx.moveTo(p1.x, p1.y); bx.lineTo(p2.x, p2.y);
    }
    bx.stroke();

    bx.lineWidth = 1; bx.lineCap = 'square'; bx.strokeStyle = 'rgba(109,112,251,0.22)';
    bx.beginPath();
    for (const s of segments) {
      const p1 = project(s.c1, s.r1), p2 = project(s.c2, s.r2);
      bx.moveTo(p1.x, p1.y); bx.lineTo(p2.x, p2.y);
    }
    bx.stroke();

    for (const d of dots) {
      const p = project(d.c, d.r);
      bx.fillStyle = 'rgba(129,140,248,0.18)';
      bx.beginPath(); bx.arc(p.x, p.y, 4.5, 0, Math.PI * 2); bx.fill();
      bx.fillStyle = 'rgba(160,168,255,0.50)';
      bx.beginPath(); bx.arc(p.x, p.y, 1.8, 0, Math.PI * 2); bx.fill();
    }

    // Seed pulses — glowing packets travelling random traces.
    const n = Math.min(26, Math.max(10, Math.round(segments.length / 9)));
    pulses = [];
    for (let i = 0; i < n; i++) pulses.push(spawn());
  }

  function spawn() {
    return {
      seg:   segments[Math.floor(Math.random() * segments.length)],
      t:     Math.random(),
      speed: 0.16 + Math.random() * 0.34,   // fraction of the segment per second
    };
  }

  function centreFade() {
    ctx.globalCompositeOperation = 'destination-out';
    const radial = ctx.createRadialGradient(OX, OY, W * 0.04, OX, OY, W * 0.38);
    radial.addColorStop(0,    'rgba(0,0,0,0.68)');
    radial.addColorStop(0.25, 'rgba(0,0,0,0)');
    radial.addColorStop(1,    'rgba(0,0,0,0)');
    ctx.fillStyle = radial;
    ctx.fillRect(0, 0, W, H);
    ctx.globalCompositeOperation = 'source-over';
  }

  function frame(dt) {
    ctx.clearRect(0, 0, W, H);
    if (base) ctx.drawImage(base, 0, 0);

    ctx.lineCap = 'round';
    for (const p of pulses) {
      p.t += p.speed * dt;
      if (p.t >= 1 || !p.seg) { Object.assign(p, spawn()); continue; }
      const a = project(p.seg.c1, p.seg.r1), b = project(p.seg.c2, p.seg.r2);
      const x  = a.x + (b.x - a.x) * p.t,            y  = a.y + (b.y - a.y) * p.t;
      const tt = Math.max(0, p.t - 0.34);
      const tx = a.x + (b.x - a.x) * tt,             ty = a.y + (b.y - a.y) * tt;
      const g = ctx.createLinearGradient(tx, ty, x, y);
      g.addColorStop(0, 'rgba(129,140,248,0)');
      g.addColorStop(1, 'rgba(165,172,255,0.55)');
      ctx.strokeStyle = g; ctx.lineWidth = 1.6;
      ctx.beginPath(); ctx.moveTo(tx, ty); ctx.lineTo(x, y); ctx.stroke();
      ctx.fillStyle = 'rgba(196,201,255,0.9)';
      ctx.beginPath(); ctx.arc(x, y, 1.8, 0, Math.PI * 2); ctx.fill();
    }

    centreFade();
  }

  // ── Lifecycle ──────────────────────────────────────────────────────────
  let raf = 0, last = 0;
  function loop(now) {
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;
    frame(dt);
    raf = requestAnimationFrame(loop);
  }

  function start() {
    if (raf) return;
    last = performance.now();
    raf = requestAnimationFrame(loop);
  }
  function stop() { if (raf) { cancelAnimationFrame(raf); raf = 0; } }

  function paintStatic() {
    ctx.clearRect(0, 0, W, H);
    if (base) ctx.drawImage(base, 0, 0);
    centreFade();
  }

  build();
  // Always paint one frame immediately so the canvas is never blank — rAF
  // doesn't fire while the tab is hidden (background-tab load / SSR preview),
  // and the loop would otherwise leave nothing on screen until it runs.
  if (reduced) {
    paintStatic();
  } else {
    frame(0);
    start();
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop(); else start();
    });
  }

  let rt = 0;
  window.addEventListener('resize', () => {
    clearTimeout(rt);
    rt = setTimeout(() => {
      build();
      if (reduced) paintStatic(); else frame(0);
    }, 150);
  });
})();
</script>

</body>
</html>

<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Inter', system-ui, sans-serif;
  background: #06090f;
  color: #e2e8f0;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

/* ── Back pill ───────────────────────────────────────────────────────── */
.home-pill {
  position: fixed;
  top: 20px;
  left: 24px;
  z-index: 50;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 14px;
  border-radius: 99px;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.1);
  color: rgba(255,255,255,.6);
  font-size: .78rem;
  font-weight: 500;
  text-decoration: none;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  transition: color .15s, background .15s, border-color .15s;
}
.home-pill:hover {
  color: #fff;
  background: rgba(255,255,255,.1);
  border-color: rgba(255,255,255,.2);
}
.home-pill svg { flex-shrink: 0; opacity: .7; }

/* ── Hero ────────────────────────────────────────────────────────────── */
.hero {
  position: relative;
  padding: 120px 24px 56px;
  text-align: center;
  background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(99,102,241,.1) 0%, transparent 70%);
  border-bottom: 1px solid rgba(255,255,255,.05);
  overflow: hidden;
}

#hero-circuits {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  opacity: 0;
  animation: circuits-fadein 1.2s ease forwards;
  -webkit-mask-image: linear-gradient(to bottom, black 35%, transparent 92%);
  mask-image: linear-gradient(to bottom, black 35%, transparent 92%);
}

@keyframes circuits-fadein {
  to { opacity: 1; }
}

.hero .eyebrow,
.hero h1,
.hero .sub {
  position: relative;
  z-index: 1;
}

.eyebrow {
  font-size: .7rem;
  font-weight: 600;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: #6366f1;
  margin-bottom: 14px;
}

h1 {
  font-size: clamp(2.6rem, 6vw, 4rem);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -.03em;
  margin-bottom: 18px;
  padding-bottom: 0.12em;
  background: linear-gradient(140deg, #fff 40%, #64748b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.sub {
  font-size: 1rem;
  color: #64748b;
  line-height: 1.7;
  max-width: 520px;
  margin: 0 auto;
}

/* ── Grid ────────────────────────────────────────────────────────────── */
.grid-wrap {
  padding: 56px 24px 96px;
  max-width: 1100px;
  margin: 0 auto;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 24px;
}

/* ── Card ────────────────────────────────────────────────────────────── */
.card {
  position: relative;
  background: #0b0f18;
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
  animation: card-rise .55s cubic-bezier(.16,.7,.2,1) both;
  animation-delay: calc(var(--i, 0) * 70ms + 200ms);
}
.card:hover {
  transform: translateY(-5px);
  border-color: color-mix(in srgb, var(--accent) 42%, transparent);
  box-shadow: 0 20px 56px color-mix(in srgb, var(--accent) 13%, transparent);
}

/* Per-plugin accent rail along the card's top edge — the product's colour
   identity, brightening on hover. */
.card-rail {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  z-index: 3;
  background: linear-gradient(90deg, var(--accent), var(--accent-l));
  opacity: .85;
  transition: opacity .22s ease;
}
.card:hover .card-rail { opacity: 1; }

@keyframes card-rise {
  from { opacity: 0; transform: translateY(22px); }
  to   { opacity: 1; transform: none; }
}

.card-cover {
  position: relative;
  aspect-ratio: 16 / 7;
  overflow: hidden;
}
.card-cover img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .45s ease;
}
.card:hover .card-cover img { transform: scale(1.05); }

.cover-fade {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 35%, #0b0f18 100%);
}

.badge {
  position: absolute;
  top: 11px; right: 11px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 11px 4px 9px;
  border-radius: 99px;
  font-size: .65rem;
  font-weight: 600;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--s);
  background: color-mix(in srgb, var(--s) 14%, rgba(6,9,15,.72));
  border: 1px solid color-mix(in srgb, var(--s) 32%, transparent);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.badge-dot {
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--s);
  box-shadow: 0 0 0 0 color-mix(in srgb, var(--s) 60%, transparent);
  animation: badge-pulse 2.4s ease-out infinite;
}
@keyframes badge-pulse {
  0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--s) 55%, transparent); }
  70%  { box-shadow: 0 0 0 6px color-mix(in srgb, var(--s) 0%, transparent); }
  100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--s) 0%, transparent); }
}

.card-body {
  padding: 18px 22px 22px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}
.card-title-block { min-width: 0; flex: 1; }

.card-logo-tile {
  display: grid;
  place-items: center;
  width: 48px; height: 48px;
  border-radius: 10px;
  flex-shrink: 0;
  background: color-mix(in srgb, var(--accent) 12%, #0b0f18);
  border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
  transition: border-color .22s ease, background .22s ease;
}
.card:hover .card-logo-tile {
  background: color-mix(in srgb, var(--accent) 18%, #0b0f18);
  border-color: color-mix(in srgb, var(--accent) 45%, transparent);
}
.card-logo {
  width: 36px; height: 36px;
  object-fit: contain;
}

h2 {
  font-size: 1.05rem;
  font-weight: 700;
  color: #f1f5f9;
  margin-bottom: 5px;
  line-height: 1.2;
}

.card-meta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  line-height: 1;
}
.domain {
  font-size: .65rem;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--accent-l) 85%, #cbd5e1);
}
.meta-dot { color: rgba(148,163,184,.25); font-weight: 700; }
.ver {
  font-size: .67rem;
  font-weight: 500;
  color: rgba(148,163,184,.55);
  font-variant-numeric: tabular-nums;
}

.tagline {
  font-size: .87rem;
  color: #8493a6;
  line-height: 1.65;
  margin-bottom: 14px;
}

/* ── Capability chips — the at-a-glance technical scan for devs ───────── */
.chips {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 0 0 18px;
  flex: 1;
  align-content: flex-start;
}
.chip {
  font-size: .68rem;
  font-weight: 600;
  letter-spacing: .02em;
  color: #aeb9c8;
  padding: 3px 9px;
  border-radius: 6px;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.08);
  white-space: nowrap;
  transition: color .2s ease, border-color .2s ease, background .2s ease;
}
.card:hover .chip {
  border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  color: #d7dee8;
}
/* No chips → tagline absorbs the slack so the actions stay bottom-aligned */
.card-body:not(:has(.chips)) .tagline { flex: 1; margin-bottom: 18px; }

.actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.btn-docs {
  display: inline-flex;
  align-items: center;
