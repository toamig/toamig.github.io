---
interface Plugin {
  name: string;
  tagline: string;
  version: string;
  logo: string;
  cover: string;
  accent: string;
  accentLight: string;
  status: 'live' | 'pre-launch' | 'in-development' | 'coming-soon';
  docsUrl: string | null;
  fabUrl: string | null;
}

const plugins: Plugin[] = [
  {
    name: 'WorldSweep',
    tagline: 'Batch scripting for UE5 World Partition — sweep entire maps, cell by cell.',
    version: '1.0',
    logo: '/plugins/worldsweep/WorldSweep.png',
    cover: '/plugins/worldsweep/WorldSweepCover.png',
    accent: '#0e9fd4',
    accentLight: '#22d4f8',
    status: 'pre-launch',
    docsUrl: '/Plugins/WorldSweep',
    fabUrl: null,
  },
  {
    name: 'Cascade Combat System',
    tagline: 'Node-based combo trees, GAS integration, and data-driven melee — in one plugin.',
    version: '1.0',
    logo: '/plugins/cascadecombatsystem/CascadeCombatSystem.png',
    cover: '/plugins/cascadecombatsystem/CascadeCombatSystemCover.png',
    accent: '#d4600a',
    accentLight: '#f07820',
    status: 'pre-launch',
    docsUrl: '/Plugins/CascadeCombatSystem',
    fabUrl: null,
  },
];

const statusMeta: Record<Plugin['status'], { label: string; color: string }> = {
  live:             { label: 'Live on Fab',     color: '#22c55e' },
  'pre-launch':     { label: 'Pre-Launch',       color: '#f59e0b' },
  'in-development': { label: 'In Development',   color: '#6b7280' },
  'coming-soon':    { label: 'Coming Soon',       color: '#8b5cf6' },
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Plugins — Miguel Techlead</title>
  <meta name="description" content="Unreal Engine 5 plugins for world-building, combat, and tooling." />
  <link rel="icon" href="/logo_head.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" />
  <meta property="og:title" content="Plugins — Miguel Techlead" />
  <meta property="og:description" content="Unreal Engine 5 plugins for world-building, combat, and tooling." />
  <meta property="og:type" content="website" />
</head>
<body>

  <!-- ── Back home ───────────────────────────────────────────────────── -->
  <a href="/" class="home-pill">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 12H5M12 5l-7 7 7 7"/>
    </svg>
    migueltechlead.pt
  </a>

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <p class="eyebrow">Unreal Engine 5</p>
    <h1>Plugins</h1>
    <p class="sub">Production-grade tools for world-building, combat systems, and pipeline automation.</p>
  </section>

  <!-- ── Grid ──────────────────────────────────────────────────────────── -->
  <section class="grid-wrap">
    <div class="grid">
      {plugins.map(p => {
        const meta = statusMeta[p.status];
        return (
          <article class="card" style={`--accent:${p.accent};--accent-l:${p.accentLight};`}>
            <div class="card-cover">
              <img src={p.cover} alt={`${p.name} cover`} loading="lazy" />
              <div class="cover-fade" />
              <span class="badge" style={`--s:${meta.color};`}>{meta.label}</span>
            </div>
            <div class="card-body">
              <div class="card-header">
                <img src={p.logo} alt={`${p.name} logo`} class="card-logo" />
                <div>
                  <h2>{p.name}</h2>
                  <span class="ver">v{p.version}</span>
                </div>
              </div>
              <p class="tagline">{p.tagline}</p>
              <div class="actions">
                {p.docsUrl && <a href={p.docsUrl} class="btn-docs">Documentation</a>}
                {p.fabUrl
                  ? <a href={p.fabUrl} class="btn-fab" target="_blank" rel="noopener">Get on Fab ↗</a>
                  : <span class="btn-fab disabled">Not on Fab yet</span>
                }
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

</body>
</html>

<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Inter', system-ui, sans-serif;
  background: #06090f;
  color: #e2e8f0;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

/* ── Back pill ───────────────────────────────────────────────────────── */
.home-pill {
  position: fixed;
  top: 20px;
  left: 24px;
  z-index: 50;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 14px;
  border-radius: 99px;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.1);
  color: rgba(255,255,255,.6);
  font-size: .78rem;
  font-weight: 500;
  text-decoration: none;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  transition: color .15s, background .15s, border-color .15s;
}
.home-pill:hover {
  color: #fff;
  background: rgba(255,255,255,.1);
  border-color: rgba(255,255,255,.2);
}
.home-pill svg { flex-shrink: 0; opacity: .7; }

/* ── Hero ────────────────────────────────────────────────────────────── */
.hero {
  padding: 120px 24px 56px;
  text-align: center;
  background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(99,102,241,.1) 0%, transparent 70%);
  border-bottom: 1px solid rgba(255,255,255,.05);
}

.eyebrow {
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: #6366f1;
  margin-bottom: 14px;
}

h1 {
  font-size: clamp(2.6rem, 6vw, 4rem);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -.03em;
  margin-bottom: 18px;
  padding-bottom: 0.12em;
  background: linear-gradient(140deg, #fff 40%, #64748b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.sub {
  font-size: 1rem;
  color: #64748b;
  line-height: 1.7;
  max-width: 520px;
  margin: 0 auto;
}

/* ── Grid ────────────────────────────────────────────────────────────── */
.grid-wrap {
  padding: 56px 24px 96px;
  max-width: 1100px;
  margin: 0 auto;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 24px;
}

/* ── Card ────────────────────────────────────────────────────────────── */
.card {
  background: #0b0f18;
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
}
.card:hover {
  transform: translateY(-5px);
  border-color: color-mix(in srgb, var(--accent) 35%, transparent);
  box-shadow: 0 20px 56px color-mix(in srgb, var(--accent) 10%, transparent);
}

.card-cover {
  position: relative;
  aspect-ratio: 16 / 7;
  overflow: hidden;
}
.card-cover img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .45s ease;
}
.card:hover .card-cover img { transform: scale(1.05); }

.cover-fade {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 35%, #0b0f18 100%);
}

.badge {
  position: absolute;
  top: 11px; right: 11px;
  padding: 3px 9px;
  border-radius: 99px;
  font-size: .65rem;
  font-weight: 700;
  letter-spacing: .09em;
  text-transform: uppercase;
  color: var(--s);
  background: color-mix(in srgb, var(--s) 12%, #06090f);
  border: 1px solid color-mix(in srgb, var(--s) 30%, transparent);
  backdrop-filter: blur(6px);
}

.card-body {
  padding: 18px 22px 22px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}

.card-logo {
  width: 44px; height: 44px;
  object-fit: contain;
  border-radius: 9px;
  background: rgba(255,255,255,.03);
  padding: 3px;
  flex-shrink: 0;
}

h2 {
  font-size: 1.05rem;
  font-weight: 700;
  color: #f1f5f9;
  margin-bottom: 3px;
  line-height: 1.2;
}

.ver {
  font-size: .67rem;
  font-weight: 600;
  color: var(--accent-l);
  background: color-mix(in srgb, var(--accent) 12%, transparent);
  border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
  padding: 1px 7px;
  border-radius: 99px;
  display: inline-block;
}

.tagline {
  font-size: .87rem;
  color: #64748b;
  line-height: 1.65;
  margin-bottom: 18px;
  flex: 1;
}

.actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.btn-docs {
  display: inline-flex;
  align-items: center;
  padding: 7px 16px;
  border-radius: 7px;
  font-size: .82rem;
  font-weight: 600;
  text-decoration: none;
  background: var(--accent);
  color: #fff;
  transition: opacity .15s;
}
.btn-docs:hover { opacity: .82; }

.btn-fab {
  display: inline-flex;
  align-items: center;
  padding: 7px 16px;
  border-radius: 7px;
  font-size: .82rem;
  font-weight: 500;
  text-decoration: none;
  background: transparent;
  border: 1px solid rgba(255,255,255,.1);
  color: #475569;
  transition: border-color .15s, color .15s;
}
.btn-fab:not(.disabled):hover {
  border-color: rgba(255,255,255,.25);
  color: #94a3b8;
}
.btn-fab.disabled { cursor: default; pointer-events: none; }

/* ── Responsive ──────────────────────────────────────────────────────── */
@media (max-width: 600px) {
  .grid { grid-template-columns: 1fr; }
  .hero { padding: 90px 18px 44px; }
  .grid-wrap { padding: 36px 18px 64px; }
  .home-pill { top: 14px; left: 14px; }
}
</style>
