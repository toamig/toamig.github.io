---
import Logo from '../../components/Logo.astro';
import '../../styles/global.css';

interface Plugin {
  name: string;
  tagline: string;
  version: string;
  logo: string;
  cover: string;
  accent: string;
  accentLight: string;
  status: 'live' | 'pre-launch' | 'in-development' | 'coming-soon';
  docsUrl: string | null;
  fabUrl: string | null;
}

const plugins: Plugin[] = [
  {
    name: 'WorldSweep',
    tagline: 'Batch scripting for UE5 World Partition — sweep entire maps, cell by cell.',
    version: '1.0',
    logo: '/plugins/worldsweep/WorldSweep.png',
    cover: '/plugins/worldsweep/WorldSweepCover.png',
    accent: '#0e9fd4',
    accentLight: '#22d4f8',
    status: 'pre-launch',
    docsUrl: '/Plugins/WorldSweep',
    fabUrl: null,
  },
  {
    name: 'Cascade Combat System',
    tagline: 'Node-based combo trees, GAS integration, and data-driven melee — in one plugin.',
    version: '1.0',
    logo: '/plugins/cascadecombatsystem/CascadeCombatSystem.png',
    cover: '/plugins/cascadecombatsystem/CascadeCombatSystemCover.png',
    accent: '#d4600a',
    accentLight: '#f07820',
    status: 'pre-launch',
    docsUrl: '/Plugins/CascadeCombatSystem',
    fabUrl: null,
  },
];

const statusMeta: Record<Plugin['status'], { label: string; color: string }> = {
  live:             { label: 'Live on Fab',     color: '#22c55e' },
  'pre-launch':     { label: 'Pre-Launch',       color: '#f59e0b' },
  'in-development': { label: 'In Development',   color: '#6b7280' },
  'coming-soon':    { label: 'Coming Soon',       color: '#8b5cf6' },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Plugins — Miguel Techlead</title>
    <meta name="description" content="Unreal Engine 5 plugins for world-building, combat, and tooling." />
    <link rel="icon" href="/logo_head.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" />
    <meta property="og:title"       content="Plugins — Miguel Techlead" />
    <meta property="og:description" content="Unreal Engine 5 plugins for world-building, combat, and tooling." />
    <meta property="og:type"        content="website" />
  </head>
  <body class="plugins-body">

    <!-- ── Header ──────────────────────────────────────────────────────── -->
    <header class="plugins-header" id="plugins-header">
      <nav class="plugins-nav">
        <a href="/" class="nav-brand" aria-label="Home">
          <Logo class="nav-logo" firstPathStyle="fill:#6366f1" />
          <span class="nav-brand-name">Miguel Techlead</span>
        </a>

        <button class="nav-hamburger" aria-label="Toggle menu" id="nav-hamburger">
          <span></span><span></span><span></span>
        </button>

        <div class="nav-links" id="nav-links">
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/Plugins" class="active">Plugins</a>
          <a href="/me/Miguel's CV.pdf" target="_blank" rel="noopener noreferrer">Resume</a>
        </div>
      </nav>
    </header>

    <!-- ── Main ────────────────────────────────────────────────────────── -->
    <main>

      <!-- Hero -->
      <section class="hero">
        <div class="hero-inner">
          <p class="hero-eyebrow">Unreal Engine 5</p>
          <h1>Plugins</h1>
          <p class="hero-sub">
            Production-grade tools for world-building, combat systems, and pipeline automation.
            Built for scale, designed to ship.
          </p>
        </div>
      </section>

      <!-- Grid -->
      <section class="grid-section">
        <div class="plugin-grid">
          {plugins.map(p => {
            const meta = statusMeta[p.status];
            return (
              <article class="plugin-card" style={`--accent:${p.accent};--accent-l:${p.accentLight};`}>
                <div class="card-cover">
                  <img src={p.cover} alt={`${p.name} cover`} loading="lazy" />
                  <div class="cover-fade" />
                  <span class="status-badge" style={`--s:${meta.color};`}>{meta.label}</span>
                </div>
                <div class="card-body">
                  <div class="card-header">
                    <img src={p.logo} alt={`${p.name} logo`} class="plugin-logo" />
                    <div>
                      <h2>{p.name}</h2>
                      <span class="version">v{p.version}</span>
                    </div>
                  </div>
                  <p class="card-tagline">{p.tagline}</p>
                  <div class="card-actions">
                    {p.docsUrl && (
                      <a href={p.docsUrl} class="btn btn-primary">Documentation</a>
                    )}
                    {p.fabUrl
                      ? <a href={p.fabUrl} class="btn btn-fab" target="_blank" rel="noopener">Get on Fab ↗</a>
                      : <span class="btn btn-fab btn-disabled">Not on Fab yet</span>
                    }
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>

    </main>

    <!-- ── Footer ──────────────────────────────────────────────────────── -->
    <footer class="plugins-footer">
      <div class="footer-inner">
        <div class="footer-social">
          <a href="https://www.linkedin.com/in/toamig/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <img src="/socials/linkedin.svg" alt="LinkedIn" />
          </a>
          <a href="https://www.instagram.com/toamig/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <img src="/socials/insta.svg" alt="Instagram" />
          </a>
          <a href="https://github.com/toamig" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <img src="/socials/github.svg" alt="GitHub" />
          </a>
          <a href="https://t.me/cvieiratoa" target="_blank" rel="noopener noreferrer" aria-label="Telegram">
            <img src="/socials/telegram.svg" alt="Telegram" />
          </a>
        </div>
        <p class="footer-copy">&copy; 2025 Miguel Techlead. All rights reserved.</p>
      </div>
    </footer>

  </body>
</html>

<script>
  // Scroll: darken header
  const header = document.getElementById('plugins-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 40);
  }, { passive: true });

  // Hamburger
  const hamburger = document.getElementById('nav-hamburger');
  const navLinks  = document.getElementById('nav-links');
  hamburger?.addEventListener('click', () => {
    hamburger.classList.toggle('active');
    navLinks?.classList.toggle('active');
    document.body.classList.toggle('nav-open');
  });
  navLinks?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      hamburger?.classList.remove('active');
      navLinks.classList.remove('active');
      document.body.classList.remove('nav-open');
    });
  });
</script>

<style>
/* ── Reset for this page ─────────────────────────────────────────────── */
.plugins-body {
  font-family: 'Inter', sans-serif;
  background: #06090f;
  color: #e2e8f0;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}
.plugins-body section { padding: 0; overflow-x: visible; width: auto; }

/* ── Header ──────────────────────────────────────────────────────────── */
.plugins-header {
  position: fixed;
  top: 0; left: 0;
  width: 100%;
  z-index: 100;
  padding: 0 48px;
  height: 64px;
  display: flex;
  align-items: center;
  background: transparent;
  transition: background .25s ease, box-shadow .25s ease;
}
.plugins-header.scrolled {
  background: rgba(6,9,15,.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 1px 0 rgba(255,255,255,.06), 0 8px 24px rgba(0,0,0,.4);
}

.plugins-nav {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 12px;
}

/* brand */
.nav-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  margin-right: auto;
  flex-shrink: 0;
}
.nav-logo {
  width: 28px;
  height: 28px;
  flex-shrink: 0;
}
.nav-brand-name {
  font-size: .9rem;
  font-weight: 700;
  color: #f1f5f9;
  letter-spacing: -.01em;
  white-space: nowrap;
}

/* links */
.nav-links {
  display: flex;
  align-items: center;
  gap: 6px;
}
.nav-links a {
  color: rgba(255,255,255,.75);
  text-decoration: none;
  padding: 7px 16px;
  border-radius: 8px;
  font-size: .84rem;
  font-weight: 500;
  border: 1px solid transparent;
  transition: all .18s ease;
  white-space: nowrap;
}
.nav-links a:hover {
  background: rgba(255,255,255,.07);
  border-color: rgba(255,255,255,.1);
  color: #fff;
}
.nav-links a.active {
  background: rgba(99,102,241,.18);
  border-color: rgba(99,102,241,.35);
  color: #a5b4fc;
}

/* hamburger */
.nav-hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 5px;
  z-index: 101;
}
.nav-hamburger span {
  width: 22px; height: 2px;
  background: rgba(255,255,255,.85);
  border-radius: 2px;
  transition: all .25s ease;
  display: block;
}
.nav-hamburger.active span:nth-child(1) { transform: rotate(45deg) translate(5px,5px); }
.nav-hamburger.active span:nth-child(2) { opacity: 0; }
.nav-hamburger.active span:nth-child(3) { transform: rotate(-45deg) translate(5px,-5px); }

/* mobile nav overlay */
.plugins-body::before {
  content: '';
  position: fixed; inset: 0;
  background: rgba(0,0,0,.6);
  z-index: 99;
  pointer-events: none;
  opacity: 0;
  transition: opacity .25s ease;
}
.plugins-body.nav-open::before { opacity: 1; pointer-events: all; }

/* ── Hero ────────────────────────────────────────────────────────────── */
.hero {
  padding: 140px 24px 64px;
  text-align: center;
  background:
    radial-gradient(ellipse 70% 40% at 50% 0%, rgba(99,102,241,.12) 0%, transparent 70%),
    #06090f;
  border-bottom: 1px solid rgba(255,255,255,.06);
}
.hero-inner { max-width: 680px; margin: 0 auto; }

.hero-eyebrow {
  font-size: .72rem;
  font-weight: 600;
  letter-spacing: .15em;
  text-transform: uppercase;
  color: #6366f1;
  margin: 0 0 16px;
}
.hero h1 {
  font-size: clamp(2.4rem, 6vw, 3.6rem);
  font-weight: 800;
  line-height: 1.1;
  margin: 0 0 20px;
  background: linear-gradient(135deg, #fff 30%, #94a3b8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.hero-sub {
  font-size: 1.05rem;
  color: #94a3b8;
  line-height: 1.7;
  margin: 0;
}

/* ── Grid ────────────────────────────────────────────────────────────── */
.grid-section {
  padding: 64px 24px 96px;
  max-width: 1200px;
  margin: 0 auto;
}
.plugin-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
  gap: 32px;
}

/* ── Card ────────────────────────────────────────────────────────────── */
.plugin-card {
  background: #0d1117;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 16px;
  overflow: hidden;
  transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  display: flex;
  flex-direction: column;
}
.plugin-card:hover {
  transform: translateY(-4px);
  border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  box-shadow: 0 16px 48px color-mix(in srgb, var(--accent) 12%, transparent);
}

.card-cover {
  position: relative;
  aspect-ratio: 16 / 7;
  overflow: hidden;
}
.card-cover img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .4s ease;
}
.plugin-card:hover .card-cover img { transform: scale(1.04); }
.cover-fade {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 40%, #0d1117 100%);
}

.status-badge {
  position: absolute;
  top: 12px; right: 12px;
  padding: 4px 10px;
  border-radius: 99px;
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--s);
  background: color-mix(in srgb, var(--s) 14%, #06090f);
  border: 1px solid color-mix(in srgb, var(--s) 35%, transparent);
  backdrop-filter: blur(8px);
}

.card-body {
  padding: 20px 24px 24px;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.card-header {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 14px;
}
.plugin-logo {
  width: 48px; height: 48px;
  object-fit: contain;
  border-radius: 10px;
  background: rgba(255,255,255,.04);
  padding: 4px;
  flex-shrink: 0;
}
.card-header h2 {
  font-size: 1.15rem;
  font-weight: 700;
  color: #f1f5f9;
  margin: 0 0 2px;
  line-height: 1.2;
}
.version {
  font-size: .72rem;
  font-weight: 600;
  color: var(--accent-l);
  background: color-mix(in srgb, var(--accent) 14%, transparent);
  border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  padding: 2px 8px;
  border-radius: 99px;
  display: inline-block;
}
.card-tagline {
  font-size: .9rem;
  color: #94a3b8;
  line-height: 1.65;
  margin: 0 0 20px;
  flex: 1;
}
.card-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.btn {
  display: inline-flex;
  align-items: center;
  padding: 8px 18px;
  border-radius: 8px;
  font-size: .85rem;
  font-weight: 600;
  text-decoration: none;
  transition: opacity .15s, background .15s;
  cursor: pointer;
  border: none;
}
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { opacity: .85; }
.btn-fab {
  background: transparent;
  border: 1px solid rgba(255,255,255,.15);
  color: #94a3b8;
}
.btn-fab:not(.btn-disabled):hover {
  border-color: rgba(255,255,255,.35);
  color: #e2e8f0;
}
.btn-disabled { opacity: .45; cursor: default; pointer-events: none; }

/* ── Footer ──────────────────────────────────────────────────────────── */
.plugins-footer {
  background: #06090f;
  border-top: 1px solid rgba(255,255,255,.06);
  padding: 48px 24px;
  text-align: center;
}
.footer-inner { max-width: 480px; margin: 0 auto; }
.footer-social {
  display: flex;
  justify-content: center;
  gap: 14px;
  margin-bottom: 20px;
}
.footer-social a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px; height: 42px;
  border-radius: 10px;
  background: rgba(255,255,255,.05);
  border: 1px solid rgba(255,255,255,.08);
  transition: all .2s ease;
}
.footer-social a:hover {
  background: rgba(99,102,241,.2);
  border-color: rgba(99,102,241,.4);
  transform: translateY(-2px);
}
.footer-social img {
  width: 20px; height: 20px;
  object-fit: contain;
  filter: brightness(0) invert(1);
  opacity: .65;
  transition: opacity .2s ease;
}
.footer-social a:hover img { opacity: 1; }
.footer-copy {
  font-size: .78rem;
  color: rgba(255,255,255,.3);
  letter-spacing: .03em;
  margin: 0;
}

/* ── Responsive ──────────────────────────────────────────────────────── */
@media (max-width: 768px) {
  .plugins-header { padding: 0 20px; }

  .nav-hamburger { display: flex; }

  .nav-links {
    position: fixed;
    top: 0; right: -100%;
    width: 72%; max-width: 300px;
    height: 100vh;
    background: rgba(6,9,15,.97);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    flex-direction: column;
    align-items: flex-start;
    padding: 84px 24px 28px;
    gap: 4px;
    transition: right .28s ease;
    z-index: 100;
    border-left: 1px solid rgba(255,255,255,.07);
    box-shadow: -8px 0 32px rgba(0,0,0,.5);
  }
  .nav-links.active { right: 0; }
  .nav-links a { width: 100%; padding: 11px 14px; font-size: .95rem; }

  .plugin-grid { grid-template-columns: 1fr; }
  .hero { padding: 110px 16px 48px; }
  .grid-section { padding: 40px 16px 64px; }
}

@media (max-width: 480px) {
  .hero h1 { font-size: 2rem; }
}
</style>
