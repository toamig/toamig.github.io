---
// The /cv page: the two formats of the same CV, each a sheet you can read
// online or download. Laid out like the homepage sections (styles/site.css),
// with its own rules in styles/cv.css. Each preview sheet shares a
// view-transition name with the first page of its full CV, so opening a format
// grows the sheet into the page.
const formats = [
  {
    id: 'editorial',
    audience: 'For people',
    name: 'Editorial',
    desc: 'Two pages in the site\'s own typography. Best read on screen or printed, by recruiters, leads and anyone reading it themselves.',
    href: '/cv/editorial',
    pdf: '/cv/miguel-vieira-cv-editorial.pdf',
  },
  {
    id: 'neutral',
    audience: 'For screening software',
    name: 'ATS-friendly',
    desc: 'One plain column in monochrome, so applicant tracking systems read every line. Best for applications outside games.',
    href: '/cv/neutral',
    pdf: '/cv/miguel-vieira-cv-neutral.pdf',
  },
];
---
<section class="hn-section cv" aria-labelledby="cv-title">
  <div class="hn-wrap">
    <div class="hn-head">
      <h1 class="hn-title" id="cv-title">CV<sup class="hn-datum">{formats.length} formats</sup></h1>
      <div class="hn-lede-group">
        <p class="hn-lede">The same history in two layouts. Read it here, or download the PDF.</p>
        <a class="hn-link" href="/#contact">Or get in touch</a>
      </div>
    </div>

    <div class="cv-grid">
      {formats.map(f => (
        <article class={`cv-option cv-option--${f.id}`}>
          <a class="cv-stage" href={f.href} aria-label={`Read the ${f.name} CV online`}>
            <div class={`cv-sheet cv-sheet--${f.id}`} style={`view-transition-name:cv-sheet-${f.id}`} aria-hidden="true">
              {f.id === 'editorial' ? (
                <>
                  <p class="cv-preview-eyebrow">Lead Software Engineer · Games</p>
                  <p class="cv-preview-name">Miguel <em>Vieira</em></p>
                  <p class="cv-preview-role">Unreal Senior Engineer · Side</p>
                  <p class="cv-preview-lede">Game engineer turned tech lead, drawn to the work behind the work…</p>
                  <div class="cv-preview-cols">
                    <div>
                      <p class="cv-preview-h">Toolbox</p>
                      <div class="cv-preview-bars"><span></span><span class="s"></span><span></span></div>
                      <p class="cv-preview-h" style="margin-top:8px">Interests</p>
                      <div class="cv-preview-bars"><span class="s"></span></div>
                    </div>
                    <div>
                      <p class="cv-preview-h">Experience</p>
                      <div class="cv-preview-row"><span>Side</span><span class="d">2026 +</span></div>
                      <div class="cv-preview-row"><span>Flama Craftworks</span><span class="d">2025 +</span></div>
                      <div class="cv-preview-row"><span>Saber Interactive</span><span class="d">2022 - 24</span></div>
                    </div>
                  </div>
                </>
              ) : (
                <>
                  <p class="cv-preview-name-n">Miguel Vieira</p>
                  <p class="cv-preview-role-n">Lead Software Engineer · Games · Porto, PT</p>
                  <div class="cv-preview-rule-n"></div>
                  <p class="cv-preview-h-n">Profile</p>
                  <div class="cv-preview-bars cv-preview-bars-n"><span></span><span></span><span class="s"></span></div>
                  <p class="cv-preview-h-n">Experience</p>
                  <div class="cv-preview-row-n"><span>Side · Unreal Senior Engineer</span><span>2026 - Present</span></div>
                  <div class="cv-preview-row-n"><span>Flama Craftworks · Consultant</span><span>2025 - Present</span></div>
                  <div class="cv-preview-row-n"><span>Saber Interactive · Tools Lead</span><span>2022 - 2024</span></div>
                  <p class="cv-preview-h-n">Technical Skills</p>
                  <div class="cv-preview-bars cv-preview-bars-n"><span class="s"></span></div>
                </>
              )}
            </div>
          </a>
          <div class="cv-option-body">
            <p class="cv-audience">{f.audience}</p>
            <h2 class="cv-name">{f.name}</h2>
            <p class="cv-desc">{f.desc}</p>
            <div class="cv-actions">
              <a class="cv-btn cv-btn--primary" href={f.href}>Read online</a>
              <a class="cv-btn" href={f.pdf} download="Miguel Vieira - CV.pdf">Download PDF</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
