---
// Three brain-update paths converging on a shared CI/tag/deploy gate.
// HTML + a small inline SVG for the convergence visual.
interface UpdatePath {
  n: string;
  name: string;
  tag: string;
  body: string;
}
interface Props {
  paths: UpdatePath[];
}
const { paths } = Astro.props;

const gates = [
  { label: 'Gate',    title: 'CI validation + reviewer approval', body: 'Every path passes through the same automated + human check.' },
  { label: 'Release', title: 'Tagged release',                     body: 'Immutable version. Semantic versioning applies.' },
  { label: 'Deploy',  title: 'MCP server deployment',              body: 'Sessions and workers pick up the new version on next query.' },
];
---
<div class="gov">
  <!-- Three source paths -->
  <div class="gov-paths">
    {paths.map(p => (
      <article class="gov-path">
        <header class="path-head">
          <span class="path-num">{p.n}</span>
          <span class="path-tag">{p.tag}</span>
        </header>
        <h4 class="path-name">{p.name}</h4>
        <p class="path-body">{p.body}</p>
      </article>
    ))}
  </div>

  <!-- Convergence SVG (desktop only, tablet+) -->
  <svg class="gov-converge" viewBox="0 0 900 90" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <marker id="gov-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="currentColor" />
      </marker>
    </defs>
    <line pathLength="1" x1="150" y1="0"  x2="450" y2="80" />
    <line pathLength="1" x1="450" y1="0"  x2="450" y2="80" />
    <line pathLength="1" x1="750" y1="0"  x2="450" y2="80" />
    <line pathLength="1" x1="450" y1="80" x2="450" y2="90" marker-end="url(#gov-arrow)" />
  </svg>

  <!-- Mobile-only stacked arrow -->
  <div class="gov-stacked-arrow" aria-hidden="true">
    <svg width="20" height="34" viewBox="0 0 20 34" fill="none">
      <line x1="10" y1="0" x2="10" y2="24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path d="M4 22 L10 30 L16 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    </svg>
  </div>

  <!-- Shared gates -->
  <ol class="gov-gates">
    {gates.map((g, i) => (
      <>
        <li class:list={['gov-gate', i === 0 && 'primary']}>
          <span class="gate-label">{g.label}</span>
          <h4 class="gate-title">{g.title}</h4>
          <p class="gate-body">{g.body}</p>
        </li>
        {i < gates.length - 1 && (
          <div class="gov-connector" aria-hidden="true">
            <svg width="20" height="34" viewBox="0 0 20 34" fill="none">
              <line x1="10" y1="0" x2="10" y2="24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              <path d="M4 22 L10 30 L16 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </svg>
          </div>
        )}
      </>
    ))}
  </ol>
</div>

<style>
  .gov {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
  }

  .gov-paths {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    width: 100%;
  }
  @media (max-width: 767px) {
    .gov-paths { grid-template-columns: 1fr; }
  }

  .gov-path {
    padding: 22px 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .path-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .path-num {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    color: var(--color-amber);
  }
  .path-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-3);
    padding: 3px 8px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  .path-name {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0;
  }
  .path-body {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-text-2);
    margin: 0;
  }

  /* Convergence: three lines meeting at center, then continuing down */
  .gov-converge {
    display: block;
    width: 100%;
    height: 90px;
    margin: 8px 0 4px;
    color: var(--color-border-2);
    stroke: currentColor;
    stroke-width: 1.5;
    fill: none;
  }
  @media (max-width: 767px) {
    .gov-converge { display: none; }
  }

  .gov-stacked-arrow {
    display: none;
    color: var(--color-border-2);
    padding: 4px 0;
  }
  @media (max-width: 767px) {
    .gov-stacked-arrow { display: block; }
  }

  /* Gates stack */
  .gov-gates {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 0;
  }

  .gov-gate {
    width: 100%;
    max-width: 540px;
    padding: 20px 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-align: center;
  }
  .gov-gate.primary {
    border-color: var(--color-amber);
    background: color-mix(in oklab, var(--color-amber) 5%, var(--color-surface));
  }
  .gate-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-3);
    display: block;
    margin-bottom: 6px;
  }
  .gov-gate.primary .gate-label { color: var(--color-amber); }
  .gate-title {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0 0 4px;
  }
  .gate-body {
    font-size: 13.5px;
    color: var(--color-text-2);
    margin: 0;
    line-height: 1.5;
  }

  .gov-connector {
    color: var(--color-border-2);
    padding: 2px 0;
  }
</style>
