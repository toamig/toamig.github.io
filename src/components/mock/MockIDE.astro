---
// Wireframe: what a developer sees at write-time (Layer 1).
// A code editor with an inline convention hint surfaced from the knowledge layer.
const lines = [
  { no: 1,  html: '<span class="c-kw">#include</span> <span class="c-str">"DoTAbility.h"</span>' },
  { no: 2,  html: '' },
  { no: 3,  html: '<span class="c-cm">// New damage-over-time ability</span>' },
  { no: 4,  html: '<span class="c-ty">void</span> ADoTAbility::Apply(<span class="c-ty">AActor</span>* Target)' },
  { no: 5,  html: '&#123;' },
  { no: 6,  html: '&nbsp;&nbsp;<span class="c-fn">ApplyDamage</span>(Target, TickDamage);' },
  { no: 7,  html: '&#125;' },
];
---
<figure class="mock mock-ide" aria-label="Editor showing an inline AI convention hint">
  <div class="mock-bar">
    <span class="dot"></span><span class="dot"></span><span class="dot"></span>
    <span class="mock-file">DoTAbility.cpp</span>
    <span class="mock-badge">AI assistant · connected to studio brain</span>
  </div>
  <div class="mock-body">
    <pre class="code"><code>{lines.map(l => (
      <span class="line"><span class="ln">{l.no}</span><span class="lc" set:html={l.html} /></span>
    ))}</code></pre>
    <div class="hint">
      <div class="hint-head">
        <span class="hint-tag">Convention</span>
        <span class="hint-src">from studio brain · gameplay/abilities</span>
      </div>
      <p class="hint-body">
        Abilities in this module extend <code>UStudioGameplayAbility</code>, not <code>UGameplayAbility</code>. Use the studio base class so buff-stacking and replication work out of the box.
      </p>
    </div>
  </div>
</figure>

<style>
  .mock {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: 0 1px 0 rgba(26,26,26,0.02), 0 12px 32px -18px rgba(26,26,26,0.18);
    margin: 0;
  }
  .mock-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 16px;
    background: var(--color-ink-2);
    border-bottom: 1px solid var(--color-border);
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--color-border-2); }
  .dot:nth-child(1) { background: #d98b6a; }
  .mock-file {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-text-2);
    margin-left: 6px;
  }
  .mock-badge {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--color-amber);
    background: var(--color-amber-soft);
    border: 1px solid color-mix(in oklab, var(--color-amber) 30%, transparent);
    padding: 3px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }
  @media (max-width: 520px) { .mock-badge { display: none; } }

  .mock-body { padding: 6px 0 20px; }
  .code {
    margin: 0;
    padding: 12px 0 4px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.85;
    overflow-x: auto;
  }
  .line { display: block; white-space: pre; }
  .ln {
    display: inline-block;
    width: 42px;
    text-align: right;
    padding-right: 18px;
    color: var(--color-text-3);
    opacity: 0.6;
    user-select: none;
  }
  .lc { color: var(--color-text); }
  .c-kw { color: #9A3D22; }
  .c-str { color: #6a7f4a; }
  .c-cm { color: var(--color-text-3); font-style: italic; }
  .c-ty { color: #3d6a7a; }
  .c-fn { color: #1a1a1a; font-weight: 600; }

  .hint {
    margin: 10px 20px 0 60px;
    padding: 14px 16px;
    border: 1px solid color-mix(in oklab, var(--color-amber) 35%, var(--color-border));
    border-left: 3px solid var(--color-amber);
    border-radius: 8px;
    background: var(--color-amber-soft);
    position: relative;
  }
  .hint::before {
    content: "";
    position: absolute;
    top: -6px; left: 22px;
    width: 10px; height: 10px;
    background: var(--color-amber-soft);
    border-left: 1px solid color-mix(in oklab, var(--color-amber) 35%, var(--color-border));
    border-top: 1px solid color-mix(in oklab, var(--color-amber) 35%, var(--color-border));
    transform: rotate(45deg);
  }
  .hint-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 6px; flex-wrap: wrap; }
  .hint-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-amber);
    font-weight: 600;
  }
  .hint-src { font-family: var(--font-mono); font-size: 11px; color: var(--color-text-3); }
  .hint-body { margin: 0; font-size: 13.5px; line-height: 1.6; color: var(--color-text); }
  .hint-body code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    background: rgba(26,26,26,0.05);
    padding: 1px 5px;
    border-radius: 4px;
  }
</style>
