---
// Corner music widget: a small floating button that expands a styled panel
// around the OFFICIAL Spotify playlist embed. This is the sanctioned route —
// Spotify serves + renders the player under its own licence; we only style the
// frame/placement around it. The embed is lazy-loaded on first open.
const PLAYLIST_ID = '3tjedTZ6XSEjytY6pIJyh4';
// Default theme (no theme=0) → Spotify's colourful art-derived gradient.
const EMBED = `https://open.spotify.com/embed/playlist/${PLAYLIST_ID}?utm_source=generator`;
const PLAYLIST_URL = `https://open.spotify.com/playlist/${PLAYLIST_ID}`;
---
<div class="music-player" id="musicPlayer">
  <div class="mp-card" id="mpCard" aria-hidden="true">
    <div class="mp-head">
      <span class="mp-eq" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="mp-title">Soundtrack</span>
      <a class="mp-open" href={PLAYLIST_URL} target="_blank" rel="noopener" aria-label="Open in Spotify">Spotify ↗</a>
    </div>
    <iframe
      id="mpFrame"
      title="Soundtrack — Spotify playlist"
      data-src={EMBED}
      width="100%"
      height="152"
      style="border-radius:12px"
      frameborder="0"
      loading="lazy"
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>

  <button class="music-toggle" id="musicToggle" aria-label="Music" aria-expanded="false">
    <span class="music-icon" id="musicIcon">♫</span>
  </button>
</div>

<style>
  .mp-card {
    position: absolute;
    bottom: calc(100% + 12px);
    right: 0;
    width: 420px;
    max-width: calc(100vw - 36px);
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(14,26,46,.96), rgba(8,16,30,.96));
    border: 1px solid rgba(255,255,255,.12);
    box-shadow: 0 16px 48px rgba(0,0,0,.5);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding: 12px;
    opacity: 0;
    transform: translateY(10px) scale(.97);
    transform-origin: bottom right;
    pointer-events: none;
    transition: opacity .22s ease, transform .22s ease;
  }
  .music-player.open .mp-card { opacity: 1; transform: none; pointer-events: auto; }

  .mp-head { display: flex; align-items: center; gap: 8px; padding: 2px 4px 10px; }
  .mp-title { font-size: 13px; font-weight: 700; color: #fff; letter-spacing: -.01em; }
  .mp-open {
    margin-left: auto; font-family: var(--font-mono, monospace); font-size: 10.5px;
    letter-spacing: .04em; color: rgba(255,255,255,.5); text-decoration: none;
    transition: color .15s;
  }
  .mp-open:hover { color: #fff; }
  .mp-eq { display: inline-flex; align-items: flex-end; gap: 2px; height: 13px; }
  .mp-eq i { width: 3px; height: 45%; background: var(--accent, #ff8a4c); border-radius: 1px; }
  .music-player.open .mp-eq i { animation: mp-eq 1s ease-in-out infinite; }
  .music-player.open .mp-eq i:nth-child(2) { animation-delay: .3s; }
  .music-player.open .mp-eq i:nth-child(3) { animation-delay: .6s; }
  @keyframes mp-eq { 0%,100% { height: 35%; } 50% { height: 100%; } }

  .mp-card iframe { display: block; width: 100%; border: 0; }

  .music-player.open .music-toggle { background: rgba(41,128,185,.5); border-color: rgba(41,128,185,.6); }

  @media (prefers-reduced-motion: reduce) {
    .mp-card { transition: opacity .15s ease; transform: none; }
    .music-player.open .mp-eq i { animation: none; }
  }
</style>

<script>
  const root   = document.getElementById('musicPlayer');
  const toggle = document.getElementById('musicToggle');
  const card   = document.getElementById('mpCard');
  const frame  = document.getElementById('mpFrame') as HTMLIFrameElement | null;

  if (root && toggle && card && frame) {
    const ensureLoaded = () => {
      if (!frame.getAttribute('src') && frame.dataset.src) frame.setAttribute('src', frame.dataset.src);
    };
    const setOpen = (open: boolean) => {
      root.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
      card.setAttribute('aria-hidden', String(!open));
      if (open) ensureLoaded();   // lazy-load Spotify only when first opened
      try { localStorage.setItem('soundtrackOpen', open ? '1' : '0'); } catch (e) {}
    };
    toggle.addEventListener('click', () => setOpen(!root.classList.contains('open')));
    setOpen(localStorage.getItem('soundtrackOpen') === '1');
  }
</script>
