---
// The five-layer pipeline diagram. Default: compact cards (title + one-liner).
// Hover: card expands to reveal prose + metadata. Peers dim.
// On touch / no-hover devices: all detail shown by default.
import ConsultingIcon from './ConsultingIcon.astro';

interface Layer {
  n: string;
  name: string;
  oneLine: string;
  prose: string;
  audience: string;
  trigger: string;
  time: string;
  cost: string;
  accent: string;
}
interface Props {
  layers: Layer[];
}
const { layers } = Astro.props;
---
<div class="pipeline">
  {layers.map((l, i) => (
    <>
      <article class="pipeline-layer group" data-anim="pipeline-layer" data-idx={i}>
        <header class="layer-head">
          <span class="layer-num">L{l.n}</span>
          <span class="layer-tag">{l.accent}</span>
        </header>
        <h3 class="layer-name">{l.name}</h3>
        <p class="layer-oneline">{l.oneLine}</p>

        <div class="layer-detail">
          <p class="layer-prose">{l.prose}</p>
          <dl class="layer-meta">
            <div class="meta-item">
              <dt>Audience</dt>
              <dd>{l.audience}</dd>
            </div>
            <div class="meta-item">
              <dt>Trigger</dt>
              <dd>{l.trigger}</dd>
            </div>
            <div class="meta-item">
              <dt>Time to result</dt>
              <dd>{l.time}</dd>
            </div>
            <div class="meta-item">
              <dt>Cost</dt>
              <dd>{l.cost}</dd>
            </div>
          </dl>
        </div>
      </article>

      {i < layers.length - 1 && (
        <div class="pipeline-connector" aria-hidden="true">
          <svg width="20" height="34" viewBox="0 0 20 34" fill="none">
            <line x1="10" y1="0" x2="10" y2="24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            <path d="M4 22 L10 30 L16 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </svg>
        </div>
      )}
    </>
  ))}
</div>

<style>
  .pipeline {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .pipeline-layer {
    position: relative;
    width: 100%;
    max-width: 780px;
    padding: 24px 28px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    transition:
      opacity 0.4s cubic-bezier(0.22, 0.61, 0.36, 1),
      border-color 0.3s,
      transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
    cursor: default;
  }

  /* Peer-dim on hover of any layer */
  .pipeline:hover .pipeline-layer:not(:hover) {
    opacity: 0.32;
  }
  .pipeline-layer:hover {
    border-color: var(--color-amber);
  }

  .layer-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .layer-num {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.15em;
    color: var(--color-amber);
    font-weight: 500;
  }
  .layer-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-3);
    padding: 3px 8px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .layer-name {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0 0 8px;
  }
  .layer-oneline {
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-2);
    margin: 0;
  }

  /* Detail block — collapsed by default, expanded on hover */
  .layer-detail {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 0.55s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.35s ease;
  }
  .pipeline-layer:hover .layer-detail {
    max-height: 480px;
    opacity: 1;
  }

  .layer-prose {
    margin: 20px 0 22px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--color-text-2);
  }

  .layer-meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 24px;
    margin: 0;
  }
  @media (min-width: 640px) {
    .layer-meta {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .meta-item dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-3);
    margin-bottom: 4px;
  }
  .meta-item dd {
    font-size: 13.5px;
    color: var(--color-text);
    margin: 0;
    line-height: 1.4;
  }

  /* Vertical connector between cards */
  .pipeline-connector {
    color: var(--color-border-2);
    padding: 4px 0;
    transition: color 0.3s;
  }
  .pipeline:hover .pipeline-connector {
    color: var(--color-text-3);
  }

  /* On touch / no-hover devices: expand all detail, disable dimming */
  @media (hover: none) {
    .layer-detail {
      max-height: 480px;
      opacity: 1;
    }
    .pipeline:hover .pipeline-layer:not(:hover) {
      opacity: 1;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .pipeline-layer,
    .layer-detail,
    .pipeline-connector {
      transition: none;
    }
  }
</style>
