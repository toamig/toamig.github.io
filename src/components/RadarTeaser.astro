---
// Toa Radar, as a window on the homepage. The server renders a plain version
// (what Radar is, and the link) in Radar's safe inks; the script then fetches
// the newest issue and reprints the card in that day's paper, inks and
// headline face, so the window looks different every morning.
interface Props {
  name: string;
  kicker: string;
  state: string;
  line: string;
  href: string;
  cta: string;
}
const { name, kicker, state, line, href, cta } = Astro.props;

// The monogram's outline, as in Logo.astro and Radar's own src/kit/toa-mark.mjs,
// cropped to the letters and split into its two plates: T, then O and A.
const TOA_VIEWBOX = '50 146 597 340';
const TOA_TRANSFORM = 'translate(0,633) scale(0.1,-0.1)';
const TOA_T = 'M507 4863 c-4 -3 -7 -152 -7 -330 l0 -323 335 0 335 0 0 -1332 0 -1333 330 330 330 330 0 1002 0 1003 999 0 1000 0 323 326 c178 179 325 327 327 330 2 2 -889 4 -1981 4 -1091 0 -1988 -3 -1991 -7z';
const TOA_OA = [
  'M4227 4472 l-327 -327 -2 -1005 -3 -1005 -1000 -3 -1000 -2 -330 -330 -330 -330 1658 0 1657 0 0 335 0 335 392 -2 393 -3 123 -215 c68 -118 154 -267 191 -330 l67 -115 377 -3 c207 -1 377 0 377 3 0 2 -22 42 -49 87 -46 77 -1130 1958 -1218 2113 -22 39 -84 147 -138 240 -54 94 -130 226 -170 295 -40 69 -98 170 -130 225 -32 55 -91 158 -132 230 -41 71 -75 130 -76 132 -2 1 -150 -145 -330 -325z m375 -1064 c20 -35 104 -181 187 -325 83 -144 151 -267 151 -273 0 -6 -67 -10 -195 -10 l-195 0 0 335 c0 184 4 335 8 335 4 0 24 -28 44 -62z',
  'M2898 3139 l-318 -324 317 -3 c174 -1 318 -1 320 1 2 2 2 149 1 327 l-3 323 -317 -324z',
];

// In dev the page is served from localhost, where /radar/ does not exist, so
// read the live feed instead (GitHub Pages serves it with an open CORS header).
const FEED = import.meta.env.DEV ? 'https://toamig.com/radar/latest.json' : '/radar/latest.json';
---
<a class="radar-teaser" href={href} data-radar-teaser data-feed={FEED}>
  <div class="rt-mast">
    <span class="rt-brand" aria-label={name}>
      <svg class="rt-mark" viewBox={TOA_VIEWBOX} aria-hidden="true" focusable="false">
        <g transform={TOA_TRANSFORM}>
          <path class="rt-t" d={TOA_T} />
          {TOA_OA.map(d => <path class="rt-oa" d={d} />)}
        </g>
      </svg>
      <span class="rt-word" data-text="Radar" aria-hidden="true">Radar</span>
    </span>
    <span class="rt-meta">
      <span class="rt-no" data-rt-no hidden></span>
      <span class="rt-date" data-rt-date>{kicker}</span>
    </span>
  </div>

  <div class="rt-day">
    <div class="rt-lead">
      <p class="rt-label" data-rt-label>{state}</p>
      <h3 class="rt-title" data-rt-title>{name}</h3>
      <p class="rt-dek" data-rt-dek>{line}</p>
    </div>
    <ul class="rt-short" data-rt-tldr hidden></ul>
  </div>

  <div class="rt-foot">
    <span class="rt-cta" data-rt-cta>{cta}</span>
    <span class="rt-by">By Toamig</span>
  </div>
</a>

<style>
  /* Everything inside the window is Radar's: its paper, its two inks, its
     display face. The defaults are Radar's own safe theme (bright white,
     black, blue and fluorescent pink), so the no-JS card is still a print. */
  .radar-teaser {
    --rd-paper: #FBFBF8;
    --rd-text: #000000;
    --rd-a: #0078BF;
    --rd-b: #FF48B0;
    --rd-display: #0078BF;
    --rd-paper-n: #16171B;
    --rd-text-n: #FBFBF8;
    --rd-display-n: #62A8E5;
    --rd-font: 'Bricolage Grotesque', 'Inter', sans-serif;
    --rd-weight: 700;
    --rd-stretch: 100%;
    --rd-case: none;
    --rd-track: -.035em;
    --rd-scale: .9;

    --rd-bg: var(--rd-paper);
    --rd-ink: var(--rd-text);
    --rd-head: var(--rd-display);

    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto 24px;
    padding: clamp(24px, 3.4vw, 36px) clamp(22px, 3.8vw, 44px) clamp(22px, 3vw, 30px);
    background-color: var(--rd-bg);
    border: 1px solid color-mix(in srgb, var(--rd-ink) 14%, transparent);
    border-radius: 20px;
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
    color: var(--rd-ink);
    box-shadow:
      0 1px 2px rgba(10,22,40,.05),
      0 12px 28px rgba(10,22,40,.07),
      0 24px 56px color-mix(in srgb, var(--rd-b) 16%, transparent);
    transition:
      transform .35s cubic-bezier(.2,.7,.2,1), box-shadow .35s ease,
      background-color .5s ease, color .5s ease;
  }
  /* Radar follows the reader's light or dark setting, so the window does too. */
  @media (prefers-color-scheme: dark) {
    .radar-teaser {
      --rd-bg: var(--rd-paper-n);
      --rd-ink: var(--rd-text-n);
      --rd-head: var(--rd-display-n);
    }
  }
  .radar-teaser:hover {
    transform: translateY(-6px);
    box-shadow:
      0 1px 2px rgba(10,22,40,.05),
      0 16px 40px rgba(10,22,40,.10),
      0 32px 72px color-mix(in srgb, var(--rd-b) 26%, transparent);
  }

  /* A halftone of the second ink fading in from the top corner, the way a
     riso plate prints a tint. */
  .radar-teaser::before {
    content: '';
    position: absolute;
    top: -40px;
    right: -40px;
    width: min(520px, 70%);
    height: 360px;
    background-image: radial-gradient(circle, var(--rd-b) 1.3px, transparent 1.8px);
    background-size: 9px 9px;
    -webkit-mask-image: radial-gradient(ellipse 100% 100% at 100% 0%, #000 0%, transparent 70%);
    mask-image: radial-gradient(ellipse 100% 100% at 100% 0%, #000 0%, transparent 70%);
    opacity: .5;
    z-index: -1;
    pointer-events: none;
    transition: background-image .5s ease;
  }

  /* ── Masthead ── */
  .rt-mast {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 24px;
    padding-bottom: 14px;
    border-bottom: 5px solid var(--rd-ink);
  }
  .rt-brand {
    display: inline-flex;
    align-items: flex-end;
    gap: .16em;
    font-family: var(--rd-font);
    font-weight: var(--rd-weight);
    font-stretch: var(--rd-stretch);
    text-transform: var(--rd-case);
    letter-spacing: var(--rd-track);
    font-size: calc(var(--rd-scale) * clamp(44px, 7vw, 76px));
    line-height: .78;
  }
  .rt-mark { height: .74em; width: auto; flex: none; margin-bottom: .02em; }
  .rt-t  { fill: var(--rd-b); transition: fill .5s ease; }
  .rt-oa { fill: var(--rd-head); transition: fill .5s ease; }
  /* Overprint: the word again in the second ink, a hair out of register. */
  .rt-word { position: relative; color: var(--rd-head); isolation: isolate; }
  .rt-word::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: var(--rd-b);
    transform: translate(.06em, .035em);
    z-index: -1;
    pointer-events: none;
  }
  .rt-meta {
    display: grid;
    justify-items: end;
    gap: 3px;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--rd-ink) 66%, transparent);
  }
  .rt-no {
    font-family: var(--rd-font);
    font-weight: var(--rd-weight);
    font-stretch: var(--rd-stretch);
    font-size: 26px;
    line-height: 1;
    letter-spacing: -.01em;
    text-transform: none;
    color: var(--rd-ink);
  }
  .rt-no[hidden] { display: none; }

  /* ── The day ── */
  .rt-day {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 22px 44px;
  }
  .radar-teaser:not(.is-live) .rt-day { grid-template-columns: minmax(0, 1fr); }
  .rt-lead { display: flex; flex-direction: column; gap: 12px; }
  .rt-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--rd-ink) 60%, transparent);
  }
  .rt-title {
    margin: 0;
    font-family: var(--rd-font);
    font-weight: var(--rd-weight);
    font-stretch: var(--rd-stretch);
    text-transform: var(--rd-case);
    letter-spacing: var(--rd-track);
    font-variation-settings: normal;
    font-size: calc(var(--rd-scale) * clamp(30px, 3.9vw, 46px));
    line-height: 1.02;
    color: var(--rd-ink);
    text-wrap: balance;
  }
  .rt-dek {
    margin: 0;
    max-width: 52ch;
    font-size: 15px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--rd-ink) 78%, transparent);
  }
  .rt-short {
    display: grid;
    gap: 14px;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rt-short[hidden] { display: none; }
  /* The items come from the script, so they carry no scoped-style attribute. */
  .rt-short :global(li) {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 12px;
    font-size: 14.5px;
    line-height: 1.55;
    color: color-mix(in srgb, var(--rd-ink) 86%, transparent);
  }
  /* Shapes rather than numbers, alternating plates. */
  .rt-short :global(li)::before {
    content: '';
    width: 10px;
    height: 10px;
    margin-top: .45em;
    background: var(--rd-a);
  }
  .rt-short :global(li):nth-child(2)::before { background: var(--rd-b); border-radius: 50%; }
  .rt-short :global(li):nth-child(3)::before { clip-path: polygon(50% 0, 100% 100%, 0 100%); }

  .rt-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 20px;
    padding-top: 14px;
    border-top: 1px solid color-mix(in srgb, var(--rd-ink) 18%, transparent);
  }
  .rt-by {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--rd-ink) 55%, transparent);
  }
  .rt-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--rd-ink);
    transition: gap .25s ease;
  }
  .rt-cta::after {
    content: '→';
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: 0;
    color: var(--rd-b);
  }
  .radar-teaser:hover .rt-cta { gap: 14px; }

  /* The live issue settles in rather than snapping over the plain card. */
  .radar-teaser.is-live .rt-day { animation: rt-in .5s ease both; }
  @keyframes rt-in { from { opacity: 0; transform: translateY(6px); } }

  @media (max-width: 768px) {
    .radar-teaser { gap: 18px; margin-bottom: 18px; }
    .rt-day { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    /* On a phone the three short lines say what the dek says; keep the card short. */
    .radar-teaser.is-live .rt-dek { display: none; }
    .rt-no { font-size: 20px; }
    .rt-meta { font-size: 10px; letter-spacing: .1em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .radar-teaser, .rt-t, .rt-oa, .rt-cta { transition: none; }
    .radar-teaser:hover { transform: none; }
    .radar-teaser.is-live .rt-day { animation: none; }
  }
</style>

<script>
  // Radar's display faces, keyed by the name the feed gives. The settings
  // mirror TYPE_SETS in Radar's src/kit/catalog.mjs; the families come from
  // Google Fonts, which the site already preconnects to.
  const FACES: Record<string, {
    family: string; css: string; weight: number; stretch: string;
    upper: boolean; track: string; scale: number;
  }> = {
    'Big Shoulders': {
      family: "'Big Shoulders Display', 'Arial Narrow', sans-serif",
      css: 'Big+Shoulders+Display:wght@800',
      weight: 800, stretch: '100%', upper: true, track: '-.01em', scale: 1,
    },
    'Anybody Expanded': {
      family: "'Anybody', 'Arial Black', sans-serif",
      css: 'Anybody:wdth,wght@50..150,100..900',
      weight: 760, stretch: '135%', upper: false, track: '-.03em', scale: .72,
    },
    'Bricolage Grotesque': {
      family: "'Bricolage Grotesque', 'Inter', sans-serif",
      css: '',
      weight: 700, stretch: '100%', upper: false, track: '-.035em', scale: .9,
    },
    'Anybody Condensed': {
      family: "'Anybody', 'Arial Narrow', sans-serif",
      css: 'Anybody:wdth,wght@50..150,100..900',
      weight: 820, stretch: '62%', upper: true, track: '-.01em', scale: 1,
    },
  };

  interface Feed {
    issue: null | {
      number: number; date: string; title: string; dek: string;
      tldr: string[]; url: string;
    };
    theme?: {
      paper: string; text: string; inkA: string; inkB: string; displayA: string;
      night: { paper: string; text: string }; font: string;
    };
  }

  // WCAG contrast, as Radar computes it: the feed carries the day's display
  // color but not the night one, which needs 4.5:1 on the dark paper.
  const channel = (c: number) => {
    const s = c / 255;
    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
  };
  const luminance = (hex: string) => {
    const n = parseInt(hex.slice(1), 16);
    return 0.2126 * channel((n >> 16) & 255) + 0.7152 * channel((n >> 8) & 255) + 0.0722 * channel(n & 255);
  };
  const contrast = (a: string, b: string) => {
    const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x);
    return (hi + 0.05) / (lo + 0.05);
  };
  const isHex = (s: unknown): s is string => typeof s === 'string' && /^#[0-9a-f]{6}$/i.test(s);

  const loadFace = (css: string) => {
    if (!css || document.querySelector(`link[data-rt-face="${css}"]`)) return;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = `https://fonts.googleapis.com/css2?family=${css}&display=swap`;
    link.dataset.rtFace = css;
    document.head.appendChild(link);
  };

  // Today in Lisbon, where the routine runs, so a reader late at night in
  // another timezone still sees "today" on the morning's issue.
  const lisbonToday = () =>
    new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Lisbon' }).format(new Date());

  const paint = (card: HTMLAnchorElement, feed: Feed) => {
    const { issue, theme } = feed;
    if (!issue || !theme) return;
    const colors = [theme.paper, theme.text, theme.inkA, theme.inkB, theme.displayA, theme.night?.paper, theme.night?.text];
    if (!colors.every(isHex)) return;

    const set = (k: string, v: string) => card.style.setProperty(k, v);
    set('--rd-paper', theme.paper);
    set('--rd-text', theme.text);
    set('--rd-a', theme.inkA);
    set('--rd-b', theme.inkB);
    set('--rd-display', theme.displayA);
    set('--rd-paper-n', theme.night.paper);
    set('--rd-text-n', theme.night.text);
    set('--rd-display-n', contrast(theme.inkA, theme.night.paper) >= 4.5 ? theme.inkA : theme.night.text);

    const face = FACES[theme.font];
    if (face) {
      loadFace(face.css);
      set('--rd-font', face.family);
      set('--rd-weight', String(face.weight));
      set('--rd-stretch', face.stretch);
      set('--rd-case', face.upper ? 'uppercase' : 'none');
      set('--rd-track', face.track);
      set('--rd-scale', String(face.scale));
    }

    const q = <T extends HTMLElement>(sel: string) => card.querySelector<T>(sel);
    const today = issue.date === lisbonToday();
    const when = new Date(`${issue.date}T12:00:00Z`);
    const date = Number.isNaN(when.getTime()) ? issue.date : new Intl.DateTimeFormat('en-GB', {
      timeZone: 'UTC', weekday: 'short', day: 'numeric', month: 'short', year: 'numeric',
    }).format(when);

    const no = q('[data-rt-no]');
    const dateEl = q('[data-rt-date]');
    const label = q('[data-rt-label]');
    const title = q('[data-rt-title]');
    const dek = q('[data-rt-dek]');
    const list = q<HTMLUListElement>('[data-rt-tldr]');
    const cta = q('[data-rt-cta]');

    if (no) { no.textContent = `No. ${issue.number}`; no.hidden = false; }
    if (dateEl) dateEl.textContent = date;
    if (label) label.textContent = today ? "Today's issue" : 'Latest issue';
    if (title) title.textContent = issue.title;
    if (dek) dek.textContent = issue.dek;
    if (list) {
      list.replaceChildren(...issue.tldr.slice(0, 3).map(line => {
        const li = document.createElement('li');
        li.textContent = line;
        return li;
      }));
      list.hidden = list.childElementCount === 0;
    }
    if (cta) cta.textContent = today ? "Read today's issue" : 'Read the latest issue';
    if (/^https?:\/\//.test(issue.url) || issue.url.startsWith('/')) card.href = issue.url;
    card.classList.add('is-live');
  };

  document.querySelectorAll<HTMLAnchorElement>('[data-radar-teaser]').forEach(card => {
    const feed = card.dataset.feed;
    if (!feed) return;
    // no-cache revalidates against the 10 minute Pages cache, so the morning's
    // issue shows up as soon as it is published. Any failure keeps the plain card.
    fetch(feed, { cache: 'no-cache' })
      .then(r => (r.ok ? r.json() : null))
      .then((data: Feed | null) => { if (data) paint(card, data); })
      .catch(() => {});
  });
</script>
